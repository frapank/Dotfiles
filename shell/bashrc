# HELPER
_has() { command -v "$1" >/dev/null 2>&1; }

# SHELL OPTIONS
_setup_history() {
    HISTSIZE=10000
    HISTFILESIZE=20000
    HISTCONTROL=ignoredups:erasedups
    HISTIGNORE='ls:ll:la:cd:cd -:pwd:exit:history:clear'
    shopt -s histappend checkwinsize promptvars
    shopt -s cmdhist lithist
    shopt -s nullglob
    set -o pipefail
}

_setup_prompt() {
    __set_bash_prompt() {
        local s=$? p='$'
        (( s )) && p='\[\e[31m\]$\[\e[0m\]'
        PS1="$p \W: "
    }

    PROMPT_COMMAND='history -a; history -n; __set_bash_prompt'
}

_setup_env() {
    export LESS='-RF'
    export LESSHISTFILE=

    if _has vim; then
        export EDITOR=vim
    else
        export EDITOR=vi
    fi

    local _lp
    for _lp in lesspipe lesspipe.sh; do
        if _has "$_lp"; then
            export LESSOPEN="| $_lp %s"
            break
        fi
    done
}

_setup_path() {
    local _dir
    for _dir in "$HOME/.cargo/bin" "$HOME/.local/bin"; do
        [[ -d $_dir && :$PATH: != *:$_dir:* ]] && PATH="$_dir:$PATH"
    done
}

_setup_completion() {
    bind 'set completion-ignore-case on' 2>/dev/null
    bind 'set show-all-if-ambiguous on' 2>/dev/null
    bind 'set menu-complete-display-prefix on' 2>/dev/null
}

_setup_ls() {
    export LS_COLORS='di=1;34:ln=36:ex=32'

    if _has gls && gls --group-directories-first / >/dev/null 2>&1; then
        alias ls='gls -h --color=auto --group-directories-first --indicator-style=classify'
    elif ls --group-directories-first / >/dev/null 2>&1; then
        alias ls='ls -h --color=auto --group-directories-first --indicator-style=classify'
    elif ls -G / >/dev/null 2>&1; then
        alias ls='ls -hFG'
    else
        alias ls='ls -hF'
    fi
}

_setup_man() {
    local _b
    for _b in bat batcat; do
        if _has "$_b"; then
            _BAT="$_b"
            break
        fi
    done

    man() {
        [[ -z $_BAT ]] && { command man "$@"; return; }
        command man "$@" | col -bx | "$_BAT" -l man -p
        return "${PIPESTATUS[0]}"
    }
}

# INIT ALL
_setup_history
_setup_prompt
_setup_env
_setup_path
_setup_completion
_setup_ls
_setup_man
