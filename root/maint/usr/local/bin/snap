#!/usr/bin/python3 -I
"""List, restore and forget versions of a file in the daily snapshots of /home, show what changed."""
import fcntl
import getopt
import json
import os
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import time
import traceback

PROG = 'snap'
HOME = '/home'
SNAPDIR = '/home/.snapshots'
NAME = re.compile(r'home-(\d{4}-\d{2}-\d{2}_\d{4})')
MAINT_LOCK = '/var/lib/maint/lock'

USAGE = f"""\
Usage: {PROG} FILE
  or:  {PROG} -r SNAPSHOT FILE [DEST]
  or:  {PROG} -d SNAPSHOT [-t SNAPSHOT] [FOLDER]
  or:  {PROG} -l
List the versions of FILE kept in the daily snapshots of /home, or copy the
one in SNAPSHOT back. FILE can be a file or a folder and may no longer exist.
Nothing is overwritten: the copy goes to DEST, by default next to FILE with
the snapshot in its name. Asks for doas; the snapshots are then read with
your own permissions, so you only get back what was yours to read.

  -l           list the snapshots
  -r SNAPSHOT  copy FILE back from SNAPSHOT, a date (2026-09-25) or a name
               from the list (2026-09-25_2007)
  -d SNAPSHOT  list what changed in your home since SNAPSHOT, or only in
               FOLDER: A added, M modified, D deleted, R moved or renamed.
               A new or deleted folder is one line. Only names are compared,
               no file is read. Downloads, ~/.cache and the other folders
               kept out of the snapshots never show up.
  -t SNAPSHOT  with -d: up to SNAPSHOT instead of now

The snapshots are on the same disk as /home: they are not a backup.
To delete a file from all of them, see 'forget --help'.
"""

FORGET_USAGE = """\
Usage: forget [-n] FILE...
Delete each FILE from every daily snapshot of /home, so that it is gone for
good once you delete it yourself. FILE can be a file or a folder and may no
longer exist; the live FILE is left alone. Asks for doas; the deletion then
runs with your own permissions, so you can only remove what you could delete.

  -n  only show the snapshots that hold each FILE, delete nothing
"""


def q(s):
    return "'" + ''.join(c if c.isprintable() else '?' for c in s) + "'"


def die(msg, code=1):
    print(f'{PROG}: {msg}', file=sys.stderr)
    sys.exit(code)


def usage_error(msg):
    print(f'{PROG}: {msg}', file=sys.stderr)
    print(f"Try '{PROG} --help' for more information.", file=sys.stderr)
    sys.exit(2)


def human(n):
    for unit in 'BKMG':
        if n < 1024 or unit == 'G':
            break
        n /= 1024
    return f'{n:.0f}{unit}' if unit == 'B' or n >= 10 else f'{n:.1f}{unit}'


def open_snapshots():
    try:
        top = os.open(SNAPDIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        die(f'no snapshots: {SNAPDIR} does not exist')
    st = os.fstat(top)
    if st.st_uid != 0 or st.st_mode & 0o022:
        die(f'{SNAPDIR} is not owned by root or is writable by others')
    snaps = []
    for name in sorted(os.listdir(top)):
        m = NAME.fullmatch(name)
        if not m:
            continue
        try:
            fd = os.open(name, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=top)
        except OSError:
            continue
        snaps.append((m.group(1), fd))
    os.close(top)
    if not snaps:
        die(f'no snapshots in {SNAPDIR}')
    return snaps


def drop_to(user):
    pw = pwd.getpwnam(user)
    os.initgroups(user, pw.pw_gid)
    os.setresgid(pw.pw_gid, pw.pw_gid, pw.pw_gid)
    os.setresuid(pw.pw_uid, pw.pw_uid, pw.pw_uid)
    if os.getresuid() != (pw.pw_uid,) * 3 or os.getresgid() != (pw.pw_gid,) * 3:
        die('could not drop root privileges')
    try:
        os.setuid(0)
    except PermissionError:
        return
    die('could not drop root privileges')


def rel_path(path):
    real = os.path.realpath(path)
    rel = os.path.relpath(real, HOME)
    if rel == '.' or rel.startswith('..') or rel.split('/')[0] == '.snapshots':
        die(f'{q(path)}: not in {HOME}')
    return real, rel


def lookup(root, rel):
    # O_NOFOLLOW: a symlink in the snapshot would point to the live system
    *dirs, name = rel.split('/')
    fd = os.open('.', os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC, dir_fd=root)
    for part in dirs:
        try:
            nfd = os.open(part, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        except OSError:
            os.close(fd)
            return None, name
        os.close(fd)
        fd = nfd
    return fd, name


def version(root, rel):
    fd, name = lookup(root, rel)
    if fd is None:
        return None
    try:
        return os.stat(name, dir_fd=fd, follow_symlinks=False)
    except OSError:
        return None
    finally:
        os.close(fd)


def describe(st):
    if st is None:
        return '-', 'not there'
    when = time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime))
    if stat.S_ISDIR(st.st_mode):
        return 'folder', f'changed {when}'
    if stat.S_ISLNK(st.st_mode):
        return 'symlink', f'changed {when}'
    return human(st.st_size), f'modified {when}'


def list_versions(snaps, path):
    real, rel = rel_path(path)
    rows, last, found = [], (), False
    for label, root in snaps:
        st = version(root, rel)
        key = None if st is None else (stat.S_IFMT(st.st_mode), st.st_size, st.st_mtime_ns)
        found = found or st is not None
        if key != last:
            rows.append((label, *describe(st)))
            last = key
    if not found:
        die(f'{q(path)}: not in any snapshot')
    try:
        now = os.lstat(real)
    except OSError:
        now = None
    rows.append(('now', *describe(now)))
    print(f'{"SNAPSHOT":<16} {"SIZE":>7}  STATE')
    for label, size, state in rows:
        print(f'{label:<16} {size:>7}  {state}')


def as_user(user, func, *args):
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(r)
        code = 0
        try:
            drop_to(user)
            os.write(w, json.dumps(func(*args)).encode())
        except SystemExit as e:
            code = e.code if isinstance(e.code, int) else 1
        except BaseException:
            traceback.print_exc()
            code = 1
        sys.stdout.flush()
        sys.stderr.flush()
        os._exit(code)
    os.close(w)
    with os.fdopen(r, 'rb') as f:
        data = f.read()
    code = os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1])
    if code:
        sys.exit(code)
    return json.loads(data)


def find(snaps, paths):
    found = []
    for path in paths:
        try:
            real, rel = rel_path(path)
        except SystemExit:
            found.append(None)
            continue
        if '/' not in rel:
            print(f'{PROG}: {q(path)}: is a whole home folder, refusing', file=sys.stderr)
            found.append(None)
            continue
        labels = [label for label, root in snaps if version(root, rel) is not None]
        if not labels:
            print(f'{PROG}: {q(path)}: not in any snapshot', file=sys.stderr)
        found.append({'real': real, 'rel': rel, 'labels': labels, 'live': os.path.lexists(real)})
    return found


def unlock_tree(name, dir_fd):
    # read-only folders block rmtree
    try:
        os.chmod(name, 0o700, dir_fd=dir_fd)
    except OSError:
        pass
    for _, dirs, _, fd in os.fwalk(name, dir_fd=dir_fd):
        for d in dirs:
            try:
                if stat.S_ISDIR(os.stat(d, dir_fd=fd, follow_symlinks=False).st_mode):
                    os.chmod(d, 0o700, dir_fd=fd)
            except OSError:
                pass


def delete(snaps, items):
    roots = dict(snaps)
    failed = 0
    for it in items:
        for label in it['labels']:
            fd, name = lookup(roots[label], it['rel'])
            try:
                if fd is None:
                    raise FileNotFoundError(2, 'No such file or directory')
                if stat.S_ISDIR(os.stat(name, dir_fd=fd, follow_symlinks=False).st_mode):
                    unlock_tree(name, fd)
                    shutil.rmtree(name, dir_fd=fd)
                else:
                    os.unlink(name, dir_fd=fd)
                print(f'removed {q(it["real"])} from {label}')
            except OSError as e:
                print(f'{PROG}: {q(it["real"])} in {label}: {e.strerror}', file=sys.stderr)
                failed += 1
            finally:
                if fd is not None:
                    os.close(fd)
    return failed


def set_ro(label, ro):
    r = subprocess.run(['btrfs', 'property', 'set', '-ts', f'{SNAPDIR}/home-{label}', 'ro', ro],
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if r.returncode:
        print(f'{PROG}: {label}: cannot set ro={ro}: {r.stderr.strip()}', file=sys.stderr)
    return r.returncode == 0


def interrupted(signum, _frame):
    raise KeyboardInterrupt


def maint_lock():
    # kept open until exit: maint does not create or prune snapshots meanwhile
    try:
        lock = open(MAINT_LOCK, 'a')
    except FileNotFoundError:
        return None
    except OSError as e:
        die(f'{MAINT_LOCK}: {e.strerror}')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        die('maint is running, try again in a few minutes')
    return lock


def forget(snaps, user, paths, dry):
    _lock = maint_lock()
    found = as_user(user, find, snaps, paths)
    failed = sum(1 for f in found if f is None or not f['labels'])
    items = [f for f in found if f and f['labels']]
    if dry:
        for it in items:
            print(f'{q(it["real"])}: ' + ', '.join(it['labels']))
        return 1 if failed else 0
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, interrupted)
    try:
        wanted = sorted({label for it in items for label in it['labels']})
        writable = {label for label in wanted if set_ro(label, 'false')}
        for it in items:
            failed += len(set(it['labels']) - writable)
            it['labels'] = [label for label in it['labels'] if label in writable]
        failed += as_user(user, delete, snaps, items)
    finally:
        # all of them: a killed run may have left others writable
        for label, _ in snaps:
            set_ro(label, 'true')
    for it in items:
        if it['live']:
            print(f"{PROG}: {q(it['real'])} still exists: delete it too, or the next snapshot keeps it",
                  file=sys.stderr)
    return 1 if failed else 0


def pick(snaps, want):
    want = want.removeprefix('home-')
    hits = [s for s in snaps if s[0] == want] or [s for s in snaps if s[0].startswith(want + '_')]
    if not hits:
        die(f"{q(want)}: no such snapshot, see '{PROG} -l'")
    if len(hits) > 1:
        die(f'{q(want)}: more than one snapshot that day: ' + ', '.join(s[0] for s in hits))
    return hits[0]


def copy_regular(src, dst):
    # a fifo or a device would hang or leak
    if not stat.S_ISREG(os.lstat(src).st_mode):
        print(f'{PROG}: {q(dst)}: not a regular file, skipped', file=sys.stderr)
        return dst
    fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        with open(src, 'rb') as i, os.fdopen(fd, 'wb') as o:
            shutil.copyfileobj(i, o)
        shutil.copystat(src, dst)
    except BaseException:
        os.unlink(dst)
        raise
    return dst


def restore(snaps, want, path, dest):
    label, root = pick(snaps, want)
    real, rel = rel_path(path)
    fd, name = lookup(root, rel)
    try:
        st = None if fd is None else os.stat(name, dir_fd=fd, follow_symlinks=False)
    except OSError:
        st = None
    if st is None:
        die(f'{q(path)}: not in snapshot {label}')
    if dest is None:
        base, ext = os.path.splitext(real)
        if stat.S_ISDIR(st.st_mode) or not ext:
            base, ext = real, ''
        dest = f'{base}.{label}{ext}'
    elif os.path.isdir(dest) and not os.path.islink(dest):
        dest = os.path.join(dest, os.path.basename(real))
    src = f'/proc/self/fd/{fd}/{name}'
    try:
        if stat.S_ISLNK(st.st_mode):
            os.symlink(os.readlink(name, dir_fd=fd), dest)
        elif stat.S_ISDIR(st.st_mode):
            shutil.copytree(src, dest, symlinks=True, copy_function=copy_regular)
        elif stat.S_ISREG(st.st_mode):
            copy_regular(src, dest)
        else:
            die(f'{q(path)}: not a file, folder or symlink')
    except FileExistsError:
        die(f'{q(dest)}: File exists')
    except shutil.Error as e:
        die(f'{q(dest)}: copied with errors: {len(e.args[0])} file(s) failed')
    except OSError as e:
        die(f'{q(e.filename or dest)}: {e.strerror}')
    print(f'{q(real)} ({label}) -> {q(dest)}')


DIFF_TMP = '.snap-diff'
CREATE = {'mkfile', 'mkdir', 'mknod', 'mkfifo', 'mksock', 'symlink', 'link'}
CHANGE = {'write', 'update_extent', 'truncate', 'clone', 'encoded_write', 'fallocate'}
ORPHAN = re.compile(r'o\d+-\d+-\d+')
UNESCAPE = {b'a': b'\a', b'b': b'\b', b'e': b'\x1b', b'f': b'\f', b'n': b'\n',
            b'r': b'\r', b't': b'\t', b'v': b'\v', b' ': b' ', b'\\': b'\\'}


def dump_fields(line):
    # btrfs receive --dump: fields split by spaces, those in paths are escaped
    fields, cur, i = [], b'', 0
    while i < len(line):
        c = line[i:i + 1]
        if c == b'\\' and i + 1 < len(line):
            n = line[i + 1:i + 2]
            if n.isdigit():
                cur += bytes([int(line[i + 1:i + 4], 8)])
                i += 4
                continue
            cur += UNESCAPE.get(n, n)
            i += 2
            continue
        if c in b' \t\n':
            if cur:
                fields.append(cur)
            cur = b''
        else:
            cur += c
        i += 1
    if cur:
        fields.append(cur)
    return fields


def changes(dump):
    """What a --no-data send stream does: {path: (kind, old path)}, kind A M D R."""
    state, gone, dirs, top = {}, {}, set(), None

    def rel(p):
        p = os.fsdecode(p)
        return p[len(top) + 1:] if p.startswith(top + '/') else None

    for line in dump:
        f = dump_fields(line)
        if len(f) < 2:
            continue
        op = f[0].decode()
        if top is None:
            if op in ('snapshot', 'subvol'):
                top = os.fsdecode(f[1])
            continue
        path = rel(f[1])
        if path is None:
            continue
        args = {k.decode(): v for k, _, v in (a.partition(b'=') for a in f[2:])}
        if op in CREATE:
            state[path] = [None, False]
            if op == 'mkdir':
                dirs.add(path)
        elif op == 'rename':
            dest = rel(args.get('dest', b''))
            if dest is None:
                continue
            state.setdefault(path, [path, False])
            # a folder takes along what is known under it
            for k in [k for k in state if k == path or k.startswith(path + '/')]:
                state[dest + k[len(path):]] = state.pop(k)
            if path in dirs:
                dirs.discard(path)
                dirs.add(dest)
        elif op in ('unlink', 'rmdir'):
            old = state.pop(path, [path, False])[0]
            if old is not None:
                gone[old] = op == 'rmdir'
        elif op in CHANGE:
            state.setdefault(path, [path, False])[1] = True

    out = {}
    for path, (old, modified) in state.items():
        if ORPHAN.fullmatch(path.rsplit('/', 1)[-1]):
            continue
        if old is None:
            # saved by writing a new file over the old one
            if gone.pop(path, None) is not None:
                out[path] = ('M', None)
            else:
                out[path] = ('A/' if path in dirs else 'A', None)
        elif old != path:
            out[path] = ('R', old)
        elif modified:
            out[path] = ('M', None)
    for path, is_dir in gone.items():
        out[path] = ('D/' if is_dir else 'D', None)
    return out


def fold(out):
    # a new or deleted folder stands for what is in it
    inside = {}
    for kind in ('A/', 'D/'):
        folders = sorted(p for p, (k, _) in out.items() if k == kind)
        for p in list(out):
            parent = next((d for d in folders if p.startswith(d + '/')), None)
            if parent and out[p][0][0] == kind[0]:
                del out[p]
                inside[parent] = inside.get(parent, 0) + 1
    return inside


def send_dump(parent, child):
    send = subprocess.Popen(['btrfs', 'send', '-q', '--no-data', '-p', parent, child],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    dump = subprocess.Popen(['btrfs', 'receive', '--dump'], stdin=send.stdout,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    send.stdout.close()
    lines, err = dump.communicate()
    serr = send.stderr.read().decode(errors='replace').strip()
    send.wait()
    if send.returncode or dump.returncode:
        die(f'btrfs send failed: {serr or err.decode(errors="replace").strip()}')
    return lines.splitlines()


def diff(snaps, user, since, until, folder):
    home = pwd.getpwnam(user).pw_dir
    home_rel = scope = os.path.relpath(os.path.realpath(home), HOME)
    if scope.startswith('..') or scope == '.':
        die(f'your home {q(home)} is not in {HOME}')
    if folder is not None:
        _, rel = rel_path(folder)
        if rel != scope and not rel.startswith(scope + '/'):
            die(f'{q(folder)}: not in your home')
        scope = rel
    _lock = maint_lock()
    old, _ = pick(snaps, since)
    new = 'now'
    tmp = f'{SNAPDIR}/{DIFF_TMP}'
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, interrupted)
    try:
        if until is None:
            # a killed run leaves it behind
            if os.path.lexists(tmp):
                subprocess.run(['btrfs', 'subvolume', 'delete', tmp], stdout=subprocess.DEVNULL)
            r = subprocess.run(['btrfs', 'subvolume', 'snapshot', '-r', HOME, tmp],
                               stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
            if r.returncode:
                die(f'cannot snapshot {HOME}: {r.stderr.strip()}')
            child = tmp
        else:
            new, _ = pick(snaps, until)
            if new <= old:
                die(f'{new} is not newer than {old}')
            child = f'{SNAPDIR}/home-{new}'
        lines = send_dump(f'{SNAPDIR}/home-{old}', child)
    finally:
        if until is None and os.path.lexists(tmp):
            subprocess.run(['btrfs', 'subvolume', 'delete', tmp], stdout=subprocess.DEVNULL)

    # only your own files: the snapshots hold every home
    out = {p: c for p, c in changes(lines).items()
           if p.startswith(scope + '/') or (c[1] or '').startswith(scope + '/')}
    inside = fold(out)

    def show(p):
        p = '~' + p[len(home_rel):] if p == home_rel or p.startswith(home_rel + '/') else f'{HOME}/{p}'
        return ''.join(c if c.isprintable() else '?' for c in p)

    count = {}
    for path in sorted(out):
        kind, was = out[path]
        count[kind[0]] = count.get(kind[0], 0) + 1
        line = f'{kind[0]}  {show(path)}' + ('/' if kind.endswith('/') else '')
        if was:
            line += f'  (was {show(was)})'
        if path in inside:
            line += f'  ({inside[path]} inside)'
        print(line)
    words = {'A': 'added', 'M': 'modified', 'D': 'deleted', 'R': 'moved'}
    total = ', '.join(f'{count[k]} {w}' for k, w in words.items() if k in count) or 'no changes'
    print(f'{old} -> {new}: {total}', file=sys.stderr)


def main():
    global PROG
    argv = sys.argv[1:]
    forgetting = argv[:1] == ['--forget']
    if forgetting:
        PROG, argv = 'forget', argv[1:]
    try:
        opts, args = getopt.gnu_getopt(argv, 'hn' if forgetting else 'hlr:d:t:', ['help'])
    except getopt.GetoptError as e:
        if 'requires argument' in e.msg:
            usage_error(f"option requires an argument -- '{e.opt}'")
        if 'must not have an argument' in e.msg:
            usage_error(f"option '--{e.opt}' doesn't allow an argument")
        usage_error(f"invalid option -- '{e.opt}'" if len(e.opt) == 1 else f"unrecognized option '--{e.opt}'")
    mode, want, until = ('forget' if forgetting else 'versions'), None, None
    dry = False
    for o, a in opts:
        if o in ('-h', '--help'):
            print(FORGET_USAGE if forgetting else USAGE, end='')
            return 0
        if o == '-n':
            dry = True
        if o == '-l':
            mode = 'list'
        if o == '-r':
            mode, want = 'restore', a
        if o == '-d':
            mode, want = 'diff', a
        if o == '-t':
            until = a
    if mode == 'list' and args:
        usage_error(f'extra operand {q(args[0])}')
    if mode == 'versions' and len(args) != 1:
        usage_error('missing file operand' if not args else f'extra operand {q(args[1])}')
    if mode == 'forget' and not args:
        usage_error('missing file operand')
    if mode == 'restore' and not 1 <= len(args) <= 2:
        usage_error('missing file operand' if not args else f'extra operand {q(args[2])}')
    if mode == 'diff' and len(args) > 1:
        usage_error(f'extra operand {q(args[1])}')
    if until is not None and mode != 'diff':
        usage_error('-t goes with -d')

    if os.geteuid() != 0:
        os.execvp('doas', ['doas', '--', os.path.realpath(sys.argv[0]), *sys.argv[1:]])
    user = os.environ.get('DOAS_USER')
    if not user or user == 'root':
        die('run it as your own user, it asks for doas by itself')
    snaps = open_snapshots()
    if mode == 'forget':
        return forget(snaps, user, args, dry)
    if mode == 'diff':
        # btrfs send needs root, only the names under your home are shown
        diff(snaps, user, want, until, args[0] if args else None)
        return 0
    drop_to(user)

    if mode == 'list':
        for label, _ in snaps:
            print(label)
    elif mode == 'versions':
        list_versions(snaps, args[0])
    else:
        restore(snaps, want, args[0], args[1] if len(args) > 1 else None)
    return 0


if __name__ == '__main__':
    try:
        code = main()
        sys.stdout.flush()
    except KeyboardInterrupt:
        code = 130
    except BrokenPipeError:
        # stdout closed early (| head)
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        code = 141
    sys.exit(code)
