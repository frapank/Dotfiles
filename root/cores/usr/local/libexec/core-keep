#!/bin/sh
# kernel.core_pattern: core dump on stdin, $1 pid, $2 uid, $3 program.
# Keeps only g0wm dumps, written as their user so a symlink cannot make root overwrite a file.
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C

pid=${1:-} uid=${2:-} prog=${3:-}
[ "$prog" = g0wm ] || exit 0
case $pid in '' | *[!0-9]*) exit 0 ;; esac
case $uid in '' | *[!0-9]*) exit 0 ;; esac
[ "$uid" -ge 1000 ] || exit 0

ent=$(getent passwd "$uid") || exit 0
gid=$(printf '%s\n' "$ent" | cut -d: -f4)
home=$(printf '%s\n' "$ent" | cut -d: -f6)
dir=$home/.local/state/g0wm
[ -d "$dir" ] && [ ! -L "$dir" ] && [ "$(stat -c %u -- "$dir")" = "$uid" ] || exit 0

exec setpriv --reuid="$uid" --regid="$gid" --clear-groups --no-new-privs \
    sh -c 'umask 077; exec cat >"$1"' sh "$dir/core.$pid.$(date +%Y%m%d-%H%M%S)"
