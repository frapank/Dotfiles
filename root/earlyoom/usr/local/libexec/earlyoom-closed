#!/bin/sh
# Run by earlyoom (-N) after it closed a program: prints its name to the
# journal of earlyoom.service, the watchdog reads it there and notifies. Must
# be quick, memory is short.
# EARLYOOM_NAME comes from the closed program: any bytes, or none.
case ${EARLYOOM_PID:-} in '' | *[!0-9]*) exit 0 ;; esac
printf 'closed: %s\n' "$(printf '%s' "${EARLYOOM_NAME:-}" | LC_ALL=C tr -c 'A-Za-z0-9 ._+-' _)"
