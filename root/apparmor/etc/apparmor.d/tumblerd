abi <abi/4.0>,

include <tunables/global>

profile tumblerd /usr/lib/@{multiarch}/tumbler-1/tumblerd flags=(attach_disconnected) {
  include <abstractions/dotfiles/app-read>
  include <abstractions/dotfiles/other-shm>
  include <abstractions/dotfiles/secrets>
  include <abstractions/dotfiles/chat-data>
  include <abstractions/dotfiles/pipewire-manager>
  include <abstractions/dotfiles/persist>
  include <abstractions/dotfiles/setuid>
  include <abstractions/dotfiles/browser-data>
  include <abstractions/dotfiles/no-av>

  @{HOMEDIRS} r,
  owner @{HOME}/ r,
  owner @{HOME}/[^.]** r,
  owner @{HOME}/.config/tumbler/{,**} r,
  /{mnt,media}/{,**} r,
  @{run}/media/{,**} r,
  # GIO's mount monitor
  @{run}/mount/utab r,
  owner /tmp/** rwk,
  owner /dev/shm/** rwk,
  # GStreamer's ORC JIT tries these locations for its generated code.
  owner /tmp/orcexec.* mrw,
  owner @{run}/user/@{uid}/orcexec.* mrw,
  owner @{HOME}/orcexec.* mrw,
  # Plugin discovery probes video hardware; thumbnails only use files.
  deny /dev/media* rw,

  /usr/bin/** ix,
  /usr/lib/@{multiarch}/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner ix,
  owner @{run}/user/@{uid}/.dbus-filter/tumblerd/* rw,

  include if exists <local/tumblerd>
}
