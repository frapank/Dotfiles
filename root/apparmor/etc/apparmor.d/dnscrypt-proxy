abi <abi/4.0>,

include <tunables/global>

# Debian's unit starts it as _dnscrypt-proxy, with the socket of dnscrypt-proxy.socket
profile dnscrypt-proxy /usr/sbin/dnscrypt-proxy {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>
  include <abstractions/dotfiles/root-secrets>

  deny capability net_admin,

  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,
  network netlink raw,

  /usr/sbin/dnscrypt-proxy mrix,
  /etc/ r,
  /etc/** r,
  /usr/share/dnscrypt-proxy/{,**} r,
  audit deny /etc/dnscrypt-proxy/** wl,
  /var/cache/dnscrypt-proxy/ rw,
  /var/cache/dnscrypt-proxy/** rwk,
  /var/log/dnscrypt-proxy/{,**} rw,
  @{run}/dnscrypt-proxy/{,**} rw,

  @{PROC}/** r,
  @{sys}/** r,

  include if exists <local/dnscrypt-proxy>
}
