abi <abi/4.0>,

include <tunables/global>

# Children may enter a bwrap mount namespace while inheriting the terminal.
profile foot /usr/bin/foot{,client} flags=(attach_disconnected) {
  include <abstractions/dotfiles/app-read>
  include <abstractions/dotfiles/other-shm>
  include <abstractions/dotfiles/secrets>
  include <abstractions/dotfiles/chat-data>
  include <abstractions/dotfiles/pipewire-manager>
  include <abstractions/dotfiles/browser-data>

  owner @{run}/user/@{uid}/wayland-[0-9]* rw,
  owner @{HOME}/.config/foot/{,**} r,

  /{usr,opt}/** ux,
  /usr/bin/foot ix,
  signal (send) peer=unconfined,

  include if exists <local/foot>
}
