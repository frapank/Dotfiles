abi <abi/4.0>,

include <tunables/global>

# games are untrusted code: all but secrets, shell startup and setuid programs
# /usr/bin/steam is a symlink to bin_steam.sh
profile steam /{usr/lib/steam/bin_steam.sh,home/*/.local/share/Steam/steam.sh} flags=(attach_disconnected) {
  include <abstractions/dotfiles/secrets>
  include <abstractions/dotfiles/persist>
  include <abstractions/dotfiles/setuid>
  include <abstractions/dotfiles/browser-data>

  file,
  network,
  unix,
  dbus,
  signal,
  ptrace,
  capability,
  userns,
  mount,
  umount,
  pivot_root,

  # links open in librewolf under its own profile
  /usr/lib/librewolf/librewolf Px,

  include if exists <local/steam>
}
