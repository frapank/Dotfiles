abi <abi/4.0>,

include <tunables/global>

# games are untrusted code: all but secrets, shell startup and setuid programs
# /usr/games/steam of steam-installer or bin_steam.sh of Valve's package; Debian's own
# steam profile, unconfined, is disabled
profile steam /{usr/games/steam,usr/lib/steam/bin_steam.sh,home/*/.local/share/Steam/steam.sh} flags=(attach_disconnected) {
  include <abstractions/dotfiles/secrets>
  include <abstractions/dotfiles/chat-data>
  include <abstractions/dotfiles/persist>
  include <abstractions/dotfiles/setuid>
  include <abstractions/dotfiles/browser-data>

  file,
  network,
  unix,
  dbus,
  signal,
  ptrace,
  capability,
  userns,
  mount,
  umount,
  pivot_root,

  # workshop mods can carry a .git, and git never runs in the library
  priority=1 @{HOME}/{.steam,.local/share/Steam}/**/.git/{config,hooks/{,**}} wl,
  # the launcher shortcuts it tries to add for the games at every start: denied, not logged
  priority=1 deny @{HOME}/.local/share/applications/{,**} wl,

  # links open in librewolf under its own profile
  /usr/share/librewolf/{librewolf,librewolf-bin} Px,

  include if exists <local/steam>
}
