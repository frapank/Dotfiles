  abi <abi/4.0>,

  audit deny @{HOME}/.ssh/{,**} mrwkl,
  audit deny @{HOME}/.gnupg/{,**} mrwkl,
  audit deny @{HOME}/.password-store/{,**} mrwkl,
  audit deny @{HOME}/.local/share/keyrings/{,**} mrwkl,
  audit deny @{HOME}/.{age,config/age,config/sops}/{,**} mrwkl,
  audit deny @{HOME}/.{aws,kube,config/gh,config/rclone}/{,**} mrwkl,
  audit deny @{HOME}/.{netrc,git-credentials,config/git/credentials,docker/config.json} mrwkl,
  audit deny @{HOME}/.cargo/credentials{,.toml} mrwkl,
  # Chromium (Steam's webhelper) opens its NSS store at every start and works without it: denied, not logged
  deny @{HOME}/{.pki,.local/share/pki}/{,**} mrwkl,
  audit deny @{HOME}/.{bash,python,psql,mysql,sqlite}_history mrwkl,
  # logins of other apps
  audit deny @{HOME}/.claude{,.json*,/**} mrwkl,
  audit deny @{HOME}/.var/app/{,**} mrwkl,
  # editor history, g0wm core dumps
  audit deny @{HOME}/.viminfo mrwkl,
  audit deny @{HOME}/.local/state/{nvim,g0wm}/{,**} mrwkl,
  # other core dumps
  audit deny @{HOME}/{,**/}{core,vgcore}{,.[0-9]*} mrwkl,
  audit deny /{tmp,var/tmp}/{core,vgcore}{,.[0-9]*} mrwkl,
  audit deny /var/{crash,lib/systemd/coredump}/{,**} mrwkl,

  # these run commands outside the sandbox, awake turns the lock off
  audit deny @{run}/user/@{uid}/{systemd,nvim.*,tmux-*,awake}{,/**} rw,
  audit deny /tmp/{tmux-*,node-compile-cache,claude-*}{,/**} rw,

  # AppArmor 4.1 does not enforce unix rules on this kernel: connect() is closed by dbus-filter and landlock-scope
  audit deny @{run}/user/@{uid}/{bus,openssh_agent,ssh-agent.socket} rw,
  audit deny @{run}/user/@{uid}/{gnupg,keyring,at-spi,gvfsd}/{,**} rw,
  audit deny /tmp/{dbus-*,ssh-*/**,.ICE-unix/**} rw,
