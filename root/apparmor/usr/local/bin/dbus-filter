#!/bin/sh
[ $# -ge 2 ] || {
    echo "usage: dbus-filter APP PROGRAM [ARGS...]" >&2
    exit 2
}
app=$1 prog=$2
shift 2

open='--talk=org.dotfiles.Open
	--call=org.gnome.Loupe=org.freedesktop.Application.Open@/org/gnome/Loupe
	--call=org.gnome.Loupe=org.freedesktop.Application.Activate@/org/gnome/Loupe
	--call=org.gnome.Showtime=org.freedesktop.Application.Open@/org/gnome/Showtime
	--call=org.gnome.Showtime=org.freedesktop.Application.Activate@/org/gnome/Showtime'
# xdg-desktop-portal sees these apps as host apps and asks nothing, a screenshot included
P=org.freedesktop.portal
D=/org/freedesktop/portal/desktop
portal="--call=$P.Desktop=org.freedesktop.DBus.Properties.*@$D
	--call=$P.Desktop=$P.Settings.*@$D
	--broadcast=$P.Desktop=$P.Settings.SettingChanged@$D
	--call=$P.Desktop=$P.FileChooser.*@$D
	--call=$P.Desktop=$P.Request.Close@$D/request/*
	--broadcast=$P.Desktop=$P.Request.Response@$D/request/*"
# dconf writes go to the sandbox database, not the user's: programs outside act on it (virt-manager URIs)
W=/ca/desrt/dconf/Writer/sandbox
dconf="--call=ca.desrt.dconf=ca.desrt.dconf.Writer.*@$W
	--broadcast=ca.desrt.dconf=ca.desrt.dconf.Writer.*@$W"
# no gvfs: it fetches http for offline apps and can mark launchers trusted
common="$portal $dconf $open"
av=1 net=0 hm=0 ns=0
case $app in
librewolf)
    # io.gitlab.librewolf.*: link remoting
    rules="$common --own=org.mozilla.* --own=io.gitlab.librewolf.* --own=org.mpris.MediaPlayer2.*
		--talk=org.freedesktop.Notifications
		--call=org.freedesktop.FileManager1=org.freedesktop.FileManager1.ShowItems@/org/freedesktop/FileManager1
		--call=$P.Desktop=$P.ScreenCast.*@$D
		--call=$P.Desktop=$P.Session.Close@$D/session/*
		--broadcast=$P.Desktop=$P.Session.Closed@$D/session/*"
    net=1 ns=1
    ;;
showtime) rules="$common --own=org.gnome.Showtime.* --own=org.mpris.MediaPlayer2.*" hm=1 ;;
papers) rules="$common --own=org.gnome.Papers.*" av=0 hm=1 ;;
libreoffice) rules="$common --own=org.libreoffice.*" av=0 ;;
xarchiver) rules=$common av=0 hm=1 ;;
tumblerd) rules='--own=org.freedesktop.thumbnails.*' av=0 hm=1 ;;
*)
    echo "dbus-filter: unknown app $app" >&2
    exit 2
    ;;
esac

run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
bus=${DBUS_SESSION_BUS_ADDRESS:-${DBUS_STARTER_ADDRESS:-}}
dir=$run/.dbus-filter/$app
sock=$dir/$$

forward() {
    [ "$app" != tumblerd ] || return 1
    list=
    for a in "$@"; do
        case $a in
        -* | *://*) ;;
        /*) ;;
        *) a=$PWD/$a ;;
        esac
        a=$(printf %s "$a" | sed "s/[\\\\']/\\\\&/g")
        list="$list${list:+, }'$a'"
    done
    exec gdbus call --session -d org.dotfiles.Open -o /org/dotfiles/Open \
        -m org.dotfiles.Open.Open "$app" "[$list]" >/dev/null
}

prepare() {
    mkdir -m 0700 "${dir%/*}" "$dir" 2>/dev/null
    [ -d "$dir" ] && [ "$(stat -c %u "$dir")" = "$(id -u)" ] || return 1
    for f in "$dir"/*; do
        pid=${f##*/}
        [ -e "$f" ] && [ ! -d "/proc/${pid%%.*}" ] && rm -f "$f"
    done
    return 0
}

start() {
    [ -n "$bus" ] && command -v xdg-dbus-proxy >/dev/null || return 1
    rm -f "$sock" "$sock.sync"
    mkfifo -m 0600 "$sock.sync" || return 1
    set -f
    # shellcheck disable=SC2086
    xdg-dbus-proxy --fd=3 "$bus" "$sock" --filter $rules 3>"$sock.sync" &
    set +f
    exec 4<"$sock.sync"
    rm -f "$sock.sync"
    [ "$(head -c 1 <&4)" = x ]
}

mask() {
    case $1 in "$run"/*) return 0 ;; esac
    if [ -S "$1" ] || [ -f "$1" ]; then
        set -- --ro-bind /dev/null "$1"
    elif [ -d "$1" ]; then
        set -- --tmpfs "$1"
    else
        return 0
    fi
    masks="$masks $1 $2 $3"
}

if [ "$(cat /proc/self/attr/apparmor/current 2>/dev/null || echo unconfined)" != unconfined ]; then
    forward "$@"
    exit 1
fi
if ! command -v bwrap >/dev/null; then
    echo "dbus-filter: bwrap missing, $app runs without its sandbox and session bus" >&2
    DBUS_SESSION_BUS_ADDRESS=disabled: exec "$prog" "$@"
fi
own=0 filtered=0
if prepare; then
    own=1
    start && filtered=1
fi
[ "$filtered" = 1 ] || echo "dbus-filter: no filtered bus for $app, it runs without a session bus" >&2

masks=
real=${bus#unix:path=}
[ "$real" = "$bus" ] || mask "${real%%,*}"
# tmux runs commands outside, ssh-agent signs with the keys
for f in /tmp/dbus-* /tmp/ssh-* "/tmp/tmux-$(id -u)" /tmp/.ICE-unix; do
    mask "$f"
done
mask "${SSH_AUTH_SOCK:-}"
mask "$HOME/.gnupg"
# an empty runtime dir: the foot server, systemd and the agents there run commands or hold keys
runfs="--perms 0700 --tmpfs $run --bind-try $run/dconf $run/dconf
	--bind-try $run/doc $run/doc --bind-try $run/gvfs $run/gvfs"
[ "$av" = 0 ] ||
    runfs="$runfs --bind-try $run/pipewire-0 $run/pipewire-0 --bind-try $run/pulse/native $run/pulse/native"
unshare=
[ "$net" = 1 ] || unshare=--unshare-net
# own processes only
[ "$ns" = 1 ] || unshare="$unshare --unshare-user --disable-userns --unshare-pid --unshare-ipc --proc /proc"
preload=
lib=/usr/local/lib/libhardened_malloc-light.so
[ "$hm" = 0 ] || [ ! -f "$lib" ] || preload="--setenv LD_PRELOAD $lib"
x11=
wl=
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    mask /tmp/.X11-unix
    # AppArmor blocks the librewolf wayland proxy
    # Electron parents pass GDK_BACKEND=x11
    x11='--unsetenv DISPLAY --unsetenv XAUTHORITY --setenv GDK_BACKEND wayland --setenv MOZ_DISABLE_WAYLAND_PROXY 1'
    # never the real compositor socket: without wl-sandbox the app gets no display
    case $WAYLAND_DISPLAY in /*) mask "$WAYLAND_DISPLAY" ;; esac
    if [ "$own" = 1 ] && /usr/local/libexec/wl-sandbox --probe 2>/dev/null; then
        wl=$sock.wayland
    else
        echo "dbus-filter: no wl-sandbox socket for $app, it has no display (the compositor needs wp_security_context_v1)" >&2
    fi
fi

if [ "$filtered" = 1 ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$sock"
    [ -z "${DBUS_STARTER_ADDRESS:-}" ] || export DBUS_STARTER_ADDRESS="unix:path=$sock"
    # sandbox writes first, user settings below
    db=${XDG_CONFIG_HOME:-$HOME/.config}/dconf/user
    if { echo user-db:sandbox && { [ ! -f "$db" ] || echo "file-db:$db"; }; } >"$sock.dconf"; then
        export DCONF_PROFILE="$sock.dconf"
    fi
else
    export DBUS_SESSION_BUS_ADDRESS=disabled:
    unset DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE
fi
masks="$masks $runfs"
[ "$own" = 0 ] || masks="$masks --bind $dir $dir"
# Landlock: no abstract sockets (Xwayland) or signals outside, pathname sockets only the ones listed
ll=
if [ -x /usr/local/libexec/landlock-scope ]; then
    ll="/usr/local/libexec/landlock-scope -u /run/dbus/system_bus_socket"
    [ "$own" = 0 ] || ll="$ll -u $dir"
    [ "$av" = 0 ] || ll="$ll -u $run/pipewire-0 -u $run/pulse/native"
    # soffice and xarchiver find their own running instance on a socket in /tmp
    case $app in libreoffice | xarchiver) ll="$ll -u /tmp" ;; esac
    ll="$ll --"
else
    echo "dbus-filter: no landlock-scope, $app keeps its unix sockets" >&2
fi
set -f
# shellcheck disable=SC2086
set -- bwrap --dev-bind / / $masks $unshare --new-session $x11 $preload -- $ll "$prog" "$@"
[ -z "$wl" ] || set -- /usr/local/libexec/wl-sandbox "$app" "$wl" -- "$@"
exec "$@"
