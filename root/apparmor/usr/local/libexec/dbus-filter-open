#!/usr/bin/python3
import os
import re
import signal
import subprocess
import threading

from gi.repository import Gio, GLib

APPS = {
    "librewolf": "/usr/local/bin/librewolf",
    "papers": "/usr/local/bin/papers",
    "showtime": "/usr/local/bin/showtime",
    "xarchiver": "/usr/local/bin/xarchiver",
    "libreoffice": "/usr/local/bin/libreoffice",
    "loupe": "/usr/bin/loupe",
}
FLAGS = {"--new-window", "--private-window", "--writer", "--calc", "--impress", "--draw", "--math", "--base"}
SCHEMES = ("http://", "https://", "file://")
WEB = ("http://", "https://")
NET = {"librewolf"}
XML = """<node><interface name="org.dotfiles.Open">
<method name="Open"><arg type="s" direction="in"/><arg type="as" direction="in"/></method>
</interface></node>"""
IDLE = 60

loop = GLib.MainLoop()
timer = 0
pending = 0


def allowed(arg):
    if arg in FLAGS:
        return True
    if arg.startswith(SCHEMES):
        return True
    return os.path.isabs(arg) and os.path.exists(arg)


def stop():
    if pending:
        return True
    loop.quit()
    return False


def idle():
    global timer
    if timer:
        GLib.source_remove(timer)
    timer = GLib.timeout_add_seconds(IDLE, stop)


def environ():
    env = dict(os.environ)
    bus = env.pop("DBUS_STARTER_ADDRESS", None)
    env.pop("DBUS_STARTER_BUS_TYPE", None)
    if bus and "DBUS_SESSION_BUS_ADDRESS" not in env:
        env["DBUS_SESSION_BUS_ADDRESS"] = bus
    return env


def sandbox_of(conn, sender):
    try:
        pid, = conn.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                              "GetConnectionUnixProcessID", GLib.Variant("(s)", (sender,)),
                              GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1, None).unpack()
        with open(f"/proc/{pid}/attr/apparmor/current") as f:
            label = f.read().strip()
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            argv = f.read().split(b"\0")
    except (GLib.Error, OSError):
        return "unknown"
    if label != "unconfined":
        return label.split(" ")[0]
    # the proxy dbus-filter started for the app
    for a in argv:
        m = re.search(rb"/\.dbus-filter/([a-z]+)/[0-9]+$", a)
        if m:
            return m.group(1).decode()
    return None


def launch(app, args, token=None):
    env = environ()
    if token:
        env["XDG_ACTIVATION_TOKEN"] = token
    subprocess.Popen([APPS[app], *args], env=env, cwd="/", start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def copy(urls):
    subprocess.run(["wl-copy", "--", "\n".join(urls)], env=environ(), start_new_session=True,
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def done():
    global pending
    pending -= 1


def confirm(who, app, args, urls):
    global pending
    pending += 1

    def wait():
        rfd, wfd = os.pipe()
        r = subprocess.run(["notify-send", "-a", f"\uf132 {who}", "-h", f"string:desktop-entry:{who}",
                            "-u", "critical", "-A", "default=Open", "-A", "copy=Copy link",
                            f"--activation-token-fd={wfd}",
                            f"{who} wants to open a link", GLib.markup_escape_text("\n".join(urls))],
                           env=environ(), stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           pass_fds=(wfd,))
        os.close(wfd)
        with os.fdopen(rfd, "rb") as p:
            token = p.read().decode(errors="replace").strip()
        action = r.stdout.strip()
        if action == "default":
            GLib.idle_add(launch, app, args, token)
        elif action == "copy":
            copy(urls)
        GLib.idle_add(done)

    threading.Thread(target=wait, daemon=True).start()


def call(conn, sender, path, iface, method, params, invocation):
    app, args = params.unpack()
    idle()
    if app not in APPS or not all(allowed(a) for a in args):
        invocation.return_dbus_error("org.dotfiles.Open.Refused", f"refused: {app} {args}")
        return
    who = sandbox_of(conn, sender)
    urls = [a for a in args if a.startswith(WEB)]
    if who is not None and who not in NET and urls:
        confirm(who, app, args, urls)
    else:
        launch(app, args)
    invocation.return_value(None)


def acquired(conn, name):
    node = Gio.DBusNodeInfo.new_for_xml(XML)
    conn.register_object_with_closures2("/org/dotfiles/Open", node.interfaces[0], call, None, None)


signal.signal(signal.SIGCHLD, signal.SIG_IGN)
Gio.bus_own_name(Gio.BusType.SESSION, "org.dotfiles.Open", Gio.BusNameOwnerFlags.NONE,
                 acquired, None, lambda *a: loop.quit())
idle()
loop.run()
