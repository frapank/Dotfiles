[Plymouth Theme]
Name=g0wm
Description=Minimal theme: the g0wm logo on its black, a thin amber line for the progress under it, the gtklock-style password box. The logo and the colors are written by script/g0wm-theme.py. With desktop-base installed, the initramfs hook of Debian puts its own logo in place of the g0wm one.
ModuleName=two-step

[two-step]
Font=Sans 12
TitleFont=Sans 30
ImageDir=/usr/share/plymouth/themes/g0wm
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.64
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.64
HorizontalAlignment=.5
VerticalAlignment=.65
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0a0a0a
BackgroundEndColor=0x0a0a0a
ProgressBarBackgroundColor=0x222222
ProgressBarForegroundColor=0xe0a86a
MessageBelowAnimation=true
ProgressBarWidth=260
ProgressBarHeight=4
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.63

[boot-up]
UseEndAnimation=false
UseProgressBar=true

[shutdown]
UseEndAnimation=false
UseProgressBar=true

[reboot]
UseEndAnimation=false
UseProgressBar=true

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer
