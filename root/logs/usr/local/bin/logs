#!/bin/sh
set -u
export LC_ALL=C.UTF-8

PSTORE=/var/lib/systemd/pstore
SESSION=${XDG_STATE_HOME:-$HOME/.local/state}/g0wm
LOGS='everything kernel errors daemon user debug'

usage() {
    cat <<EOF
Usage: logs [-u] [-n|-p] [COMMAND [ARGS]]
Reads the system journal, in local time: every boot, also the ones with
another machine ID. Long output opens in less at the end: q quits, / searches.

  (none), follow [LOG...]   new lines as they come (default: everything)
  LOG                       the same as follow LOG: logs kernel
  show [LOG...]             the whole history (default: everything)
  since WHEN [LOG...]       from WHEN on (default: everything)
  boot [LOG...]             since this boot (default: everything)
  errors [WHEN]             errors and worse (default: since boot)
  grep REGEX [LOG...]       lines matching REGEX, any case (default: everything)
  around TEXT [LOG...]      each line holding TEXT, with what came before and
                            after it (default: everything)
  service NAME [WHEN]       what a service logged: chrony, maint, watchdog,
                            or one of 'services': pipewire, idle...
  crashes [WHEN]            segfaults, fatal signals, out of memory, kernel bugs,
                            lockups, GPU hangs, hardware and disk errors
  apparmor [WHEN]           what AppArmor blocked, counted per app
  firewall [WHEN]           what the firewall dropped, counted per source
  usb [WHEN]                USB devices plugged in and out
  auth [WHEN]               logins, doas, passwords
  panics                    kernel crashes pstore saved across a reboot
  session                   the g0wm session log and its core dumps
  status                    services, space used, how far back the journal goes
  list                      the logs there are

  -u  times in UTC, as stored
  -n  no pager, no colors
  -p  always the pager, even when it fits the screen (for a window of its own)

LOG: $LOGS
WHEN: 30m 2h 3d 1w, boot, today, yesterday, or a date like '2026-09-28 14:00'.
Without WHEN the whole history is shown.
EOF
}

die() {
    printf 'logs: %s\n' "$*" >&2
    exit 2
}

hidden() {
    [ "$(id -u)" != 0 ] && ! id -Gn | tr ' ' '\n' | grep -qx proc &&
        awk '$2 == "/proc" && $4 ~ /hidepid=/ { f = 1 } END { exit !f }' /proc/self/mounts
}

reader() { [ "$(id -u)" = 0 ] || id -Gn | tr ' ' '\n' | grep -qxE 'systemd-journal|adm'; }

nogroup() {
    reader && return 0
    die "you are not in the systemd-journal group: run 'doas gpasswd -a $(id -un) systemd-journal', then log in again"
}

# the journalctl matches of a LOG: words of one group, the groups OR-ed with +
match() {
    case $1 in
    everything) ;;
    kernel) echo _TRANSPORT=kernel ;;
    errors) echo PRIORITY=0 PRIORITY=1 PRIORITY=2 PRIORITY=3 ;;
    daemon) echo SYSLOG_FACILITY=3 ;;
    user) echo "_UID=$(id -u)" ;;
    debug) echo PRIORITY=7 ;;
    *) die "no log named '$1', see 'logs list'" ;;
    esac
}

# the matches of LOG..., set as the positional parameters of the caller
matches() {
    M=
    for l; do
        m=$(match "$l") || exit 2
        # everything takes in the others
        [ -n "$m" ] || {
            M=
            return 0
        }
        M="$M${M:+ + }$m"
    done
}

when() {
    case $1 in
    boot) s=$(awk '/^btime/ { print $2 }' /proc/stat) ;;
    today) s=$(date -d 'today 00:00' +%s) ;;
    yesterday) s=$(date -d 'yesterday 00:00' +%s) ;;
    *[0-9][mhdw])
        n=${1%?}
        case $n in *[!0-9]*) die "cannot read '$1' as a time" ;; esac
        case $1 in
        *m) u=minutes ;;
        *h) u=hours ;;
        *d) u=days ;;
        *) u=weeks ;;
        esac
        s=$(date -d "$n $u ago" +%s)
        ;;
    *)
        # date reads '5x' as military time zone X
        case $1 in *[0-9]*[-:/]* | *[-:/]*[0-9]*) ;; *) false ;; esac &&
            s=$(date -d "$1" +%s 2>/dev/null) ||
            die "cannot read '$1' as a time: try 30m 2h 3d boot today or '2026-09-28 14:00'"
        ;;
    esac
    echo "@$s"
}

since() {
    SINCE=
    [ -z "${1:-}" ] || SINCE=$(when "$1") || exit 2
}

# every machine ID: maint gives the machine a new one at each boot
j() {
    # shellcheck disable=SC2086
    SYSTEMD_COLORS=$COLOR journalctl --merge --no-pager -q --no-hostname -o short-iso \
        ${UTCOPT} ${SINCE:+--since "$SINCE"} "$@"
}

# 2026-09-28T14:00:00+02:00 becomes 2026-09-28 14:00:00, dimmed
fmt() {
    sed -u -E "s/^([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9]{2}:[0-9]{2}:[0-9]{2})[^ ]* /$C_D\\1 \\2$C_0 /"
}

# output that fits the screen skips less, which would pad it with ~
page() {
    TMP=$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" logs.XXXXXX) || exit 2
    cat >"$TMP"
    if ! [ -s "$TMP" ]; then
        printf '%snothing found%s\n' "$C_D" "$C_0" >&2
        [ "$PAGE" != 2 ] || printf 'nothing found\n' | less
    elif [ "$PAGE" = 0 ]; then
        cat -- "$TMP"
    else
        size=$(stty size </dev/tty 2>/dev/null) || size='24 80'
        h=$(gawk -v w="${size#* }" '{
			gsub(/\033\[[0-9;]*m/, "")
			n += length($0) > w ? int((length($0) - 1) / w) + 1 : 1
		} END { print n + 0 }' "$TMP")
        if [ "$PAGE" = 1 ] && [ "$h" -lt "${size% *}" ]; then
            cat -- "$TMP"
        else
            [ "$(id -u)" != 0 ] || export LESSSECURE=1
            # stdin keeps lesspipe and the temp file name out
            case ${1:-} in
            top) env -u LESSOPEN -u LESSCLOSE less -R <"$TMP" ;;
            table) env -u LESSOPEN -u LESSCLOSE less -R --header=1 +G <"$TMP" ;;
            *) env -u LESSOPEN -u LESSCLOSE less -R +G <"$TMP" ;;
            esac
        fi
    fi
    rm -f -- "$TMP"
    TMP=
}

table() {
    IFS= read -r first || return 0
    f=$1
    shift
    printf "%s$f%s\n" "$C_B" "$@" "$C_0"
    printf '%s\n' "$first"
    cat
}

show() {
    [ $# -gt 0 ] || set -- everything
    nogroup
    matches "$@"
    # shellcheck disable=SC2086
    j $M | fmt | page
}

follow() {
    [ $# -gt 0 ] || set -- everything
    nogroup
    matches "$@"
    # shellcheck disable=SC2086
    j -f -n 20 $M | fmt
}

pick() {
    nogroup
    re=$1
    shift
    j --case-sensitive=true -g "$re" "$@" | fmt | page
}

LIB='
function shown(ts) {
	return substr(ts, 1, 10) " " substr(ts, 12, 8)
}'

apparmor() {
    nogroup
    # the audit socket of journald takes them from the kernel log when it is on
    (
        COLOR=0
        j _TRANSPORT=kernel _TRANSPORT=audit -g 'apparmor="DENIED"'
    ) | gawk "$LIB"'
	function get(f) {
		if (!match($0, " " f "=\"[^\"]*\"")) return ""
		return substr($0, RSTART + length(f) + 3, RLENGTH - length(f) - 4)
	}
	{
		what = get("name")
		if (what == "") what = get("capname")
		if (what == "") what = get("peer")
		# paths outside the bwrap namespace come without the leading /
		if (index(get("info"), "disconnected path")) what = "/" what " (disconnected)"
		k = get("profile") SUBSEP get("operation") SUBSEP get("requested_mask") SUBSEP what
		n[k]++
		last[k] = $1
	}
	END {
		for (k in n) {
			split(k, a, SUBSEP)
			printf "%6d  %s  %-22s %-14s %-4s %s\n", n[k], shown(last[k]), a[1], a[2], a[3], a[4]
		}
	}' | sort -k2,3 | table '%6s  %-19s  %-22s %-14s %-4s %s' times 'last time' app operation mask what | page table
}

firewall() {
    nogroup
    (
        COLOR=0
        j _TRANSPORT=kernel -g 'nft-[a-z-]+: '
    ) | gawk "$LIB"'
	function get(f) {
		if (!match($0, " " f "=[^ ]*")) return ""
		return substr($0, RSTART + length(f) + 2, RLENGTH - length(f) - 2)
	}
	{
		match($0, /nft-[a-z-]+: /)
		rule = substr($0, RSTART, RLENGTH - 2)
		proto = get("PROTO")
		if (proto == 1) proto = "ICMP"
		else if (proto == 2) proto = "IGMP"
		else if (proto == 58) proto = "ICMPv6"
		port = get("DPT")
		k = rule SUBSEP get("IN") get("OUT") SUBSEP get("SRC") SUBSEP get("DST") SUBSEP proto (port == "" ? "" : " " port)
		n[k]++
		last[k] = $1
	}
	END {
		for (k in n) {
			split(k, a, SUBSEP)
			printf "%6d  %s  %-15s %-8s %-15s %-15s %s\n", n[k], shown(last[k]), a[1], a[2], a[3], a[4], a[5]
		}
	}' | sort -k2,3 | table '%6s  %-19s  %-15s %-8s %-15s %-15s %s' times 'last time' rule if from to 'protocol port' | page table
}

service() {
    [ -n "${1:-}" ] || die "which service? maint watchdog usbguard dnscrypt-proxy chrony NetworkManager, or one of 'services'"
    case $1 in *[!A-Za-z0-9_.@-]*) die "not a service name: $1" ;; esac
    since "${2:-}"
    u=${1%.service}.service
    # the session's own, in the user journal
    if systemctl --user cat -- "$u" >/dev/null 2>&1; then
        j --user -u "$u" | fmt | page
        return
    fi
    nogroup
    # chronyd is an alias of chrony
    id=$(systemctl show -p Id --value -- "$u" 2>/dev/null) || id=
    j -u "${id:-$u}" | fmt | page
}

auth() {
    since "${1:-}"
    nogroup
    j SYSLOG_FACILITY=4 SYSLOG_FACILITY=10 | fmt | page
}

panics() {
    [ -d "$PSTORE" ] && [ -n "$(ls -A -- "$PSTORE" 2>/dev/null)" ] || {
        [ -r "$PSTORE" ] || [ ! -e "$PSTORE" ] || die "cannot read $PSTORE: 'doas logs panics'"
        echo "no kernel crash saved"
        return 0
    }
    last=
    for d in "$PSTORE"/*/; do [ -d "$d" ] && last=${d%/}; done
    {
        echo "kernel crashes saved by pstore, the newest shown below:"
        for d in "$PSTORE"/*/; do
            d=${d%/}
            [ -d "$d" ] || continue
            printf '  %s  %s\n' "${d##*/}" "$(cat -- "$d"/* 2>/dev/null |
                grep -m1 -E 'Kernel panic|Oops|BUG|general protection|RIP:' | sed 's/^<[0-9]>//')"
        done
        for f in "$last"/*; do
            [ -f "$f" ] || continue
            printf '\n==> %s\n' "$f"
            cat -- "$f"
        done
    } | page top
}

session() {
    {
        for c in "$SESSION"/core*; do
            [ -f "$c" ] || continue
            echo "core dump: $c ($(used "$c"))"
        done
        j --user -t g0wm | fmt
        # from before the journal
        [ ! -f "$SESSION/g0wm.log" ] || cat -- "$SESSION/g0wm.log"
    } | page
}

used() {
    du -sk -- "$1" 2>/dev/null | awk '{
		if ($1 < 1024) printf "%d KB", $1
		else if ($1 < 1048576) printf "%.1f MB", $1 / 1024
		else printf "%.1f GB", $1 / 1048576
	}'
}

list() {
    nogroup
    printf '  %-12s %s\n' everything 'all of it' kernel 'the kernel log' errors 'errors and worse' \
        daemon 'the system services' user "what $(id -un) runs" debug 'debug messages'
}

status() {
    ok() { printf '  %s✓%s %s\n' "$C_G" "$C_0" "$*"; }
    bad() { printf '  %s!%s %s\n' "$C_Y" "$C_0" "$*"; }
    info() { printf '  %s· %s%s\n' "$C_D" "$*" "$C_0"; }
    sec() { printf '\n%s%s%s\n' "$C_B" "$1" "$C_0"; }
    unit() {
        if systemctl -q is-active -- "$2"; then
            ok "$1"
        else
            bad "$1: $(systemctl is-active -- "$2" 2>/dev/null)"
        fi
    }

    sec Services
    unit "systemd-journald: the journal" systemd-journald.service
    unit "watchdog: notifications" watchdog.service
    unit "earlyoom: closes a program before memory runs out" earlyoom.service
    if reader; then ok "$(id -un) reads the journal"; else bad "$(id -un) is not in the systemd-journal group"; fi

    sec Journal
    if [ -d /var/log/journal ]; then ok "kept on disk in /var/log/journal"; else bad "in RAM only: /var/log/journal is missing"; fi
    if reader; then
        info "$(journalctl --merge --disk-usage 2>/dev/null | sed 's/^Archived and active journals take up //; s/ in the file system.$//') used"
        boots=$(journalctl --merge --list-boots --no-legend --no-pager 2>/dev/null)
        [ -z "$boots" ] || info "goes back to $(printf '%s\n' "$boots" | awk 'NR == 1 { print $4, $5 }'), $(printf '%s\n' "$boots" | grep -c .) boots"
    fi

    sec Crashes
    if ! [ -d /sys/firmware/efi ]; then
        info "no UEFI: kernel panics are not saved"
    elif [ "$(cat /sys/module/efi_pstore/parameters/pstore_disable 2>/dev/null)" = N ]; then
        ok "pstore keeps the kernel log of a panic across the reboot"
    else
        bad "pstore is off: efi_pstore.pstore_disable=0 is missing from the kernel command line"
    fi
    p=$(cat /proc/sys/kernel/panic)
    if [ "$p" -gt 0 ] && [ "$(cat /proc/sys/kernel/panic_on_oops)" = 1 ]; then
        ok "reboots ${p}s after a kernel panic or oops"
    else
        bad "a kernel panic or oops leaves the system frozen (kernel.panic $p)"
    fi
    n=0
    for d in "$PSTORE"/*/; do [ -d "$d" ] && n=$((n + 1)); done
    if [ "$n" -gt 0 ]; then bad "$n kernel crash(es) saved: logs panics"; else ok "no kernel crash saved"; fi
    if [ "$(cat /proc/sys/fs/suid_dumpable)" = 0 ]; then
        ok "no core dumps of programs running with more rights (suid_dumpable 0)"
    else
        bad "setuid programs can leave core dumps (fs.suid_dumpable $(cat /proc/sys/fs/suid_dumpable))"
    fi
    n=0
    for c in "$SESSION"/core*; do [ -f "$c" ] && n=$((n + 1)); done
    [ "$n" = 0 ] || info "$n g0wm core dump(s) in $SESSION: logs session"
    ! hidden || info "some processes are hidden by hidepid: 'doas logs status' sees them"
}

TMP=
trap '[ -z "$TMP" ] || rm -f -- "$TMP"' EXIT
trap 'exit 130' INT HUP TERM

UTC=0 PAGE=1
while [ $# -gt 0 ]; do
    case $1 in
    -u) UTC=1 ;;
    -n) PAGE=0 ;;
    -p) PAGE=2 ;;
    -h | --help | help)
        usage
        exit 0
        ;;
    --)
        shift
        break
        ;;
    -*) die "unknown option $1, see 'logs -h'" ;;
    *) break ;;
    esac
    shift
done
[ -t 1 ] || PAGE=0
if [ "$PAGE" != 0 ]; then
    C_G=$(printf '\033[32m') C_Y=$(printf '\033[33m')
    C_B=$(printf '\033[1m') C_D=$(printf '\033[2m') C_0=$(printf '\033[0m')
    COLOR=1
else
    C_G= C_Y= C_B= C_D= C_0=
    COLOR=0
fi
UTCOPT=
[ "$UTC" = 0 ] || UTCOPT=--utc
SINCE=

cmd=${1:-follow}
[ $# -eq 0 ] || shift
case $cmd in
follow) follow "$@" ;;
show) show "$@" ;;
since)
    [ $# -gt 0 ] || die "since when? 30m 2h 3d boot today or '2026-09-28 14:00'"
    since "$1"
    shift
    show "$@"
    ;;
boot)
    since boot
    show "$@"
    ;;
errors)
    since "${1:-boot}"
    show errors
    ;;
grep)
    [ $# -gt 0 ] || die "grep what?"
    re=$1
    shift
    [ $# -gt 0 ] || set -- everything
    nogroup
    matches "$@"
    # shellcheck disable=SC2086
    j --case-sensitive=false -g "$re" $M | fmt | page
    ;;
around)
    [ $# -gt 0 ] || die "around what?"
    txt=$1
    shift
    [ $# -gt 0 ] || set -- everything
    nogroup
    matches "$@"
    # shellcheck disable=SC2086
    j $M | grep -F -B5 -A20 -- "$txt" | fmt | page
    ;;
service) service "$@" ;;
crashes)
    since "${1:-}"
    pick 'segfault at |traps: |potentially unexpected fatal signal|Out of memory|oom-kill:|Killed process|Oops|BUG: |kernel BUG|general protection fault|Kernel panic|blocked for more than|WARNING: CPU: |soft lockup|hard LOCKUP|self-detected stall|GPU HANG|ring [^ ]+ timeout|GPU reset|Hardware Error|Machine check|EDAC .* error|controller is down|failed command' _TRANSPORT=kernel
    ;;
apparmor)
    since "${1:-}"
    apparmor
    ;;
firewall)
    since "${1:-}"
    firewall
    ;;
usb)
    since "${1:-}"
    pick 'usb [0-9.-]+: (New USB device found|Product: |Manufacturer: |USB disconnect)' _TRANSPORT=kernel
    ;;
auth) auth "$@" ;;
panics) panics ;;
session) session ;;
status) status ;;
list) list ;;
*)
    case " $LOGS " in *" $cmd "*) ;; *) die "unknown command '$cmd', see 'logs -h'" ;; esac
    follow "$cmd" "$@"
    ;;
esac
