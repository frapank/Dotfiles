#!/bin/sh
set -u
umask 022
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
usage() {
    cat <<EOF
Usage: dns-blocklist
Download the blocklist of dnscrypt-proxy again and use it if it is a real
domain list: maint runs it every day.

  -h, --help  show this help

Exit status: 0, 1 if it is not run as root or the download is not a domain
list, 2 if the download failed.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' dns-blocklist "$*" >&2
    else
        printf '%s: %s\n' dns-blocklist "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'dns-blocklist --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'dns-blocklist --help' for more information.\n" >&2
    fi
    exit 2
}

# the output: on a terminal a status label in its color, dimmed headers and
# summaries; plain text in a pipe
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    o_ok=$(printf '\033[32m') o_warn=$(printf '\033[33m') o_fail=$(printf '\033[31m')
    o_dim=$(printf '\033[2m') o_off=$(printf '\033[0m')
else
    o_ok= o_warn= o_fail= o_dim= o_off=
fi

# a status row: ok, warn or fail in its color, or a dimmed info, then the text
row() {
    case $1 in
    ok) printf '  %s%-4s%s  %s\n' "$o_ok" ok "$o_off" "$2" ;;
    warn) printf '  %s%-4s%s  %s\n' "$o_warn" warn "$o_off" "$2" ;;
    fail) printf '  %s%-4s%s  %s\n' "$o_fail" fail "$o_off" "$2" ;;
    *) printf '  %s%-4s  %s%s\n' "$o_dim" info "$2" "$o_off" ;;
    esac
}

# a table header or a summary line, dimmed
dim() { printf '%s%s%s\n' "$o_dim" "$*" "$o_off"; }

URL=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/pro-onlydomains.txt
LIST=/etc/dnscrypt-proxy/blocked-names.txt
MIN=10000

case ${1:-} in
'') ;;
-h | --help)
    help
    exit 0
    ;;
--*) bad "unrecognized option '$1'" ;;
-*) bad "invalid option -- '${1#-}'" ;;
*) bad "extra operand '$1'" ;;
esac
[ "$(id -u)" = 0 ] || {
    err "run as root"
    exit 1
}

tmp=$(mktemp "$LIST.XXXXXX") || exit 1
trap 'rm -f "$tmp"' EXIT

if ! curl -fsS --proto =https --tlsv1.2 --retry 2 --max-time 120 -o "$tmp" "$URL"; then
    err "download failed"
    exit 2
fi
n=$(grep -cvE '^(#|$)' "$tmp")
if [ "$n" -lt "$MIN" ] || grep -vE '^(#|$)' "$tmp" | grep -qvxE '[a-z0-9_.-]+'; then
    err "$URL is not a domain list, $LIST kept"
    exit 1
fi
if cmp -s "$tmp" "$LIST"; then
    dim "Unchanged, $n domains."
    exit 0
fi
chmod 0644 "$tmp"
mv -f "$tmp" "$LIST"
dim "Updated, $n domains."
# the socket stays open: queries wait for the restart
systemctl try-restart dnscrypt-proxy.service >/dev/null 2>&1 || true
