#!/bin/sh
# Drops setuid/setgid from programs not needed with doas, and the file capabilities
# of the ones anyone can run. -n only lists them.
# dpkg-statoverride keeps the modes across updates; apt runs this after each run
# for what a new package brings.
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
usage() {
    cat <<EOF
Usage: nosuid [-n]
Drop setuid and setgid from the programs not needed with doas, and the file
capabilities of the ones anyone can run. dpkg-statoverride keeps the modes
across updates; apt runs it after each run, for what a new package brings.

  -n          only list them, change nothing
  -h, --help  show this help

Exit status: 0, 1 if a mode could not be changed, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' nosuid "$*" >&2
    else
        printf '%s: %s\n' nosuid "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'nosuid --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'nosuid --help' for more information.\n" >&2
    fi
    exit 2
}

LIST='/usr/bin/su /usr/bin/pkexec
/usr/bin/passwd /usr/bin/chsh /usr/bin/chfn /usr/bin/chage /usr/bin/expiry
/usr/bin/gpasswd /usr/bin/newgrp /usr/bin/sg
/usr/bin/mount /usr/bin/umount
/usr/bin/newuidmap /usr/bin/newgidmap
/usr/bin/fusermount
/usr/sbin/pppd
/usr/lib/openssh/ssh-keysign
/usr/bin/wall /usr/bin/write /usr/bin/write.ul
/usr/lib/xorg/Xorg.wrap
/usr/lib/qemu/qemu-bridge-helper /usr/libexec/spice-client-glib-usb-acl-helper
/usr/bin/firejail /usr/libexec/lxc/lxc-user-nic'

# cdrtools: dac_override, sys_admin and sys_rawio on programs with mode 0711
CAPS='/usr/bin/cdrecord /usr/bin/readcd /usr/bin/cdda2wav'

check=0
case ${1:-} in
-n) check=1 ;;
'') ;;
-h | --help)
    help
    exit 0
    ;;
--*) bad "unrecognized option '$1'" ;;
-*) bad "invalid option -- '${1#-}'" ;;
*) bad "extra operand '$1'" ;;
esac
[ $# -le 1 ] || bad "extra operand '$2'"

rc=0
for f in $LIST; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    [ -u "$f" ] || [ -g "$f" ] || continue
    echo "$f"
    [ "$check" = 0 ] || continue
    # shellcheck disable=SC2046
    set -- $(stat -c '%U %G %a' -- "$f")
    # the override replaces one dpkg already has
    dpkg-statoverride --quiet --list "$f" >/dev/null && dpkg-statoverride --quiet --remove "$f"
    dpkg-statoverride --update --add "$1" "$2" "$(printf '%o' $((0$3 & 01777)))" "$f" || rc=1
done
command -v getcap >/dev/null && command -v setcap >/dev/null || exit "$rc"
for f in $CAPS; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    [ -n "$(getcap -- "$f" 2>/dev/null)" ] || continue
    echo "$f"
    [ "$check" = 1 ] || setcap -r "$f" || rc=1
done
exit "$rc"
