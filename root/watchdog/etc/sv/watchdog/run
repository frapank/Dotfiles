#!/bin/sh
# Desktop notifications, sent to whoever runs g0wm, for: crashes, programs
# closed by earlyoom, kernel bugs and lockups, GPU hangs, hardware errors, disk
# and filesystem errors, overheating, USB devices, runit services restarting in
# a loop, low batteries, full disks, microphone and webcam

[ "$1" = pgrp ] || exec chpst -P "$0" pgrp
exec 2>&1

st=/run/watchdog
rm -rf "$st"
mkdir -p "$st"

as_user() { /usr/local/libexec/as-session-user "$@"; }

notify() {
    u=$1 g=$2 app=$3 text=$4
    shift 4
    if [ $# -eq 0 ]; then
        as_user notify-send -u "$u" -a "$g $app" -h "string:desktop-entry:$app" "$text"
    elif [ "$(as_user notify-send -u "$u" -a "$g $app" -h "string:desktop-entry:$app" \
        -A default=Open "$text")" = default ]; then
        as_user foot -- /usr/local/bin/logs -p "$@"
    fi
}

notify_level() {
    as_user notify-send -u "$3" -a "$4 $5" -h "string:desktop-entry:$5" \
        -h "string:x-dunst-stack-tag:$1" -h "int:value:$2" "$6"
}

svloop() {
    case $(as_user notify-send -u critical -a " $1" -h "string:desktop-entry:$1" \
        -A default=Log -A stop=Stop "restarting in a loop") in
    default) as_user foot -- /usr/local/bin/logs -p service "$1" ;;
    stop) sv down "/var/service/$1" ;;
    esac
}

once() { [ ! -e "$st/$1" ] && : >"$st/$1"; }
reset() { rm -f "$st/$1"; }
every() {
    now=$(date +%s)
    t=$(cat "$st/$1" 2>/dev/null) || t=0
    [ $((now - t)) -ge "$2" ] && echo "$now" >"$st/$1"
}

kernel() {
    stdbuf -oL dmesg -W -k --color=never 2>/dev/null | while IFS= read -r line; do
        msg=${line#*] } raw=$msg u=normal icon=
        case $msg in
        *"segfault at"*) prog=${msg%%\[*} why="segmentation fault" last=$prog ;;
        traps:*)
            msg=${msg#traps: }
            prog=${msg%%\[*} why=${msg#*] } why=${why%% ip*} last=$prog
            ;;
        *"potentially unexpected fatal signal"*)
            prog=${msg%%: potentially*} prog=${prog##*: }
            [ "$prog" = "$last" ] && {
                last=
                continue
            }
            sig=${msg##*signal } sig=${sig%.}
            case $sig in
            11) why="segmentation fault" ;;
            *) why="SIG$(kill -l "$sig")" ;;
            esac
            ;;
        *"Killed process"*) prog=${msg#*\(} prog=${prog%%\)*} why="out of memory" ;;
        *"I/O error"*)
            every disk 60 || continue
            dev=${msg#*dev } dev=${dev%%,*}
            prog=Disk why="I/O error on $dev" u=critical icon=
            ;;
        "BTRFS error"* | "BTRFS critical"* | *"csum failed"* | "EXT4-fs error"*)
            every disk 60 || continue
            dev=${msg#*(device } dev=${dev%%)*}
            prog=Disk why="filesystem error on $dev" u=critical icon=
            ;;
        *"temperature above threshold"* | *"critical temperature reached"*)
            every thermal 60 || continue
            prog=CPU why="overheating, throttled" icon=
            case $msg in *critical*) why="critical temperature" u=critical ;; esac
            ;;
        "usb "*": Product: "*)
            port=${msg#usb } port=${port%%:*}
            echo "${msg#*Product: }" >"$st/usb.$port"
            prog=USB why="$(cat "$st/usb.$port") connected" u=low icon=
            ;;
        "usb "*": USB disconnect"*)
            port=${msg#usb } port=${port%%:*}
            name=$(cat "$st/usb.$port" 2>/dev/null) || name="device on $port"
            rm -f "$st/usb.$port"
            prog=USB why="$name disconnected" u=low icon=
            ;;
        *'apparmor="DENIED"'*)
            prog=${msg#*profile=\"} prog=${prog%%\"*}
            every "aa.$(printf %s "$prog" | tr -c 'A-Za-z0-9._-' _)" 30 || continue
            why=${msg#*operation=\"} why="AppArmor blocked ${why%%\"*}" icon=
            case $msg in
            *' name="'*) name=${msg#* name=\"} why="$why ${name%%\"*}" ;;
            *' capname="'*) name=${msg#* capname=\"} why="$why ${name%%\"*}" ;;
            esac
            ;;
        "usb "*"error -"* | "usb "*"unable to enumerate"*)
            every usberr 60 || continue
            port=${msg#usb } port=${port%%:*}
            prog=USB why="errors on $port" icon=
            ;;
        *"soft lockup"* | *"hard LOCKUP"* | *"self-detected stall"* | *"detected stalls on CPU"*)
            every lockup 60 || continue
            prog=Kernel why="a CPU is stuck, the system may freeze" u=critical
            ;;
        "INFO: task "*" blocked for more than "*)
            every hung 60 || continue
            prog=${msg#INFO: task } prog=${prog% blocked for*} prog=${prog%:*}
            why=${msg#*more than } why="stuck for over ${why%% *}s, waiting on a disk or a driver"
            ;;
        "BUG: "* | "Oops"* | *"kernel BUG at"* | "general protection fault"* | *"Unable to handle kernel"*)
            every bug 60 || continue
            prog=Kernel why=$(printf %s "$msg" | cut -c1-80) u=critical
            ;;
        "WARNING: CPU: "*)
            every warning 300 || continue
            prog=Kernel why="warning in $(printf %s "$msg" | sed -n 's/.* at \([^ ]*\).*/\1/p')"
            ;;
        *"GPU HANG"* | *"Resetting chip for"* | *"ring "*" timeout"* | *"GPU reset begin"* | *"Timedout job"* | "nouveau "*" fault"* | "nouveau "*"fifo: "* | "nouveau "*" killed"*)
            every gpu 60 || continue
            prog=GPU why="hung, the driver is resetting it" u=critical icon=
            ;;
        *"Hardware Error"* | *"Machine check events logged"* | "EDAC "*" error"*)
            every hwerr 60 || continue
            prog=Hardware why="the CPU or the RAM reported an error, it may be failing" u=critical icon=
            ;;
        "nvme "*" timeout"* | *"controller is down"* | "ata"*"failed command"* | "ata"*"hard resetting link"*)
            every disk 60 || continue
            dev=${msg%%: *} dev=${dev##* }
            prog=Disk why="$dev not answering, the kernel is resetting it" u=critical icon=
            ;;
        *) continue ;;
        esac
        notify "$u" "$icon" "$prog" "$why" around "$raw" kernel &
    done
}

services() {
    sv status /var/service/* 2>/dev/null |
        sed -nE 's|^([a-z]+): /var/service/([^:]+): (\(pid ([0-9]+)\) )?([0-9]+)s.*|\2 \1\4 \5|p' |
        while read -r s pid up; do
            read -r old n 2>/dev/null <"$st/sv.$s" || { old=$pid n=0; }
            [ "$pid" != "$old" ] && n=$((n + 1))
            [ "$up" -ge 60 ] && n=0
            echo "$pid $n" >"$st/sv.$s"
            if [ "$n" -ge 3 ]; then
                if once "svloop.$s"; then svloop "$s" & fi
            elif [ "$n" -eq 0 ]; then
                reset "svloop.$s"
            fi
        done
}

batteries() {
    for b in /sys/class/power_supply/*; do
        [ "$(cat "$b/type" 2>/dev/null)" = Battery ] || continue
        read -r cap 2>/dev/null <"$b/capacity" || continue
        k=bat.${b##*/}
        case $(cat "$b/status" 2>/dev/null) in

        Charging | Full | "Not charging")
            reset "$k.20"
            reset "$k.10"
            continue
            ;;
        esac

        name=Battery
        [ "$(cat "$b/scope" 2>/dev/null)" = Device ] && name=$(cat "$b/model_name")
        if [ "$cap" -le 10 ]; then
            once "$k.20"
            once "$k.10" && notify_level "$k" "$cap" critical  "$name" "battery at $cap%"
        elif [ "$cap" -le 20 ]; then
            once "$k.20" && notify_level "$k" "$cap" normal  "$name" "battery at $cap%"
        fi
    done
}

disks() {
    df -P 2>/dev/null | awk '$1 ~ "^/dev/" && !seen[$1]++ { print $5 + 0, $6 }' |
        while read -r pct mnt; do
            k=df.$(echo "$mnt" | tr / _)
            if [ "$pct" -ge 90 ]; then
                once "$k" && notify_level "$k" "$pct" normal  Disk "$mnt $pct% full"
            else
                reset "$k"
            fi
        done
}

mic() {
    if grep -qs RUNNING /proc/asound/card*/pcm*c/sub*/status; then
        once mic || return 0
        apps=$(as_user pactl list source-outputs |
            sed -n 's/^[[:space:]]*application.name = "\(.*\)"$/\1/p' | sort -u | paste -sd, -)
        notify normal  Microphone "in use${apps:+ by $apps}"
    else
        reset mic
    fi
}

webcam() {
    pids=$(fuser /dev/video* 2>/dev/null)
    if [ -n "$pids" ]; then
        once cam || return 0
        # shellcheck disable=SC2086
        apps=$(ps -o comm= -p "$(echo $pids | tr ' ' ,)" | sort -u | paste -sd, -)
        notify normal  Webcam "in use by $apps"
    else
        reset cam
    fi
}

# earlyoom-closed leaves oom.PID files with the program name
earlyoom() {
    for f in "$st"/oom.*; do
        case $f in *.tmp) continue ;; esac
        [ -f "$f" ] || continue
        name=$(cat "$f")
        rm -f "$f"
        notify critical  "${name:-a program}" "out of memory, closed by earlyoom" service earlyoom &
    done
}

pstore() {
    [ -e /run/pstore-new ] || return 0
    as_user true || return 0
    notify critical  Kernel "crashed during the last boot, click to see why" panics &
    rm -f /run/pstore-new
}

poll() {
    while :; do
        pstore
        earlyoom
        services
        batteries
        disks
        mic
        webcam
        sleep 5
    done
}

trap 'trap - TERM; kill 0' TERM
# dmesg -W can end: read the kernel again rather than go silent
while :; do
    kernel
    sleep 5
done &
poll &
wait
