[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# not gtk3: its widget palettes override Kvantum's
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=kvantum

if [ -n "${XDG_RUNTIME_DIR:-}" ] && command -v ssh-agent >/dev/null 2>&1; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
    if [ ! -x "$HOME/.config/sv/ssh-agent/run" ]; then
        ssh-add -l >/dev/null 2>&1
        if [ $? -eq 2 ]; then
            rm -f "$SSH_AUTH_SOCK"
            ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null
        fi
    fi
fi

# start g0wm at the first prompt so the rest of ~/.bash_profile runs first
if [ "$(tty)" = /dev/tty1 ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    __start_g0wm() {
        PROMPT_COMMAND=${PROMPT_COMMAND#__start_g0wm; }
        unset -f __start_g0wm
        if [ -x "$HOME/.config/sv/pipewire/run" ]; then
            export G0WM_AUDIO=0
        fi
        if command -v start-g0wm >/dev/null 2>&1; then
            exec start-g0wm
        fi
    }
    PROMPT_COMMAND="__start_g0wm; ${PROMPT_COMMAND:-}"
fi
