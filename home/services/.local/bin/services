#!/bin/sh
set -u

UNITS=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
RUN=${XDG_RUNTIME_DIR:-}
# Debian's own units, started with the session
SYSTEM='pipewire pipewire-pulse wireplumber ssh-agent'
ENV='WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP'

usage() {
    cat <<EOF
Usage: services [COMMAND [NAME...]]
The programs of the g0wm session, kept running by systemd: they start with
g0wm, come back if they crash and stop when g0wm quits. Each one is a user
unit in ~/.config/systemd/user; $(echo "$SYSTEM" | sed 's/ \([^ ]*\)$/ and \1/')
are the units of Debian.

  status [NAME]     what runs now and what starts at login (default);
                    with NAME: exit 0 if it runs, 3 if it does not
  start NAME...     start it now, for this session only
  stop NAME...      stop it now, for this session only
  restart NAME...   stop it and start it again (after editing its unit)
  enable NAME...    start it now and at every login
  disable NAME...   stop it now and no longer at login
  log NAME          what it printed, the same as 'logs service NAME'
  session           start them and stop them when g0wm quits: g0wm autostart runs it
  failed NAME       tell that NAME gave up: its units run it
EOF
}

die() {
    printf 'services: %s\n' "$*" >&2
    [ -t 2 ] || notify-send -a " services" "$*" 2>/dev/null
    exit 1
}

sc() { systemctl --user "$@"; }

# the units of g0wm-session.target, then Debian's
names() {
    for f in "$UNITS"/*.service; do
        [ -f "$f" ] && grep -qx 'WantedBy=g0wm-session.target' "$f" || continue
        f=${f##*/}
        echo "${f%.service}"
    done
    # shellcheck disable=SC2086
    printf '%s\n' $SYSTEM
}

check_name() {
    case $1 in '' | .* | */* | *@*) die "no service named '$1': $(names | tr '\n' ' ')" ;; esac
    names | grep -qxF -- "$1" || die "no service named '$1': $(names | tr '\n' ' ')"
}

desc() { sc show -p Description --value -- "$1.service" 2>/dev/null; }

at_login() {
    case $(sc is-enabled -- "$1.service" 2>/dev/null) in
    enabled) echo on ;;
    static | indirect | alias) echo with Debian ;;
    *) echo off ;;
    esac
}

running() { [ -n "$RUN" ] && sc -q is-active g0wm-session.target; }

age() {
    if [ "$1" -lt 60 ]; then
        echo "${1}s"
    elif [ "$1" -lt 3600 ]; then
        echo "$(($1 / 60))m"
    elif [ "$1" -lt 86400 ]; then
        echo "$(($1 / 3600))h"
    else
        echo "$(($1 / 86400))d"
    fi
}

now() {
    case $(sc is-active -- "$1.service" 2>/dev/null) in
    active)
        t=$(sc show -p ActiveEnterTimestampMonotonic --value -- "$1.service" 2>/dev/null)
        up=$(cut -d. -f1 /proc/uptime)
        case $t in '' | 0 | *[!0-9]*) echo run ;; *) echo "run $(age $((up - t / 1000000)))" ;; esac
        ;;
    failed) echo failed ;;
    activating) echo starting ;;
    *) echo - ;;
    esac
}

ctl() {
    c=$1
    shift
    [ $# -gt 0 ] || die "which one? $(names | tr '\n' ' ')"
    for n; do check_name "$n"; done
    rc=0
    for n; do
        sc "$c" -- "$n.service" || rc=1
    done
    return "$rc"
}

toggle() {
    on=$1
    shift
    [ $# -gt 0 ] || die "which one? $(names | tr '\n' ' ')"
    for n; do
        check_name "$n"
        case " $SYSTEM " in *" $n "*) die "$n comes with Debian, it starts with the session: 'services stop $n' stops it for now" ;; esac
    done
    now=
    running && now=--now
    rc=0
    # shellcheck disable=SC2086
    for n; do
        if [ "$on" = 1 ]; then
            sc enable $now -- "$n.service" || rc=1
        else
            sc disable $now -- "$n.service" || rc=1
        fi
    done
    [ -n "$now" ] || echo "saved for the next login: the session is not running"
    return "$rc"
}

status() {
    if [ $# -gt 0 ]; then
        check_name "$1"
        sc -q is-active -- "$1.service" && return 0
        return 3
    fi
    w=7
    for n in $(names); do [ "${#n}" -le "$w" ] || w=${#n}; done
    printf '%-*s  %-9s %-11s %s\n' "$w" SERVICE NOW 'AT LOGIN' WHAT
    for n in $(names); do
        printf '%-*s  %-9s %-11s %s\n' "$w" "$n" "$(now "$n")" "$(at_login "$n")" "$(desc "$n")"
    done
    running || printf '\nthe session is not running: g0wm starts it with %s\n' "'services session'"
    return 0
}

log() {
    [ $# -eq 1 ] || die "the log of which one? $(names | tr '\n' ' ')"
    check_name "$1"
    if command -v logs >/dev/null 2>&1; then
        [ -t 1 ] && exec logs -p service "$1"
        exec logs -n service "$1"
    fi
    exec journalctl --user -u "$1.service"
}

# OnFailure: systemd gave up restarting it
failed() {
    n=${1%.service}
    check_name "$n"
    case $(notify-send -a " services" -u critical -A default=Open -A restart=Restart \
        "$n failed" "It kept exiting right after it started: click to see what it printed" 2>/dev/null) in
    # foot's AppArmor profile runs nothing from ~
    default) exec foot -- sh "$self" log "$n" ;;
    restart)
        sc reset-failed -- "$n.service"
        exec "$self" start "$n"
        ;;
    esac
}

find_g0wm() {
    p=$$
    while [ "$p" -gt 1 ] 2>/dev/null; do
        [ "$(cat "/proc/$p/comm" 2>/dev/null)" = g0wm ] && {
            g0wm=$p
            return 0
        }
        p=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | cut -d' ' -f2) || return 1
    done
    g0wm=$(pgrep -u "$(id -u)" -xo g0wm)
}

g0wm_alive() { [ "$(cat "/proc/$g0wm/comm" 2>/dev/null)" = g0wm ]; }

# graphical-session.target goes with it: what is PartOf it stops too
stop_all() {
    trap - TERM INT HUP
    [ -z "${slp:-}" ] || kill "$slp" 2>/dev/null
    sc stop g0wm-session.target graphical-session.target
    # shellcheck disable=SC2086
    sc unset-environment $ENV
}

session() {
    [ -n "$RUN" ] && [ -d "$RUN" ] || die "XDG_RUNTIME_DIR is not set"
    [ -n "${WAYLAND_DISPLAY:-}" ] || die "not inside a graphical session"
    sc show-environment >/dev/null 2>&1 || die "no systemd user manager: is dbus-user-session installed?"
    find_g0wm || die "g0wm is not running"
    slp=
    exec 9>"$RUN/services.lock"
    # an old session stops within 2 seconds once its g0wm is gone
    flock -w 8 9 || die "already started by another 'services session': 'services' shows them"
    trap 'stop_all; exit 0' TERM INT HUP
    rm -f -- "$RUN/awake"
    # the services and the D-Bus activated programs (portals) find the compositor
    # shellcheck disable=SC2086
    dbus-update-activation-environment --systemd $ENV 2>/dev/null || sc import-environment $ENV
    sc start g0wm-session.target || die "g0wm-session.target did not start: 'services'"
    while g0wm_alive; do
        sleep 2 &
        slp=$!
        wait "$slp"
        slp=
    done
    stop_all
}

self=$(command -v "$0") || self=$0
case ${1:-status} in
-h | --help | help)
    usage
    exit 0
    ;;
esac
cmd=${1:-status}
[ $# -eq 0 ] || shift
case $cmd in
status) status "$@" ;;
start) ctl start "$@" ;;
stop) ctl stop "$@" ;;
restart) ctl restart "$@" ;;
enable) toggle 1 "$@" ;;
disable) toggle 0 "$@" ;;
log) log "$@" ;;
session) session ;;
failed)
    [ $# -eq 1 ] || die "failed what?"
    failed "$1"
    ;;
*)
    echo "services: unknown command '$cmd'" >&2
    echo "Try 'services --help' for more information." >&2
    exit 2
    ;;
esac
