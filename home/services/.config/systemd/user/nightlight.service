[Unit]
Description=warmer colors from 18:00 to 06:00
PartOf=graphical-session.target
After=graphical-session.target
# systemd gives up after 4 exits in 30 seconds, services tells it
OnFailure=services-failed@%n.service
StartLimitIntervalSec=30
StartLimitBurst=4

[Service]
ExecStart=%h/.config/services/nightlight/run
ExecStopPost=%h/.config/services/nightlight/finish
Restart=always
RestartSec=1

[Install]
WantedBy=g0wm-session.target
