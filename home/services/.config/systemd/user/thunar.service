[Unit]
Description=Thunar in the background, mounts drives when plugged in
PartOf=graphical-session.target
After=graphical-session.target
# systemd gives up after 4 exits in 30 seconds, services tells it
OnFailure=services-failed@%n.service
StartLimitIntervalSec=30
StartLimitBurst=4

[Service]
ExecStart=%h/.config/services/thunar/run
Restart=always
RestartSec=1

[Install]
WantedBy=g0wm-session.target
