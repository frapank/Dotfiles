[Unit]
Description=ask for the password when an app needs more rights
PartOf=graphical-session.target
After=graphical-session.target
# systemd gives up after 4 exits in 30 seconds, services tells it
OnFailure=services-failed@%n.service
StartLimitIntervalSec=30
StartLimitBurst=4

[Service]
ExecStart=%h/.config/services/polkit/run
Restart=always
RestartSec=1

[Install]
WantedBy=g0wm-session.target
