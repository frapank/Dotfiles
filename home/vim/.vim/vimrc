vim9script

# CORE SETTINGS
set hlsearch incsearch ignorecase smartcase
set clipboard=exclude:.*
set wildignore+=*.exe,*.dll,*.pdb,*.class,*.o,*.d
set wildignore+=*/.git/*,*/node_modules/*,*/dist/*,*/build/*,*/target/*
set wildignorecase
set grepformat=%f:%l:%m
set splitbelow splitright
set shortmess+=IcC
set ttimeout ttimeoutlen=25
set updatetime=300
set hidden confirm lazyredraw
set tabstop=4 shiftwidth=4 expandtab
set smartindent
set fileformats=unix,dos
set nrformats=bin,hex,unsigned
set virtualedit=block nostartofline
set tags=./tags;,tags;
filetype plugin indent on

# PERSISTENT UNDO
if !isdirectory($HOME .. '/.vim/undo')
    mkdir($HOME .. '/.vim/undo', 'p', 0o700)
endif
set undofile undodir=~/.vim/undo

# no history, undo or swap for temporary files
set viminfo+=r/tmp,r/dev/shm,r/run
autocmd BufReadPre,BufNewFile /tmp/*,/dev/shm/*,/run/* setlocal noundofile noswapfile

# WRAPPING & SCROLLING
set nowrap
set linebreak
set display=lastline
set scrolloff=4
set sidescroll=1 sidescrolloff=5

# UI & COLORS
if has('termguicolors')
    set termguicolors
endif
syntax on
try
    colorscheme dot
catch
    colorscheme habamax
endtry
set listchars=tab:·\ ,trail:·,nbsp:␣
set laststatus=2
set nojoinspaces

# COMPLETION
set completeopt=menu,popup
set complete=.,w,b,u,t

# STATUSLINE
augroup VrcStatusline
    autocmd!
    autocmd DirChanged * g:cwd_tail = fnamemodify(getcwd(), ':t')
augroup END
g:cwd_tail = fnamemodify(getcwd(), ':t')
set statusline=%#StatusLine#\ %f\ %m%r%=%{g:cwd_tail}\ %L\ %l:%c\ 

# KEYMAPS
g:mapleader = ' '

nnoremap <leader>e          :e<Space>
nnoremap <leader>d          :cd<Space>
nnoremap <leader>g          :grep<Space>
nnoremap <silent> <leader>q :copen<CR>
nnoremap <silent> <leader>n :cnext<CR>
nnoremap <silent> <leader>p :cprev<CR>
nnoremap <silent> <leader>t :Sex<CR>
nnoremap <silent> <Tab>     :bnext<CR>
nnoremap <silent> <S-Tab>   :bprevious<CR>
nnoremap <silent> <leader>m :make<CR>
nnoremap <silent> <leader>/ :nohlsearch<CR>

# FUZZY FINDER
# Debian's fzf ships its vim plugin only among the examples
const fzf_examples = '/usr/share/doc/fzf/examples'
if filereadable(fzf_examples .. '/plugin/fzf.vim')
    &runtimepath ..= ',' .. fzf_examples
endif

def Fzf(spec: dict<any>)
    fzf#run(fzf#wrap(spec))
enddef

# Open buffers but the current one
def FzfBuffers()
    var bufs: list<string>
    for b in getbufinfo({buflisted: 1})
        if b.bufnr != bufnr()
            add(bufs, b.bufnr .. "\t" .. (empty(b.name) ? '[No Name]' : fnamemodify(b.name, ':~:.')))
        endif
    endfor
    Fzf({
        source: bufs,
        options: ['--prompt', 'buffers> ', '--delimiter', "\t", '--with-nth', '2'],
        sink: (line) => execute('buffer ' .. matchstr(line, '^\d\+')),
    })
enddef

# Live grep: rg runs again at every key
const rg = "rg --column --line-number --no-heading --color=always --smart-case --glob '!.git/*' -- "
def FzfGrep()
    Fzf({
        source: rg .. "''",
        options: [
            '--prompt', 'rg> ', '--ansi', '--disabled',
            '--delimiter', ':',
            '--bind', 'change:reload:' .. rg .. '{q} || true',
            '--preview', 'bat -p --color=always --highlight-line {2} {1} 2>/dev/null || cat {1}',
            '--preview-window', '+{2}-/2',
        ],
        sink: (line) => GrepOpen(line),
    })
enddef

def GrepOpen(line: string)
    var m = matchlist(line, '^\(.\{-}\):\(\d\+\):\(\d\+\):')
    if empty(m)
        return
    endif
    execute 'edit ' .. fnameescape(m[1])
    cursor(str2nr(m[2]), str2nr(m[3]))
enddef

if executable('fzf') && !empty(globpath(&runtimepath, 'plugin/fzf.vim'))
    if executable('fd')
        $FZF_DEFAULT_COMMAND = 'fd --type f --exclude build --exclude .git'
    else
        $FZF_DEFAULT_COMMAND = 'find . \( -path "*/build/*" -o -path "*/.git/*" \) -prune -o -type f -print'
    endif
    nnoremap <leader>f :FZF<CR>
    nnoremap <silent> <leader>b <ScriptCmd>FzfBuffers()<CR>
    if executable('rg')
        nnoremap <silent> <leader>s <ScriptCmd>FzfGrep()<CR>
    endif
else
    set path=.,**
    nnoremap <leader>f :find<Space>
endif

# SEARCH / GREP TOOLS
if executable('rg')
    &grepprg = 'rg --vimgrep --no-heading --smart-case'
    &grepformat = '%f:%l:%c:%m,%f:%l:%m'
elseif executable('grep')
    &grepprg = 'grep -n -R -I -E --exclude-dir=.git'
    &grepformat = '%f:%l:%m'
endif

# DEBUGGER
def LoadTermdebug(args: string)
    packadd termdebug
    execute 'Termdebug ' .. args
enddef
command! -nargs=* -complete=file Debug LoadTermdebug(<q-args>)
