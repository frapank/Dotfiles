# ~/.gitconfig is read after and wins

# diffs by word with line numbers, n and N jump between files
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    syntax-theme = ansi
    file-style = blue bold
    hunk-header-style = omit
    minus-style = red
    plus-style = green

[diff]
    colorMoved = default
    algorithm = histogram
[merge]
    conflictStyle = zdiff3
