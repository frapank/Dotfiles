[%General]
author=frapank
comment=G0wm, drawn by script/g0wm-theme.py
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=4
spread_progressbar=true
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
menu_separator_height=9
splitter_width=1
scroll_width=8
scroll_arrows=false
scroll_min_extent=48
slider_width=4
slider_handle_width=16
slider_handle_length=16
center_toolbar_handle=true
check_size=16
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=1
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
spin_button_width=28
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
combo_as_lineedit=true
animate_states=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=false
joined_inactive_tabs=false
layout_spacing=6
layout_margin=9
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=true
submenu_overlap=0
tooltip_delay=-1
tree_branch_line=false
no_inactiveness=true
no_window_pattern=true
reduce_window_opacity=0
reduce_menu_opacity=0
respect_DE=true

[GeneralColors]
window.color=#0a0a0a
base.color=#0a0a0a
alt.base.color=#0a0a0a
button.color=#0a0a0a
light.color=#2a2a2a
mid.light.color=#1c1c1c
dark.color=#000000
mid.color=#121212
shadow.color=#000000
highlight.color=#e0a86a
inactive.highlight.color=#e0a86a
text.color=#e9e9e9
window.text.color=#e9e9e9
button.text.color=#e9e9e9
disabled.text.color=#555555
tooltip.base.color=#0e0e0e
tooltip.text.color=#e9e9e9
highlight.text.color=#0a0a0a
link.color=#8ab0c6
link.visited.color=#c59dc8
progress.indicator.text.color=#e9e9e9

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
blur_translucent=false
transparent_menutitle=true
respect_darkness=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=50
lxqtmainmenu_iconsize=16
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_view=false
no_selection_tint=true
transparent_arrow_button=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=16
interior=true
interior.element=button
indicator.size=12
indicator.element=arrow
text.normal.color=#e9e9e9
text.focus.color=#e9e9e9
text.press.color=#e9e9e9
text.toggle.color=#e9e9e9
text.shadow=0
text.margin=1
text.iconspacing=6
text.margin.top=3
text.margin.bottom=3
text.margin.left=8
text.margin.right=8
min_width=+0.3font
min_height=+0.6font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.normal.color=#8a8a8a
text.focus.color=#e9e9e9
text.margin.left=4
text.margin.right=4

[ToolboxTab]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.normal.color=#8a8a8a

[Dock]
inherits=PanelButtonCommand
frame.element=dock
interior.element=dock
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=0

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#8a8a8a
text.focus.color=#e9e9e9
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=spin
interior.element=spin
indicator.element=spin
indicator.size=12
text.margin.left=0
text.margin.right=0
text.normal.color=#8a8a8a
text.focus.color=#e9e9e9

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.margin.left=4
text.margin.right=4

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.margin.left=4
text.margin.right=4

[Focus]
inherits=PanelButtonCommand
frame=false
frame.element=focus
interior=false
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.expansion=16
frame.patternsize=0

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
indicator.element=carrow
text.margin.left=6
text.margin.right=6

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=carrow
text.margin.left=2
text.margin.right=4

[IndicatorArrow]
indicator.element=arrow
indicator.size=12

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=16
text.margin.left=10
text.margin.right=10
text.margin.top=3
text.margin.bottom=3
text.normal.color=#8a8a8a
text.focus.color=#e9e9e9
text.toggle.color=#e9e9e9

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=0

[TabBarFrame]
inherits=GenericFrame
frame=true
