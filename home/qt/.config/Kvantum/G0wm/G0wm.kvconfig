[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0
text.normal.color=#8a8a8a
text.focus.color=#e9e9e9
text.toggle.color=#e9e9e9

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=toolbar
frame.element=toolbar
indicator.element=toolbar
indicator.size=8
text.margin=0
frame.expansion=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=48

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=48
text.margin=0
text.normal.color=#e9e9e9
text.focus.color=#e9e9e9
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=48

[ItemView]
inherits=PanelButtonCommand
