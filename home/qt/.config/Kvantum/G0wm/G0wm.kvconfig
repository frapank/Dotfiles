frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.normal.color=#e9e9e9
text.focus.color=#e9e9e9
text.press.color=#e9e9e9
text.toggle.color=#e9e9e9
min_height=+0.4font

[Splitter]
indicator.size=0

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=10

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=false
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
