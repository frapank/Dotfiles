indicator.element=grip
indicator.size=0

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=0
text.margin.top=1
text.margin.bottom=1
text.margin.left=6
text.margin.right=6
text.normal.color=#e9e9e9
text.focus.color=#e9e9e9
text.press.color=#e9e9e9
text.toggle.color=#e9e9e9
min_height=+0.6font

[MenuBar]
inherits=PanelButtonCommand
