# a setting left out keeps its default, one with no value is off

look {
    fonts "Geist Mono:size=11" "Symbols Nerd Font:size=12"
    colors {
        # fg bg border
        norm #8a8a8aff #0a0a0aff #0a0a0aff
        sel #e9e9e9ff #0a0a0aff #0a0a0aff
        urg #e0a86aff #0a0a0aff #e0a86aff
        title #8a8a8aff #0a0a0aff #0a0a0aff
        titlesel #e9e9e9ff #0a0a0aff #0a0a0aff
        status #8a8a8aff #0a0a0aff #0a0a0aff
        notify #e9e9e9ff #0a0a0aff #e0a86aff
        notifylow #e9e9e9ff #0a0a0aff #93c2a0ff
        notifycrit #e9e9e9ff #0a0a0aff #d8625eff
        runner #e9e9e9ff #0a0a0aff #0a0a0aff
        runnersuggest #8a8a8aff #0a0a0aff #0a0a0aff
        runnersel #0a0a0aff #e9e9e9ff #e9e9e9ff
        runnericon #e9e9e9ff #333333ff #555555ff
    }
    rootcolor #191919ff
    fullscreen_bg #0a0a0aff
    # empty for none
    wallpaper @HOME@/.config/g0wm/wallpaper.svg
    # up to 31
    tags 1 2 3 4 5 6
}

windows {
    borderpx 3
    # normal or squircle
    cornerstyle squircle
    cornerpx 12
    gaps 2
    gappx 2
    titlepadding 8
    alwaysprivate false
    privatetitle "G0wm is hiding this window"
    # the close button, and the dots of private and public windows
    titleclosecolor #d8625eff
    privatecolor #cba6ceff
    publiccolor #88bcdbff
}

# what screen sharing shows instead of a private window
private {
    text "G0wm is hiding this window"
    # the logo of g0wm, twice the default size
    image @HOME@/.config/g0wm/private.png
    imagesize 128
    color #0a0a0aff
    textcolor #8a8a8aff
}

bar {
    barpadding 4
    # times the font height, 0 for automatic
    barheight 1.5
    # same corner as the bar: cornerpx 12 on a ~30px tall bar is 0.8 of its
    # half height, the dots get that share of theirs
    bartagdotround 0.6
    runner_pillheight 1
    runner_pillpadding 1
    # the dot of the notifications, the colors of private and public windows
    notification_privatecolor #cba6ceff
    notification_publiccolor #88bcdbff
    # a hidden notification is left out of screen sharing, with no placeholder
    notification_privatehide true
    notification_actionsign 
}

opacity {
    opacity_enabled false
    opacity_focus 0.82
    opacity_unfocus 0.82
    # normal or blur
    opacity_type blur
}

input {
    # keys per second, and milliseconds before a held key repeats
    repeat_rate 40
    repeat_delay 300
    cursor_theme Bibata-Modern-Classic
    cursor_size 20
    # none, flat or adaptive, speed from -1 to 1
    accel_profile flat
    # the same three, for touchpads
    touchpad_natural_scrolling true
}

# layout: symbol, then tile or tabbed
layout "[ ]" tile
layout "| |" tabbed

# rule: id and title match any part of them
# the volume, opened from the bar for a moment: floating
rule {
    id pavucontrol
    isfloating true
}
# the password prompt of polkit: floating, and never in screen sharing
rule {
    id polkit-mate
    isfloating true
    private true
}

# monitor: the first matching name wins
@MONITOR@

# autostart: a command, run without a shell
autostart dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
autostart gnome-keyring-daemon --start --components=secrets
autostart services session
autostart logins --notify

# key: modifiers+key, action, argument
key logo+q spawn foot
key logo+f spawn thunar
key logo+b spawn librewolf
key Print spawn screenshot
key shift+Print spawn screenshot screen
key ctrl+Print spawn screenshot edit
key logo+Print spawn record
key logo+shift+Print spawn record region
key logo+ctrl+Print spawn record --no-audio
key logo+equal spawn nightlight
key logo+minus spawn awake
key logo+n notifyscroll
key logo+shift+n notifyopen
key logo+ctrl+n notifynext
key logo+alt+n notifyprev
key logo+ctrl+shift+n notifydismissall
key logo+a notifyactions
key logo+c killclient
key logo+v togglefloating
key logo+shift+p toggleprivate
key logo+shift+g togglegaps
key logo+shift+t toggletitlebar
key logo+t toggletabbed "| |"
key logo+shift+f togglefullscreen
key logo+shift+r reloadsettings
key logo+r runnertoggle
key logo+h focusstack -1
key logo+j focusstack 1
key logo+k focusstack -1
key logo+l focusstack 1
key logo+shift+h movestack -1
key logo+shift+j movestack 1
key logo+shift+k movestack -1
key logo+shift+l movestack 1
key logo+ctrl+h resizewidth -50
key logo+ctrl+l resizewidth 50
key logo+ctrl+k resizeheight -50
key logo+ctrl+j resizeheight 50
key XF86PowerOff spawn power
key XF86AudioRaiseVolume spawn osd volume up
key XF86AudioLowerVolume spawn osd volume down
key XF86AudioMute spawn osd volume mute
key XF86AudioMicMute spawn osd mic mute
key XF86MonBrightnessUp spawn osd brightness up
key XF86MonBrightnessDown spawn osd brightness down
key XF86AudioNext spawn osd media next
key XF86AudioPause spawn osd media play
key XF86AudioPlay spawn osd media play
key XF86AudioPrev spawn osd media prev
key logo+Return zoom
key logo+space setlayout
key logo+comma focusmon 4
key logo+period focusmon 8
key logo+shift+less tagmon 4
key logo+shift+greater tagmon 8
key logo+1 view 1
key logo+shift+exclam tag 1
key logo+2 view 2
key logo+shift+at tag 2
key logo+3 view 4
key logo+shift+numbersign tag 4
key logo+4 view 8
key logo+shift+dollar tag 8
key logo+5 view 16
key logo+shift+percent tag 16
key logo+6 view 32
key logo+shift+asciicircum tag 32
key logo+shift+Escape quit
key logo+Escape toggleinhibit
key ctrl+alt+Terminate_Server quit
key ctrl+alt+XF86Switch_VT_1 chvt 1
key ctrl+alt+XF86Switch_VT_2 chvt 2
key ctrl+alt+XF86Switch_VT_3 chvt 3
key ctrl+alt+XF86Switch_VT_4 chvt 4
key ctrl+alt+XF86Switch_VT_5 chvt 5
key ctrl+alt+XF86Switch_VT_6 chvt 6
key ctrl+alt+XF86Switch_VT_7 chvt 7
key ctrl+alt+XF86Switch_VT_8 chvt 8
key ctrl+alt+XF86Switch_VT_9 chvt 9
key ctrl+alt+XF86Switch_VT_10 chvt 10
key ctrl+alt+XF86Switch_VT_11 chvt 11
key ctrl+alt+XF86Switch_VT_12 chvt 12

# zoom
button client logo+wheel-up magnify 0.25
button client logo+wheel-down magnify -0.25
button root logo+wheel-up magnify 0.25
button root logo+wheel-down magnify -0.25

key logo+alt+equal magnify 0.25
key logo+alt+minus magnify -0.25
key logo+alt+0 magnify 0

# button: bar area, modifiers+button, action, argument
button ltsymbol left setlayout "[ ]"
button title middle zoom
button title left notifyopen
button title right notifydismiss
button wintitle wheel-up focusstack -1
button wintitle wheel-down focusstack 1
button status middle spawn foot
button tray left trayactivate
button tray right traymenu
button tagbar left view 0
button tagbar right toggleview 0
button tagbar logo+left tag 0
button tagbar logo+right toggletag 0
button tagbar wheel-up shiftview -1
button tagbar wheel-down shiftview 1
button client logo+left moveresize move
button client logo+middle togglefloating
button client logo+right moveresize resize

# gesture: motion, fingers, action, argument
gesture swipe-left 3 shiftview 1
gesture swipe-right 3 shiftview -1
gesture swipe-up 3 togglefullscreen
