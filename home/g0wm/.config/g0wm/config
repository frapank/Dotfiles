key ctrl+alt+XF86Switch_VT_2 chvt 2
key ctrl+alt+XF86Switch_VT_3 chvt 3
key ctrl+alt+XF86Switch_VT_4 chvt 4
key ctrl+alt+XF86Switch_VT_5 chvt 5
key ctrl+alt+XF86Switch_VT_6 chvt 6
key ctrl+alt+XF86Switch_VT_7 chvt 7
key ctrl+alt+XF86Switch_VT_8 chvt 8
key ctrl+alt+XF86Switch_VT_9 chvt 9
