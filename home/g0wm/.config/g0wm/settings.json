        "tags": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6"
        ]
    },
    "windows": {
        "borderpx": 3,
        "cornerstyle": "squircle",
        "cornerpx": 12,
        "gaps": 2,
        "gappx": 2,
        "smartgaps": false,
        "titlebar": true,
        "titlepadding": 15,
        "titlecenter": true,
        "titleclose": true,
        "titleclosecolor": "#ff5f57ff",
        "layouts": [
            {
                "symbol": "[ ]",
                "arrange": "tile"
            },
            {
                "symbol": "< >",
                "arrange": "float"
            },
            {
                "symbol": "| |",
                "arrange": "tabbed"
            }
        ],
        "rules": [
            {
                "id": "Placeholder",
                "title": null,
                "tags": 0,
                "isfloating": true,
                "opacity_focus": 0,
                "opacity_unfocus": 0,
                "monitor": -1
            }
        ]
    },
    "bar": {
        "showbar": true,
        "topbar": true,
        "barwintitle": false,
        "bartagdots": true,
        "barltsymbol": false,
        "barboxradius": 2,
        "barpadding": 4,
        "barheight": 1.5,
        "barsinglemon": false,
        "showsystray": true,
        "systrayspacing": 2,
        "systraypadding": 2,
        "systrayiconsize": 16,
        "shownotifications": true,
        "notification_timeout": 5,
        "notification_linewidth": 4,
        "notification_lineradius": 2,
        "notification_actionsign": "",
        "runner_placeholder": "Run..."
    },
    "opacity": {
        "opacity_enabled": false,
        "opacity_focus": 0.82,
        "opacity_unfocus": 0.82,
        "opacity_deco": 1,
        "opacity_type": "blur",
        "blur_radius": 15,
        "blur_passes": 1,
        "blur_saturation": 1.6,
        "blur_brightness": 1
    },
    "monitors": "@MONITOR@",
    "input": {
        "sloppyfocus": true,
        "xkb_rules": {
            "rules": null,
            "model": null,
            "layout": null,
            "variant": null,
            "options": null
        },
        "repeat_rate": 25,
        "repeat_delay": 600,
        "cursor_theme": "Bibata-Modern-Classic",
        "cursor_size": 20,
        "hide_cursor_when_typing": true,
        "tap_to_click": true,
        "tap_and_drag": true,
        "drag_lock": true,
        "natural_scrolling": false,
        "disable_while_typing": true,
        "left_handed": false,
        "middle_button_emulation": false,
        "scroll_method": "2fg",
        "click_method": "button-areas",
        "send_events_mode": "enabled",
        "accel_profile": "flat",
        "accel_speed": 0,
        "button_map": "lrm"
    },
