[Desktop Entry]
Type=Application
# the runner finds an entry by its name and by its untranslated one: Name is
# the command, so typing it finds the entry too, shown as Name[en] or Name[it]
Name=qr
Name[en]=QR Code
Name[it]=QR Code
Comment=Read a QR code from the screen, copied
Exec=qr scan
Icon=g0wm-qr
Terminal=false
