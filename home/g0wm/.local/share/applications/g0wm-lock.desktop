[Desktop Entry]
Type=Application
# the runner finds an entry by its name and by its untranslated one: Name is
# the command, so typing it finds the entry too, shown as Name[en] or Name[it]
Name=gtklock
Name[en]=Lock Screen
Name[it]=Lock Screen
Comment=Lock the screen now
Exec=gtklock -d
Icon=g0wm-lock
Terminal=false
