# in place of the entry of the pavucontrol package (same id), with the icon of the theme
[Desktop Entry]
Type=Application
# the runner finds an entry by its name and by its untranslated one: Name is
# the command, so typing it finds the entry too, shown as Name[en] or Name[it]
Name=pavucontrol
Name[en]=Volume
Name[it]=Volume
Comment=The volume of every app and device
Exec=pavucontrol
Icon=g0wm-volume
Terminal=false
