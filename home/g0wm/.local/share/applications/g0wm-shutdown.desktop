[Desktop Entry]
Type=Application
# the runner finds an entry by its name and by its untranslated one: Name is
# the command, so typing it finds the entry too, shown as Name[en] or Name[it]
Name=poweroff
Name[en]=Shut Down
Name[it]=Shut Down
Comment=Power off, after a confirmation
Exec=power poweroff
Icon=g0wm-shutdown
Terminal=false
