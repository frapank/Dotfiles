[Desktop Entry]
Type=Application
# the runner finds an entry by its name and by its untranslated one: Name is
# the command, so typing it finds the entry too, shown as Name[en] or Name[it]
Name=reboot
Name[en]=Restart
Name[it]=Restart
Comment=Reboot, after a confirmation
Exec=power reboot
Icon=g0wm-restart
Terminal=false
