[Desktop Entry]
Type=Application
# the runner finds an entry by its name and by its untranslated one: Name is
# the command, so typing it finds the entry too, shown as Name[en] or Name[it]
Name=colorpick
Name[en]=Color Pick
Name[it]=Color Pick
Comment=Click a pixel, its color is copied
Exec=colorpick
Icon=g0wm-colorpick
Terminal=false
