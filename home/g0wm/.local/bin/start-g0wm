#!/bin/sh
set -eu

guard() {
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        echo "start-g0wm: already inside a Wayland session ($WAYLAND_DISPLAY), refusing to nest" >&2
        exit 1
    fi

    if ! command -v g0wm >/dev/null 2>&1; then
        echo "start-g0wm: g0wm not found in PATH, cannot start" >&2
        exit 1
    fi

    # a second session would take over the services of the first
    if pgrep -u "$(id -u)" -x g0wm >/dev/null 2>&1; then
        echo "start-g0wm: g0wm is already running for this user, refusing to start another" >&2
        exit 1
    fi
    if command -v flock >/dev/null 2>&1 && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        exec 9>"$XDG_RUNTIME_DIR/start-g0wm.lock"
        if ! flock -n 9; then
            echo "start-g0wm: another start-g0wm is running, refusing to start" >&2
            exit 1
        fi
    fi
}

export_env() {
    export XDG_CURRENT_DESKTOP=g0wm
    export XDG_SESSION_TYPE=wayland
    export XDG_SESSION_DESKTOP=g0wm

    export MOZ_ENABLE_WAYLAND=1
    export QT_QPA_PLATFORM=wayland
    export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
    export SDL_VIDEODRIVER=wayland
    export _JAVA_AWT_WM_NONREPARENTING=1

    export GDK_BACKEND=wayland,x11
    export CLUTTER_BACKEND=wayland
}

setup_log() {
    log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/g0wm"
    mkdir -p "$log_dir"
    log_out=$log_dir/g0wm.log
    # the journal keeps it small: 'logs session' reads it
    journal=
    if command -v systemd-cat >/dev/null 2>&1; then
        journal="systemd-cat -t g0wm --"
        log_out=/dev/null
    fi

    cd "$HOME"

    # core-keep keeps only the dump of g0wm
    # ulimit -c is a bashism, guarded with `|| true`.
    # shellcheck disable=SC3045
    ulimit -c unlimited 2>/dev/null || true
}

# the services stop on their own once g0wm is gone
cleanup() {
    pkill -u "$(id -u)" -x g0wm-status.sh 2>/dev/null || true

    for core in "$HOME"/core "$HOME"/core.*; do
        [ -f "$core" ] || continue
        mv "$core" "$log_dir/$(basename "$core").$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    done
}

# restart the status script while g0wm runs
# 141 means g0wm closed the pipe
status_loop() {
    while :; do
        rc=0
        g0wm-status.sh || rc=$?
        [ "$rc" -ne 141 ] || return 0
        sleep 1
        pgrep -u "$(id -u)" -x g0wm >/dev/null 2>&1 || return 0
    done
}

run_session() {
    session_launcher=
    # the bus of the user, the one systemd starts the services on (dbus-user-session)
    if [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    elif command -v dbus-run-session >/dev/null 2>&1 && command -v dbus-daemon >/dev/null 2>&1; then
        session_launcher="dbus-run-session --"
    else
        echo "start-g0wm: dbus-run-session/dbus-daemon not found, running without a private D-Bus session (systray will be unavailable)" >&2
    fi

    # shellcheck disable=SC2086
    if command -v g0wm-status.sh >/dev/null 2>&1; then
        # g0wm-status.sh writes once a minute: end it as soon as g0wm exits
        status_loop 9>&- | {
            rc=0
            $session_launcher $journal g0wm 9>&- >>"$log_out" 2>&1 || rc=$?
            pkill -PIPE -u "$(id -u)" -x g0wm-status.sh 2>/dev/null || true
            exit "$rc"
        }
    else
        echo "start-g0wm: g0wm-status.sh not found, starting without bar status text" >&2
        $session_launcher $journal g0wm 9>&- >>"$log_out" 2>&1
    fi
}

main() {
    guard
    export_env
    setup_log

    trap cleanup EXIT
    trap 'exit 143' HUP INT TERM

    # g0wm-login reads it from the journal
    rc=0
    run_session || rc=$?
    [ "$rc" -eq 0 ] || logger -t start-g0wm "g0wm exited with status $rc" 2>/dev/null || true
    return "$rc"
}

main "$@"
