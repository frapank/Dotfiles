{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

    // pastel, with the red of Debian on the swirl; fastfetch 2.40 (Debian 13) keys
    "logo": {
        "source": "debian",
        "color": {
            "1": "38;2;244;167;185",
            "2": "38;2;215;10;83"
        },
        "padding": { "top": 2, "left": 2, "right": 4 }
    },

    "display": {
        "separator": "  ",
        "color": {
            "title": "38;2;215;10;83",
            "keys": "38;2;244;167;185",
            "separator": "38;2;120;116;130",
            "output": "38;2;233;233;233"
        },
        "key": { "width": 14 },
        "bar": {
            "width": 12,
            "charElapsed": "━",
            // 2.40 always paints the rest of the bar white: the char brings its own color
            "charTotal": "\u001b[38;2;120;116;130m━",
            "borderLeft": "",
            "borderRight": ""
        },
        "percent": {
            "type": ["num", "bar"],
            "color": { "green": "38;2;181;224;190", "yellow": "38;2;246;227;161", "red": "38;2;215;10;83" }
        }
    },

    "modules": [
        { "type": "title", "format": "  {user-name-colored}\u001b[38;2;120;116;130m@\u001b[38;2;244;167;185m{host-name}" },
        { "type": "custom", "format": "\u001b[38;2;244;167;185m╭─ system" },
        { "type": "os",       "key": "│  os", "keyColor": "38;2;244;167;185" },
        { "type": "kernel",   "key": "│ 󰒓 kernel", "keyColor": "38;2;244;167;185" },
        { "type": "uptime",   "key": "│ 󰅐 uptime", "keyColor": "38;2;244;167;185" },
        { "type": "packages", "key": "│ 󰏖 packages", "keyColor": "38;2;244;167;185" },
        { "type": "shell",    "key": "│ 󰆍 shell", "keyColor": "38;2;244;167;185" },
        { "type": "custom", "format": "\u001b[38;2;200;182;230m├─ desktop" },
        { "type": "wm",       "key": "│ 󰖯 wm", "keyColor": "38;2;200;182;230" },
        { "type": "display",  "key": "│ 󰍹 display", "keyColor": "38;2;200;182;230", "format": "{width}x{height} @ {refresh-rate} Hz" },
        { "type": "theme",    "key": "│ 󰉼 theme", "keyColor": "38;2;200;182;230" },
        { "type": "font",     "key": "│ 󰉷 font", "keyColor": "38;2;200;182;230" },
        { "type": "terminal", "key": "│ 󰞷 terminal", "keyColor": "38;2;200;182;230" },
        { "type": "custom", "format": "\u001b[38;2;167;199;231m├─ hardware" },
        { "type": "cpu",      "key": "│ 󰻠 cpu", "keyColor": "38;2;167;199;231", "showPeCoreCount": false },
        { "type": "gpu",      "key": "│ 󰢮 gpu", "keyColor": "38;2;167;199;231", "format": "{name}" },
        { "type": "memory",   "key": "│ 󰍛 memory", "keyColor": "38;2;167;199;231" },
        { "type": "disk",     "key": "│ 󰋊 disk", "keyColor": "38;2;167;199;231", "folders": "/" },
        { "type": "localip",  "key": "│ 󰩟 ip", "keyColor": "38;2;167;199;231", "showIpv4": true },
        { "type": "battery",  "key": "│ 󰁹 battery", "keyColor": "38;2;167;199;231" },
        { "type": "custom", "format": "\u001b[38;2;167;199;231m╰───" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
    ]
}
