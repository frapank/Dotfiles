#!/bin/sh
set -u

usage() {
    cat <<EOF
Usage: tmux-project [FOLDER]
Pick a folder with fzf, the open sessions first and then the ones zoxide
knows, most used first, and switch to its tmux session: made there if missing.
With FOLDER, skip the picker. Prefix f in tmux opens it in a popup.

  -h, --help  show this help

Examples:
  tmux-project
  tmux-project ~/Desktop/G0wm

Exit status: 0, 1 if FOLDER is not a folder or fzf is missing, 2 on bad
usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' tmux-project "$*" >&2
    else
        printf '%s: %s\n' tmux-project "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'tmux-project --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'tmux-project --help' for more information.\n" >&2
    fi
    exit 2
}

case ${1:-} in -h | --help | help)
    help
    exit 0
    ;;
esac

case ${1:-} in
--*) bad "unrecognized option '$1'" ;;
-?*) bad "invalid option -- '${1#-}'" ;;
esac
[ $# -le 1 ] || bad "extra operand '$2'"
if [ $# -gt 0 ]; then
    dir=$1
else
    command -v fzf >/dev/null || {
        err "fzf is not installed"
        exit 1
    }
    dir=$(
        {
            tmux list-sessions -F '#{session_path}' 2>/dev/null
            command -v zoxide >/dev/null && zoxide query -l
        } | awk '!seen[$0]++' | sed "s|^$HOME|~|" |
            fzf --prompt 'project> ' --reverse --no-sort \
                --preview 'ls -A --color=always "$(echo {} | sed "s|^~|$HOME|")"'
    ) || exit 0
    dir=$(printf '%s\n' "$dir" | sed "s|^~|$HOME|")
fi
[ -d "$dir" ] || {
    err "'$dir' is not a folder"
    exit 1
}
dir=$(cd -- "$dir" && pwd)

# tmux takes . and : in a name as window and pane
name=$(basename -- "$dir" | tr '.:' '__')
[ "$dir" = / ] && name=root

tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$dir" || exit 1
if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=$name"
fi
exec tmux attach-session -t "=$name"
