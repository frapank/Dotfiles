#!/bin/sh
set -eu

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: qr [-o FILE.png] [--] [TEXT]
  or:  qr clip
  or:  qr scan | read IMAGE
Show TEXT (default: standard input) as a QR code on the terminal, to pass a
link or a password to the phone with no cloud in between.

  clip        encode the clipboard
  scan        read a QR code from a region of the screen
  read IMAGE  read a QR code from IMAGE
  -o FILE     write a png instead
  -h, --help  show this help
What scan and read find is printed and copied, notified if there is no
terminal. To encode the word clip, scan or read itself, put -- before it.

Examples:
  qr https://example.org
  pass show wifi | qr
  qr scan

Exit status: 0, 1 on failure, 2 on bad usage.
EOF
}

die() {
    err "$*"
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is missing (apt install $2)"
}

decode() {
    need zbarimg zbar-tools
    out=$(zbarimg -q --raw -- "$1") || {
        [ -t 1 ] || notify-send -a " qr" -u low "No QR code found" 2>/dev/null
        die "no QR code found"
    }
    printf '%s' "$out" | wl-copy
    if [ -t 1 ]; then
        printf '%s\n' "$out"
    else
        notify-send -a " qr" -u low "QR code copied" "$out" 2>/dev/null || :
    fi
}

encode() {
    need qrencode qrencode
    if [ -n "$file" ]; then
        qrencode -s 8 -m 2 -o "$file"
    else
        qrencode -t ANSIUTF8 -m 2
    fi
}

file=
case ${1:-} in
-h | --help)
    help
    exit 0
    ;;
scan)
    [ $# -eq 1 ] || bad "extra operand '$2'"
    geo=$(slurp 2>/dev/null) || exit 0
    tmp=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/qr.XXXXXX")
    trap 'rm -f -- "$tmp"' EXIT
    grim -g "$geo" -t png "$tmp"
    decode "$tmp"
    exit
    ;;
read)
    [ $# -ge 2 ] || bad "missing IMAGE"
    [ $# -eq 2 ] || bad "extra operand '$3'"
    [ -r "$2" ] || die "cannot read $2"
    decode "$2"
    exit
    ;;
clip)
    [ $# -eq 1 ] || bad "extra operand '$2'"
    wl-paste -n | encode
    exit
    ;;
-o)
    [ $# -ge 2 ] || bad "option requires an argument -- 'o'"
    file=$2
    shift 2
    ;;
--) ;;
--?*) bad "unrecognized option '$1'" ;;
-?*) bad "invalid option -- '${1#-}'" ;;
esac

[ "${1:-}" = -- ] && shift
case $# in
0)
    [ -t 0 ] && bad "missing TEXT, and nothing on standard input"
    encode
    ;;
1) printf '%s' "$1" | encode ;;
*) bad "extra operand '$2'" ;;
esac
