#!/bin/sh
set -uf

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh
usage() {
    cat <<EOF
Usage: traces [WHAT]...
  or:  traces clean [-s] [WHAT]...
Show the traces of what you did that stay on this machine: recent files,
histories, thumbnails, trash and clipboard. With clean, delete them.

  clean       delete the traces of each WHAT (default: all of them)
  -s          with clean, also delete them from the snapshots of /home (asks
              for doas)
  -h, --help  show this help

WHAT:
  recent      recently used files, positions in documents, videos watched,
              LibreOffice recent documents
  history     shell, vim, neovim, less, python, node, sqlite, w3m, the
              folders zoxide knows and the sites wget remembers (HSTS)
  thumbnails  previews of images and documents
  trash       everything in the trash
  clipboard   the clipboard and the primary selection

Examples:
  traces
  traces clean history clipboard
  traces clean -s

Exit status: 0, 1 if something could not be deleted, 2 on bad usage.
EOF
}

die() {
    err "$*"
    exit 1
}

ALL='recent history thumbnails trash clipboard'
LO=$HOME/.config/libreoffice/4/user/registrymodifications.xcu

paths() {
    case $1 in
    recent) set -- .local/share/recently-used.xbel .local/share/gvfs-metadata \
        .local/state/showtime/playback_history.json ;;
    history) set -- .bash_history .lesshst .local/state/lesshst .viminfo \
        .local/state/nvim/shada .python_history .node_repl_history .sqlite_history \
        .w3m/history .wget-hsts .local/share/zoxide ;;
    thumbnails) set -- .cache/thumbnails ;;
    trash) set -- .local/share/Trash ;;
    *) set -- ;;
    esac
    for p; do printf '%s\n' "$HOME/$p"; done
}

# a history symlinked to /dev/null is left alone
present() { [ -e "$1" ] && [ ! -L "$1" ]; }

picklist() { [ -f "$LO" ] && [ ! -L "$LO" ] && grep -c "HistoryInfo\['PickList'\]/ItemList" "$LO"; }

# the rows of WHAT in the table: what, size, path
show() {
    for p in $(paths "$1"); do
        present "$p" || continue
        line "$1" "$(du -sh -- "$p" 2>/dev/null | cut -f1)" "~${p#"$HOME"}"
    done
    if [ "$1" = recent ] && c=$(picklist) && [ "$c" -gt 0 ]; then
        line "$1" "$c" "LibreOffice recent documents"
    fi
    if [ "$1" = clipboard ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        for sel in '' --primary; do
            # shellcheck disable=SC2086 # empty selection flag
            [ -n "$(wl-paste $sel --list-types 2>/dev/null)" ] || continue
            if [ -n "$sel" ]; then name='primary selection'; else name=clipboard; fi
            line "$1" full "$name"
        done
    fi
}

n=0
line() {
    [ "$n" -gt 0 ] || dim "$(printf '%-11s %6s  %s' WHAT SIZE PATH)"
    printf '%-11s %6s  %s\n' "$1" "$2" "$3"
    n=$((n + 1))
}

clean() {
    for p in $(paths "$1"); do
        present "$p" || continue
        # read-only folders (unpacked archives in the trash) block rm
        [ -d "$p" ] && chmod -R u+rwX -- "$p" 2>/dev/null
        if rm -rf -- "$p"; then
            row ok "~${p#"$HOME"}"
            done=$((done + 1))
            # ~/.cache is kept out of the snapshots
            case $p in "$HOME"/.cache/*) ;; *) printf '%s\n' "$p" >>"$forget" ;; esac
        else
            row fail "~${p#"$HOME"}"
            bad=1
        fi
    done
    case $1 in
    recent)
        # the metadata daemon keeps the old data in memory and writes it back
        pkill -u "$(id -u)" -x gvfsd-metadata 2>/dev/null
        if c=$(picklist) && [ "$c" -gt 0 ]; then
            if pgrep -u "$(id -u)" -x soffice.bin >/dev/null; then
                row warn "LibreOffice is open: close it and run this again for its recent documents"
                bad=1
            elif sed -i "/HistoryInfo\['PickList'\]/d" "$LO"; then
                row ok "$c LibreOffice recent documents"
                done=$((done + 1))
                printf '%s\n' "$LO" >>"$forget"
            else
                bad=1
            fi
        fi
        ;;
    history)
        if pgrep -u "$(id -u)" -x 'bash|vim|nvim' >/dev/null; then
            row warn "open shells and editors write their history back when they close: run 'history -c' in each shell, close the editors"
        fi
        ;;
    clipboard)
        if [ -n "${WAYLAND_DISPLAY:-}" ]; then
            if wl-copy --clear && wl-copy --primary --clear; then
                row ok "clipboard"
                done=$((done + 1))
            else
                row fail "clipboard"
                bad=1
            fi
        fi
        ;;
    esac
}

case ${1:-} in help | --help)
    help
    exit 0
    ;;
esac
c=0
if [ "${1:-}" = clean ]; then
    c=1
    shift
fi
for a; do
    case $a in
    --) break ;;
    --*)
        bad "unrecognized option '$a'"
        ;;
    -*) ;;
    *) break ;;
    esac
done

s=0
while getopts :sh o; do
    case $o in
    \?)
        bad "invalid option -- '$OPTARG'"
        ;;
    s) s=1 ;;
    h)
        help
        exit 0
        ;;
    *) bad "invalid option -- '$OPTARG'" ;;
    esac
done
shift $((OPTIND - 1))
[ "$s" = 0 ] || [ "$c" = 1 ] || {
    bad "-s works only with clean"
}
for w; do
    case " $ALL " in *" $w "*) ;; *) bad "unknown WHAT '$w'" ;; esac
done
# shellcheck disable=SC2086 # word list
[ $# -gt 0 ] || set -- $ALL

bad=0
if [ "$c" = 0 ]; then
    for w; do show "$w"; done
    [ "$n" -gt 0 ] && exit 0
    if [ $# -gt 1 ]; then
        echo "No traces."
    else
        case $1 in
        recent) echo 'No recent files.' ;;
        history) echo 'No histories.' ;;
        thumbnails) echo 'No thumbnails.' ;;
        trash) echo 'The trash is empty.' ;;
        clipboard) echo 'The clipboard is empty.' ;;
        esac
    fi
    exit 0
fi

forget=$(mktemp) || die "cannot create a temporary file"
trap 'rm -f -- "$forget"' EXIT
done=0
for w; do clean "$w"; done
if [ "$s" = 1 ] && [ -s "$forget" ]; then
    command -v forget >/dev/null || die "forget is not installed: the snapshots still hold the old copies"
    tr '\n' '\0' <"$forget" | xargs -0 forget -- || bad=1
elif [ -s "$forget" ] && [ -d /home/.snapshots ]; then
    row info "the snapshots of /home still hold the old copies: 'traces clean -s' deletes them too"
fi
case $done in
0) dim "Nothing to delete." ;;
1) dim "Deleted 1 trace." ;;
*) dim "Deleted $done traces." ;;
esac
exit "$bad"
