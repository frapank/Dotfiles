#!/bin/sh
set -eu

last=${XDG_RUNTIME_DIR:-/tmp}/record.last

if pgrep -u "$(id -u)" -x wf-recorder >/dev/null; then
    pkill -INT -u "$(id -u)" -x wf-recorder
    notify-send -i video-x-generic -t 3000 "Recording saved" "$(cat "$last" 2>/dev/null)" || true
    exit 0
fi

geo= audio=
for a in "$@"; do
    case $a in
    region) geo=$(slurp) || exit 0 ;;
    --audio) audio=-a ;;
    *) echo "usage: record [region] [--audio]" >&2; exit 2 ;;
    esac
done

dir=$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME")
mkdir -p "$dir"
out=$dir/rec-$(date +%Y%m%d-%H%M%S).mp4
printf '%s\n' "$out" >"$last"

notify-send -i video-x-generic -t 2000 "Recording" "Super+Print again to stop" || true
exec wf-recorder $audio ${geo:+-g "$geo"} -f "$out"
