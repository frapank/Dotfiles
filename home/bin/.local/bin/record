#!/bin/sh
set -eu

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: record [on|toggle] [region] [--no-audio]
  or:  record off | status | info | folder
Record the screen with the sound of the desktop, and the microphone if it is
on; run it again to stop. The red dot in the bar shows it is recording.

  on          start recording, leave an active recording running
  off         stop recording (stop is an alias)
  toggle      start or stop (default)
  region      pick a region with the mouse
  --no-audio  without sound
  status      print whether a recording is running
  info        what is being recorded and for how long, in the bar
  folder      open the folder of the recordings
  -h, --help  show this help

Exit status: 0, 1 on failure, 2 on bad usage.
EOF
}

run=${XDG_RUNTIME_DIR:-/tmp}
last=$run/record.last
pid=$run/record.pid
mods=$run/record.modules
info=$run/record.info

recording() { pgrep -u "$(id -u)" -x wf-recorder >/dev/null; }
# refresh the bar after $1 seconds
bar() { setsid -f sh -c "sleep ${1:-0}; exec pkill -USR1 -u $(id -u) -x g0wm-status.sh" >/dev/null 2>&1; }

stop() {
    pkill -INT -u "$(id -u)" -x wf-recorder
    bar
}

# for the rec icon in the bar: how long and what, stop, the videos
case ${1:-} in
-h | --help | status | info | stop | off | folder)
    [ $# -eq 1 ] || bad "extra operand '$2'"
    ;;
esac

case ${1:-} in
-h | --help)
    help
    exit 0
    ;;
status)
    if recording; then
        printf 'on\n'
        [ ! -r "$info" ] || cat "$info"
    else
        printf 'off\n'
    fi
    exit 0
    ;;
info)
    if recording && [ -r "$pid" ]; then
        s=$(($(date +%s) - $(stat -c %Y "$pid")))
        t=$(printf '%02d:%02d' $((s / 60 % 60)) $((s % 60)))
        [ "$s" -lt 3600 ] || t=$((s / 3600)):$t
        notify-send -a " record" -u low -e -t 3000 -h string:x-dunst-stack-tag:record \
            "Recording $t" "$(cat "$info" 2>/dev/null)
Middle click: stop · Right click: recordings" || true
    else
        notify-send -a " record" -u low -e -t 2000 "Not recording" || true
    fi
    exit 0
    ;;
off | stop)
    recording && stop
    exit 0
    ;;
folder) exec files "$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME")" ;;
esac

mode=toggle
case ${1:-} in on | toggle)
    mode=$1
    shift
    ;;
esac
region= sound=1
for a in "$@"; do
    case $a in
    region) region=1 ;;
    --no-audio) sound= ;;
    -*) bad "unrecognized option '$a'" ;;
    *) bad "unknown action '$a'" ;;
    esac
done

if recording; then
    [ "$mode" != on ] || exit 0
    stop
    exit 0
fi

geo= out= what=
if [ -n "$region" ]; then
    geo=$(slurp) || exit 0
    what=region
else
    # shellcheck disable=SC2046
    set -- $(grep -lx connected /sys/class/drm/card*-*/status 2>/dev/null || :)
    if [ $# -gt 1 ]; then
        out=$(slurp -o -f %o) || exit 0
        what=$out
    elif [ $# -eq 1 ]; then
        what=${1%/status}
        what=${what##*/card*-}
    else
        what=screen
    fi
fi

unload() {
    [ -s "$mods" ] || return 0
    while read -r m; do pactl unload-module "$m" 2>/dev/null || :; done <"$mods"
    rm -f "$mods"
}
unload

audio= label="no audio"
if [ -n "$sound" ] && sink=$(pactl get-default-sink 2>/dev/null); then
    audio=$sink.monitor label=system
    src=$(pactl get-default-source 2>/dev/null || :)
    case $src in
    '' | *.monitor) ;;
    *)
        if pactl get-source-mute "$src" 2>/dev/null | grep -q 'no$' &&
            ! [ "$(timeout 1 pw-record --target "$src" --raw - 2>/dev/null | head -c 4096 | wc -c)" -lt 4096 ]; then
            trap unload EXIT
            {
                pactl load-module module-null-sink sink_name=record \
                    sink_properties=device.description=Recording
                pactl load-module module-loopback source="$sink.monitor" \
                    sink=record latency_msec=20
                pactl load-module module-loopback source="$src" \
                    sink=record latency_msec=20
            } >"$mods"
            audio=record.monitor label="system + mic"
        fi
        ;;
    esac
fi

dir=$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME")
mkdir -p "$dir"
file=$dir/rec-$(date +%Y%m%d-%H%M%S).mp4
printf '%s\n' "$file" >"$last"
printf '%s\n' "$what · $label" >"$info"

notify-send -a " record" -u low -e -t 2000 "Recording $what · $label" \
    "Super+Print again to stop" || true

trap 'kill -INT "$rec" 2>/dev/null' INT TERM
wf-recorder ${audio:+--audio="$audio"} ${geo:+-g "$geo"} ${out:+-o "$out"} \
    -f "$file" &
rec=$!
# wf-recorder's own pid: g0wm-status.sh shows the rec icon while it runs
printf '%s\n' "$rec" >"$pid"
bar 0.5
wait "$rec" || wait "$rec" || :
rm -f "$pid" "$info"
bar
unload

if [ -s "$file" ]; then
    notify_file " Recording" "Recording saved" "$file" </dev/null >/dev/null 2>&1 &
fi
