#!/bin/sh
set -eu

[ $# -ge 1 ] || { echo "usage: open-default MIME [FILE|URL...]" >&2; exit 2; }
mime=$1
shift

if [ $# -eq 1 ]; then
    exec xdg-open "$1"
elif [ $# -gt 1 ]; then
    for f in "$@"; do
        xdg-open "$f" &
    done
    exit 0
fi

app=$(xdg-mime query default "$mime")
[ -n "$app" ] || { echo "open-default: no default app for $mime" >&2; exit 1; }
exec gtk-launch "${app%.desktop}"
