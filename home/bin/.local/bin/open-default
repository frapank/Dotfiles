#!/bin/sh
set -eu

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: open-default MIME [FILE|URL]...
Open each FILE or URL with xdg-open; with none, start the default app for
MIME. What photo, video, pdf, office, browser, files and audio run.

  -h, --help  show this help

Exit status: 0, 1 if MIME has no default app, 2 on bad usage.
EOF
}

case ${1:-} in -h | --help)
    help
    exit 0
    ;;
esac
[ $# -ge 1 ] || bad "missing MIME"
mime=$1
shift

if [ $# -eq 1 ]; then
    exec xdg-open "$1"
elif [ $# -gt 1 ]; then
    for f in "$@"; do
        xdg-open "$f" &
    done
    exit 0
fi

app=$(xdg-mime query default "$mime")
[ -n "$app" ] || {
    echo "open-default: no default app for $mime" >&2
    exit 1
}
exec gtk-launch "${app%.desktop}"
