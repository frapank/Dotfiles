#!/bin/sh
set -eu

usage() {
    cat <<EOF
Usage: colorpick [-r]
Click a pixel on the screen: its color is copied as #rrggbb, printed with a
swatch on a terminal, and notified with a swatch.

  -r          copy rgb(r, g, b) instead
  -h, --help  show this help

Examples:
  colorpick
  colorpick -r

Exit status: 0, 1 if the pixel cannot be read, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' colorpick "$*" >&2
    else
        printf '%s: %s\n' colorpick "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'colorpick --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'colorpick --help' for more information.\n" >&2
    fi
    exit 2
}

rgb=0
case ${1:-} in
'') ;;
-r) rgb=1 ;;
-h | --help)
    help
    exit 0
    ;;
-?*) bad "invalid option -- '${1#-}'" ;;
*) bad "extra operand '$1'" ;;
esac

geo=$(slurp -p 2>/dev/null) || exit 0
# one pixel at scale 1 as binary ppm: its last 3 bytes are r g b
# shellcheck disable=SC2046
set -- $(grim -s 1 -g "$geo" -t ppm - | tail -c 3 | od -An -tu1)
[ $# -eq 3 ] || {
    echo "colorpick: could not read the pixel" >&2
    exit 1
}

hex=$(printf '#%02x%02x%02x' "$1" "$2" "$3")
rgbs="rgb($1, $2, $3)"
if [ "$rgb" = 1 ]; then out=$rgbs; else out=$hex; fi

printf '%s' "$out" | wl-copy
if [ -t 1 ]; then
    printf '\033[48;2;%s;%s;%sm      \033[0m %s  %s\n' "$1" "$2" "$3" "$hex" "$rgbs"
else
    echo "$out"
fi
# the color itself as the icon of the notification: g0wm loads svg with gdk-pixbuf.
# One file per color, so an older notification keeps its own
swatch=${XDG_RUNTIME_DIR:-/tmp}/colorpick-${hex#\#}.svg
printf '<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64"><rect x="2" y="2" width="60" height="60" rx="12" fill="%s" stroke="#ffffff" stroke-opacity=".15" stroke-width="2"/></svg>\n' \
    "$hex" >"$swatch" 2>/dev/null || swatch=
notify-send ${swatch:+-i "$swatch"} -a " colorpick" -u low "$hex" "$rgbs · copied" 2>/dev/null || :
