#!/bin/sh
set -eu

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: compress [-p] FILE... ARCHIVE
  or:  compress [-p] -o ARCHIVE FILE...
Pack FILEs into ARCHIVE; the format comes from the ARCHIVE extension.

  -p          ask for a password (.zip .7z; .gpg and .age always ask)
  -o ARCHIVE  write to ARCHIVE, all operands are FILEs
  -h, --help  show this help

Formats:
  .tar .tar.gz .tgz .tar.bz2 .tbz2 .tar.xz .txz .tar.zst .tzst .tar.lz .tar.lz4
  .zip .7z                      archive; -p: zip classic, 7z AES-256
  .gz .bz2 .xz .zst .lz .lz4    compress a single file
  .gpg .age                     encrypt a single file
  .tar.gpg .tar.age             encrypt a tar archive

Examples:
  compress notes/ notes.tar.zst
  compress -p taxes.pdf taxes.7z

Exit status: 0, 1 on failure, 2 on bad usage.
EOF
}

die() {
    err "$*"
    exit 1
}

# How far a long job got: on a terminal and after a second, a dimmed line on
# standard error with what, the percent and the time left, gone at the end.
# watch_read FILE CMD...: CMD reads FILE from start to end; the position comes
# from the descriptor of whichever process under CMD has it open.
# watch_bytes TOTAL LABEL CMD...: CMD reads TOTAL bytes, of whatever files.
watch_read() {
    w_file=$(realpath -- "$1") w_total=$(stat -c %s -- "$1") w_mode=read w_label=${1##*/}
    shift
    watch_run "$@"
}
watch_bytes() {
    w_file= w_total=$1 w_mode=bytes w_label=$2
    shift 2
    watch_run "$@"
}
watch_run() {
    if ! [ -t 2 ] || [ "${w_total:-0}" -le 0 ]; then
        "$@"
        return
    fi
    "$@" &
    w_pid=$!
    w_t0=$(date +%s%N) w_shown=
    while kill -0 "$w_pid" 2>/dev/null; do
        sleep 0.5
        # in milliseconds
        w_el=$((($(date +%s%N) - w_t0) / 1000000))
        [ "$w_el" -ge 1000 ] || continue
        w_pos=$(watch_pos)
        [ "${w_pos:-0}" -gt 0 ] || continue
        printf '\r\033[K\033[2m%s\033[0m' "$(awk -v p="$w_pos" -v t="$w_total" -v e="$w_el" -v w="$w_label" 'BEGIN {
            # all read but still at work (xz reads ahead): no time to promise
            if (p >= t) { printf "%s  finishing", w; exit }
            l = int(e / 1000 * (t - p) / p + 0.5)
            s = l >= 3600 ? sprintf("%dh %02dm", l / 3600, l % 3600 / 60) : l >= 60 ? sprintf("%dm %02ds", l / 60, l % 60) : l "s"
            printf "%s  %d%%  ~%s left", w, 100 * p / t, s
        }')" >&2
        w_shown=1
    done
    [ -z "$w_shown" ] || printf '\r\033[K' >&2
    wait "$w_pid"
}
# CMD and everything it started: bwrap moves them to a process group of their own
watch_tree() {
    echo "$1"
    # shellcheck disable=SC2013 # the pids are separated by spaces
    for w_c in $(cat /proc/"$1"/task/*/children 2>/dev/null); do watch_tree "$w_c"; done
}
watch_pos() {
    for w_p in $(watch_tree "$w_pid"); do
        if [ "$w_mode" = bytes ]; then
            sed -n 's/^rchar: //p' "/proc/$w_p/io" 2>/dev/null
        else
            for w_fd in /proc/"$w_p"/fd/*; do
                [ "$(readlink -- "$w_fd" 2>/dev/null)" = "$w_file" ] &&
                    sed -n 's/^pos:[[:space:]]*//p' "/proc/$w_p/fdinfo/${w_fd##*/}" 2>/dev/null
            done
        fi
    done | sort -n | tail -n 1
}

# a path as it reads best: relative under here, ~ under the home
short() {
    case $1 in
    "$PWD") echo . ;;
    "$PWD"/*) echo "${1#"$PWD"/}" ;;
    "$HOME") echo "~" ;;
    "$HOME"/*) echo "~/${1#"$HOME"/}" ;;
    *) echo "$1" ;;
    esac
}

askpw() {
    trap 'stty echo </dev/tty' EXIT
    trap 'exit 130' INT TERM
    stty -echo </dev/tty
    printf 'Enter password: ' >/dev/tty
    IFS= read -r pw </dev/tty
    echo >/dev/tty
    printf 'Verify password: ' >/dev/tty
    IFS= read -r pw2 </dev/tty
    echo >/dev/tty
    stty echo </dev/tty
    [ -n "$pw" ] || die "Empty password"
    [ "$pw" = "$pw2" ] || die "Passwords do not match"
}

case ${1:-} in help | --help)
    help
    exit 0
    ;;
esac

p= out=
for a; do
    case $a in
    --) break ;;
    --*) bad "unrecognized option '$a'" ;;
    -*) ;;
    *) break ;;
    esac
done
while getopts :po:h o; do
    case $o in
    p) p=1 ;;
    o) out=$OPTARG ;;
    h)
        help
        exit 0
        ;;
    :) bad "option requires an argument -- '$OPTARG'" ;;
    *) bad "invalid option -- '$OPTARG'" ;;
    esac
done
shift $((OPTIND - 1))

if [ -z "$out" ]; then
    [ $# -ge 2 ] || {
        bad "missing file operand"
    }
    eval "out=\${$#}"
    n=$# i=0
    for a; do
        i=$((i + 1))
        [ $i -lt $n ] && set -- "$@" "$a"
    done
    shift $n
fi
[ $# -ge 1 ] || {
    bad "missing file operand"
}

case $(printf '%s' "${out##*/}" | tr '[:upper:]' '[:lower:]') in
*.tar.gpg) fmt=tar.gpg ;;
*.tar.age) fmt=tar.age ;;
*.tar | *.tar.gz | *.tgz | *.tar.bz2 | *.tbz2 | *.tar.xz | *.txz | *.tar.zst | *.tzst | *.tar.lz | *.tar.lz4)
    fmt=tar
    ;;
*.zip) fmt=zip ;;
*.7z) fmt=7z ;;
*.gz) fmt=gzip ;;
*.bz2) fmt=bzip2 ;;
*.xz) fmt=xz ;;
*.zst) fmt=zstd ;;
*.lz) fmt=lzip ;;
*.lz4) fmt=lz4 ;;
*.gpg) fmt=gpg ;;
*.age) fmt=age ;;
*.*) die "$out: Unknown archive format" ;;
*) die "$out: Missing archive extension" ;;
esac

case $fmt in
tar | gzip | bzip2 | xz | zstd | lzip | lz4)
    [ -z "$p" ] || die "-p: Not supported by '$out', use .zip .7z .gpg or .age"
    ;;
esac
for f; do [ -e "$f" ] || [ -L "$f" ] || die "$f: No such file or directory"; done
case $fmt in
gzip | bzip2 | xz | zstd | lzip | lz4 | gpg | age)
    [ $# -eq 1 ] && [ -f "$1" ] || die "$out: Takes a single file, use ${out%.*}.tar.${out##*.}"
    ;;
esac
[ ! -e "$out" ] || die "$out: File exists"
command -v "${fmt#tar.}" >/dev/null || die "${fmt#tar.}: Command not found"

case $fmt in 7z) [ -z "$p" ] || askpw ;; gpg | tar.gpg) askpw ;; esac
gpg() { command gpg -q --batch --no-symkey-cache --pinentry-mode loopback --passphrase-fd 3 "$@"; }

tar_gpg() {
    tar -cf - -- "$@" | gpg -c -o "$out" 3<<EOF
$pw
EOF
}
one_gpg() {
    gpg -c -o "$out" -- "$1" 3<<EOF
$pw
EOF
}
total=$(du -scb -- "$@" 2>/dev/null | tail -n 1 | cut -f1)
label=${out##*/}

case $fmt in
tar) watch_bytes "$total" "$label" tar -caf "$out" -- "$@" ;;
tar.gpg) watch_bytes "$total" "$label" tar_gpg "$@" ;;
tar.age) tar -cf - -- "$@" | age -p -o "$out" ;;
zip)
    if [ -n "$p" ]; then
        zip -rqe "$out" -- "$@"
    else
        watch_bytes "$total" "$label" zip -rq "$out" -- "$@"
    fi
    ;;
7z) watch_bytes "$total" "$label" 7z a -bso0 -bsp0 ${p:+-p"$pw" -mhe=on} -- "$out" "$@" ;;
gpg) watch_bytes "$total" "$label" one_gpg "$1" ;;
age) age -p -o "$out" -- "$1" ;;
*) watch_bytes "$total" "$label" "$fmt" -qc -- "$1" >"$out" || {
    rm -f -- "$out"
    exit 1
} ;;
esac || exit 1

if [ $# -eq 1 ]; then
    what=${1%/}
    what=${what##*/}
else
    what="$# items"
fi
dim "Packed $what into $(short "$(realpath -- "$out")") ($(du -h -- "$out" | cut -f1))."
