#!/bin/sh
set -u

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: nightlight [on|off|toggle|warmer|cooler|status|info|logs]
The blue light filter: warmer colors on the screen, made by wlsunset.

  on, off, toggle  turn it on or off (default: toggle)
  warmer, cooler   250 K warmer or cooler, between 2500 and 6000 K
  status           print the current state
  info             the temperature, in the bar
  logs             show the service logs
  -h, --help       show this help

Exit status: 0, 1 if the nightlight service fails, 2 on bad usage.
EOF
}

# the temperature in kelvin, which ~/.config/services/nightlight/run reads
temp=${XDG_STATE_HOME:-$HOME/.local/state}/nightlight
run=${XDG_RUNTIME_DIR:-/tmp}
min=2500 max=6000 step=250

on() { exec services start nightlight; }
off() { exec services stop nightlight; }

kelvin() {
    k=$(cat "$temp" 2>/dev/null) || k=
    case $k in '' | *[!0-9]*) k=4000 ;; esac
}

show() {
    notify-send -a " Nightlight" -u low -e -t 1500 -h string:x-dunst-stack-tag:osd-nightlight \
        ${2:+-h "int:value:$2"} "$1" ${3:+"$3"} 2>/dev/null
}

# warmer is lower: the wheel takes it a step at a time, and wlsunset restarts
# once the wheel stops instead of at every notch
shift_temp() {
    exec 9>"$run/nightlight.lock"
    flock 9
    kelvin
    k=$((k + $1))
    [ "$k" -ge "$min" ] || k=$min
    [ "$k" -le "$max" ] || k=$max
    mkdir -p -- "${temp%/*}"
    echo "$k" >"$temp"
    echo $$ >"$run/nightlight.seq"
    exec 9>&-
    show "$k K" $(((max - k) * 100 / (max - min)))
    sleep 0.4
    [ "$(cat "$run/nightlight.seq" 2>/dev/null)" = $$ ] || exit 0
    services status nightlight >/dev/null 2>&1 && exec services restart nightlight
    exit 0
}

read_state() {
    services status nightlight >/dev/null
    case $? in
    0) state=on ;;
    3) state=off ;;
    *) return 1 ;;
    esac
}

[ $# -le 1 ] || bad "extra operand '$2'"

case ${1:-toggle} in
-h | --help) help ;;
on) on ;;
off) off ;;
toggle)
    services status nightlight >/dev/null
    case $? in
    0) off ;;
    3) on ;;
    *) exit 1 ;;
    esac
    ;;
warmer) shift_temp -$step ;;
cooler) shift_temp $step ;;
status)
    read_state || exit 1
    printf '%s\n' "$state"
    kelvin
    printf 'temperature=%s\n' "$k"
    ;;
logs) exec services logs nightlight ;;
info)
    read_state || exit 1
    kelvin
    show "$state · $k K" '' "Middle click: turn off · Right click: logs
Scroll: warmer or cooler"
    ;;
*) bad "unknown action '$1'" ;;
esac
