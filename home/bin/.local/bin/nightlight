#!/bin/sh
set -u

# colors and hours are in ~/.config/sv/nightlight/run
on() { exec services start nightlight; }
off() { exec services stop nightlight; }

case ${1:-toggle} in
on) on ;;
off) off ;;
toggle)
    services status nightlight >/dev/null
    case $? in
    0) off ;;
    3) on ;;
    *) exit 1 ;;
    esac
    ;;
*) echo "usage: nightlight [on|off|toggle]" >&2; exit 2 ;;
esac
