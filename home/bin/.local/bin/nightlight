#!/bin/sh
set -u

usage() {
    cat <<EOF
Usage: nightlight [on|off|toggle|warmer|cooler|info]
The blue light filter: warmer colors on the screen, made by wlsunset.

  on, off, toggle  turn it on or off (default: toggle)
  warmer, cooler   250 K warmer or cooler, between 2500 and 6000 K
  info             the temperature, in the bar
  -h, --help       show this help

Exit status: 0, 1 if the nightlight service fails, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' nightlight "$*" >&2
    else
        printf '%s: %s\n' nightlight "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'nightlight --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'nightlight --help' for more information.\n" >&2
    fi
    exit 2
}

# the temperature in kelvin, which ~/.config/services/nightlight/run reads
temp=${XDG_STATE_HOME:-$HOME/.local/state}/nightlight
run=${XDG_RUNTIME_DIR:-/tmp}
min=2500 max=6000 step=250

on() { exec services start nightlight; }
off() { exec services stop nightlight; }

kelvin() {
    k=$(cat "$temp" 2>/dev/null) || k=
    case $k in '' | *[!0-9]*) k=4000 ;; esac
}

show() {
    notify-send -a " Nightlight" -u low -e -t 1500 -h string:x-dunst-stack-tag:osd-nightlight \
        ${2:+-h "int:value:$2"} "$1" 2>/dev/null
}

# warmer is lower: the wheel takes it a step at a time, and wlsunset restarts
# once the wheel stops instead of at every notch
shift_temp() {
    exec 9>"$run/nightlight.lock"
    flock 9
    kelvin
    k=$((k + $1))
    [ "$k" -ge "$min" ] || k=$min
    [ "$k" -le "$max" ] || k=$max
    mkdir -p -- "${temp%/*}"
    echo "$k" >"$temp"
    echo $$ >"$run/nightlight.seq"
    exec 9>&-
    show "$k K" $(((max - k) * 100 / (max - min)))
    sleep 0.4
    [ "$(cat "$run/nightlight.seq" 2>/dev/null)" = $$ ] || exit 0
    services status nightlight >/dev/null 2>&1 && exec services restart nightlight
    exit 0
}

case ${1:-toggle} in
-h | --help) help ;;
on) on ;;
off) off ;;
toggle)
    services status nightlight >/dev/null
    case $? in
    0) off ;;
    3) on ;;
    *) exit 1 ;;
    esac
    ;;
warmer) shift_temp -$step ;;
cooler) shift_temp $step ;;
info)
    kelvin
    show "$k K"
    ;;
*) bad "unknown action '$1'" ;;
esac
