#!/bin/sh
set -u

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: desktop volume|mic [info|status|settings|on|off|toggle|up|down]
  or:  desktop brightness up|down
  or:  desktop media play|next|prev
  or:  desktop battery | clock
  or:  desktop timer [info|status]
  or:  desktop cam [info|status|close]
  or:  desktop dns [info|status|restart|logs]
  or:  desktop maint [info|status|retry|logs]
  or:  desktop reboot [info|status|restart]
  or:  desktop usb [info|status|allow|dismiss]
info shows a notification; status prints text; settings opens the manager.
For volume and mic, on unmutes, off mutes, and toggle changes the mute state.
mute remains an alias for toggle.

Handle the media keys and bar clicks: change settings, show who uses the
microphone or camera, inspect services and pending actions.

  -h, --help  show this help

Exit status: 0, 1 on failure, 2 on bad usage.
EOF
}

osd_show() {
    body= timeout=${5:-1500}
    case $topic/$action in
    volume/info)
        body="Middle click: toggle mute · Right click: settings
Scroll: volume" timeout=4000
        ;;
    esac
    set -- -a "$2" -u low -e -t "$timeout" -h "string:x-dunst-stack-tag:osd-$1" \
        ${4:+-h "int:value:$4"} "$3"
    [ -z "$body" ] || set -- "$@" "$body"
    notify-send "$@" 2>/dev/null
}

volume() {
    v=$(wpctl get-volume "$1") || exit 1
    p=$(printf '%s\n' "$v" | awk '{ printf "%d", $2 * 100 + 0.5 }')
    if [ "$action" = status ]; then
        case $v in *MUTED*) printf 'off\n' ;; *) printf 'on\n' ;; esac
        printf 'volume=%s\n' "$p"
        return 0
    fi
    case $v in
    *MUTED*) osd_show "$2" "$3" "Muted" 0 ;;
    *)
        osd_show "$2" "$3" "$p%" "$p"
        ;;
    esac
}

brightness() {
    p=$(brightnessctl -m 2>/dev/null | cut -d, -f4) || exit 1
    p=${p%\%}
    osd_show brightness " Brightness" "$p%" "$p"
}

battery() {
    # sum over the batteries, in energy (uWh/uW) or charge (uAh/uA)
    t=$(cat /sys/class/power_supply/BAT*/uevent 2>/dev/null | awk -F= '
		$1 ~ /_STATUS$/ { st = st == "" || $2 != "Full" ? $2 : st }
		$1 ~ /_(ENERGY|CHARGE)_NOW$/ { now += $2 }
		$1 ~ /_(ENERGY|CHARGE)_FULL$/ { full += $2 }
		$1 ~ /_(POWER|CURRENT)_NOW$/ { rate += $2 < 0 ? -$2 : $2 }
		END {
			if (st == "") exit 1
			# the percentage, a tab, then the text
			p = full > 0 ? int(now * 100 / full + 0.5) : 0
			if (p > 100) p = 100
			if (st == "Full") { print p "\tFully charged"; exit }
			if (rate <= 0) { print p "\t" p "% · " (st == "Charging" ? "Charging" : "Not charging"); exit }
			h = st == "Charging" ? (full - now) / rate : now / rate
			m = int(h * 60 + 0.5)
			left = m < 60 ? m "m" : int(m / 60) "h " sprintf("%02d", m % 60) "m"
			print p "\t" p "% · " left " " (st == "Charging" ? "until full" : "remaining")
		}') || {
        osd_show battery " Battery" "No battery"
        exit 0
    }
    tab=$(printf '\t')
    osd_show battery " Battery" "${t#*"$tab"}" "${t%%"$tab"*}" 3000
}

player() {
    sleep "$1"
    st=$(playerctl status 2>/dev/null) || {
        osd_show player " Media" "No player"
        exit 0
    }
    a=$(playerctl metadata artist 2>/dev/null)
    t=$(playerctl metadata title 2>/dev/null)
    [ -n "$a" ] && [ -n "$t" ] && t="$a - $t"
    osd_show player " Media" "$st${t:+ · $t}"
}

notice() { # app summary [body] [ms]
    notify-send -a "$1" -u low -e -t "${4:-4000}" "$2" ${3:+"$3"} 2>/dev/null
}

# the programs on PipeWire's recording streams: the sound card itself is
# open by PipeWire only
mic() {
    streams=$(pactl list source-outputs 2>/dev/null) || return 1
    who=$(printf '%s\n' "$streams" | awk -F' = ' '
		/^Source Output #/ { if (app != "") print app; app = ""; bin = 0; next }
		/application\.process\.binary = / { gsub(/"/, "", $2); app = $2; bin = 1; next }
		/application\.name = / && !bin { gsub(/"/, "", $2); app = $2 }
		END { if (app != "") print app }' | sort -u | paste -sd , - | sed 's/,/, /g')
    if [ "$action" = status ]; then
        volume @DEFAULT_AUDIO_SOURCE@ mic " Microphone"
        printf 'in_use=%s\n' "${who:-none}"
        return 0
    fi
    level=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@) || return 1
    if [ -n "$who" ]; then summary="In use by $who"; else summary="Not in use"; fi
    notice " Microphone" "$summary" \
        "$level
Middle click: toggle mute · Right click: settings
Scroll: microphone level"
}

# hidepid shows only this user's programs, the only ones it could close too
campids() { fuser /dev/video* 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' | sort -u; }

camnames() { # pids -> names
    [ -n "$1" ] || return 0
    ps -o comm= -p "$(echo "$1" | paste -sd, -)" | sort -u | paste -sd , - | sed 's/,/, /g'
}

cam() {
    pids=$(campids)
    if [ "$action" = status ]; then
        if [ -n "$pids" ]; then
            printf 'on\n'
            ps -o pid=,comm= -p "$(printf '%s\n' "$pids" | paste -sd, -)"
        else
            printf 'off\n'
        fi
        return 0
    fi
    if [ -n "$pids" ]; then summary="In use by $(camnames "$pids")"; else summary="Not in use"; fi
    notice " Webcam" "$summary" "Middle click: close apps · Right click: details"
}

cam_close() {
    pids=$(campids)
    [ -n "$pids" ] || {
        notice " Webcam" "Not in use"
        exit 0
    }
    a=$(notify-send -a " Webcam" -u normal -t 10000 -A close=Close -A keep=Cancel \
        "Close $(camnames "$pids")?" "They lose what they have not saved" 2>/dev/null)
    [ "$a" = close ] || exit 0
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null
}

dns() {
    l=$(logs -n service dnscrypt-proxy boot 2>/dev/null | tail -n 1)
    body=${l:-dnscrypt-proxy logged nothing since boot}
    choice=$(notify-send -a " DNS" -u low -t 10000 \
        -A restart=Restart -A logs=Logs "DNS needs attention" "$body
Middle click: restart · Right click: logs" 2>/dev/null) || return 0
    case $choice in
    restart) exec "$0" dns restart ;;
    logs) exec "$0" dns logs ;;
    esac
}

# the jobs that failed at their last run, from what maint leaves readable
maint_failed() { sed -n 's/^failed=//p' /var/lib/maint-status 2>/dev/null; }

maint() {
    f=$(maint_failed)
    if [ -n "$f" ]; then
        choice=$(notify-send -a "󰖷 Maintenance" -u low -t 10000 \
            -A retry=Retry -A logs=Logs "Failed: $f" \
            "Middle click: retry · Right click: logs" 2>/dev/null) || return 0
        case $choice in
        retry) maint_retry ;;
        logs) exec "$0" maint logs ;;
        esac
    else
        notice "󰖷 Maintenance" "Every job went fine" "Right click: logs"
    fi
}

maint_retry() {
    f=$(maint_failed)
    # names written by maint, checked anyway since they go to doas
    case $f in '' | *[!a-z\ ]*) exit 0 ;; esac
    # shellcheck disable=SC2016,SC2086
    exec foot -H doas sh -c 'for j; do /usr/local/sbin/maint "$j"; done' sh $f
}

# a newer kernel than the running one: which, and the reboot it waits for
reboot_ask() {
    run=$(uname -r)
    new=$(for d in /usr/lib/modules/*/; do
        [ -e "${d}modules.dep" ] || continue
        d=${d%/}
        printf '%s\n' "${d##*/}"
    done | sort -V | tail -n 1)
    if [ "$action" = status ]; then
        printf 'running=%s\ninstalled=%s\n' "$run" "${new:-unknown}"
        return 0
    fi
    if [ -z "$new" ] || [ "$new" = "$run" ]; then
        notice "󰜉 Reboot" "Running the newest kernel" "$run
Middle click: restart · Right click: details"
        return
    fi
    a=$(notify-send -i g0wm-reboot -a "󰜉 Reboot" -t 15000 -A reboot="󰜉 Reboot" \
        "Restart to use the new kernel" "running $run · installed $new
Middle click: restart · Right click: details" 2>/dev/null)
    if [ "$a" = reboot ]; then exec power reboot; fi
}

# the USB devices usb left blocked with no answer: "ID PORT NAME" lines
usb_pending() {
    d=${XDG_RUNTIME_DIR:-/tmp}/usb-dismissed
    [ -r /run/usb-pending ] || return 0
    while read -r id port name; do
        [ -n "$id" ] || continue
        [ -r "$d" ] && grep -qx "$id" "$d" && continue
        printf '%s %s %s\n' "$id" "$port" "$name"
    done </run/usb-pending
}

usb_allow() {
    case $1 in *[!0-9.-]* | '') return 1 ;; esac
    exec foot -H usb allow "$1"
}

usb_ask() {
    l=$(usb_pending)
    [ -n "$l" ] || {
        notice "󰕓 USB" "Nothing is waiting"
        return
    }
    first=$(printf '%s\n' "$l" | head -n 1)
    port=$(printf '%s' "$first" | cut -d' ' -f2)
    names=$(printf '%s\n' "$l" | cut -d' ' -f3- | paste -sd , - | sed 's/,/, /g')
    if [ "$action" = allow ]; then usb_allow "$port"; fi
    a=$(notify-send -i g0wm-usb -a "󰕓 USB" -t 15000 -A allow="Allow $port" -A dismiss="Hide" \
        "Left blocked" "$names
Middle click: allow first device · Right click: details" 2>/dev/null)
    case $a in
    allow) usb_allow "$port" ;;
    dismiss) usb_dismiss ;;
    esac
}

# Hidden until plugged in again, which gives a new id.
usb_dismiss() {
    usb_pending | cut -d' ' -f1 >>"${XDG_RUNTIME_DIR:-/tmp}/usb-dismissed"
    pkill -USR1 -u "$(id -u)" -x g0wm-status.sh 2>/dev/null || :
}

[ $# -le 2 ] || bad "extra operand '$3'"
topic=${1:-} action=${2:-info}
case $topic/$action in
-h/info | --help/info)
    help
    exit 0
    ;;
volume/info | volume/status | volume/settings | volume/on | volume/off | volume/toggle | volume/mute | volume/up | volume/down | \
    mic/info | mic/status | mic/settings | mic/on | mic/off | mic/toggle | mic/mute | mic/up | mic/down | \
    brightness/up | brightness/down | media/play | media/next | media/prev | \
    battery/info | clock/info | cam/info | cam/status | cam/close | \
    dns/info | dns/status | dns/restart | dns/logs | maint/info | maint/status | maint/retry | maint/logs | \
    reboot/info | reboot/status | reboot/restart | usb/info | usb/status | usb/allow | usb/dismiss | timer/info | timer/status) ;;
/info) bad "missing action" ;;
*) bad "unknown action '$*'" ;;
esac

case $topic/$action in
volume/on | volume/off | volume/toggle | volume/mute | volume/up | volume/down | \
    mic/on | mic/off | mic/toggle | mic/mute | mic/up | mic/down)
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/osd.lock"
    flock 9
    ;;
esac

case $topic in
volume | mic)
    if [ "$topic" = volume ]; then target=@DEFAULT_AUDIO_SINK@; else target=@DEFAULT_AUDIO_SOURCE@; fi
    case $action in
    up) wpctl set-volume -l 1 "$target" 5%+ || exit 1 ;;
    down) wpctl set-volume "$target" 5%- || exit 1 ;;
    on) wpctl set-mute "$target" 0 || exit 1 ;;
    off) wpctl set-mute "$target" 1 || exit 1 ;;
    toggle | mute) wpctl set-mute "$target" toggle || exit 1 ;;
    esac
    case $action in
    on | off | toggle | mute | up | down) pkill -USR1 -u "$(id -u)" -x g0wm-status.sh 2>/dev/null || : ;;
    esac
    ;;
esac

case $topic/$action in
volume/settings) exec audio ;;
mic/settings) exec audio -t 2 ;;
volume/info | volume/status | volume/on | volume/off | volume/toggle | volume/mute | volume/up | volume/down)
    volume "$target" volume " Volume"
    ;;
mic/info | mic/status) mic ;;
mic/on | mic/off | mic/toggle | mic/mute | mic/up | mic/down) volume "$target" mic " Microphone" ;;
brightness/up) brightnessctl -q s 10%+ 2>/dev/null && brightness ;;
brightness/down) brightnessctl -q s 10%- 2>/dev/null && brightness ;;
media/play)
    playerctl play-pause 2>/dev/null
    player 0.2
    ;;
media/next)
    playerctl next 2>/dev/null
    player 0.4
    ;;
media/prev)
    playerctl previous 2>/dev/null
    player 0.4
    ;;
battery/info) battery ;;
clock/info) osd_show clock " Date" "$(date '+%-d/%-m/%Y %H:%M:%S')" '' 3000 ;;
cam/info | cam/status) cam ;;
cam/close) cam_close ;;
dns/info) dns ;;
dns/status)
    state=$(systemctl is-active dnscrypt-proxy.service)
    code=$?
    case $code in 0 | 3) printf '%s\n' "$state" ;; *) exit 1 ;; esac
    ;;
dns/restart) exec foot -H doas systemctl restart dnscrypt-proxy.service ;;
dns/logs) exec foot logs -p service dnscrypt-proxy boot ;;
maint/info) maint ;;
maint/status) exec cat /var/lib/maint-status ;;
maint/retry) maint_retry ;;
maint/logs) exec foot logs -p service maint ;;
reboot/info | reboot/status) reboot_ask ;;
reboot/restart) exec power reboot ;;
usb/info | usb/allow) usb_ask ;;
usb/status) exec usb list ;;
usb/dismiss) usb_dismiss ;;
timer/info) exec timer info ;;
timer/status) exec timer status ;;
esac
