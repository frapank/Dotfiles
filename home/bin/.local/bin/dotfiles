#!/bin/sh
set -u

usage() {
    cat <<EOF
Usage: dotfiles [COMMAND]
List the commands these dotfiles add: first the ones to use by hand, then,
dimmed, the helpers behind the g0wm keys and the default apps.
With COMMAND, show its --help.
EOF
}

TOOLS='Files
open|open files with their default app, text right in the terminal
extract|unpack archives of any format, never overwrites
compress|pack or encrypt files, the format comes from the name
metadata-remover|strip camera, GPS and author data, offline in a sandbox
Privacy
traces|show and delete histories, recent files, thumbnails, clipboard
privacy-check|check MAC, DNS, firewall, AppArmor, camera and microphone
conns|the open connections and the programs behind them
isolate|run a command in a sandbox: empty home, no network
Snapshots of /home
snap|the older versions of a file, copy one back
forget|delete a file from every snapshot, for good
System
logs|system logs in local time: errors, crashes, AppArmor, firewall
services|the programs g0wm keeps running: idle lock, nightlight...
maint|snapshots, updates and cleanup, run by itself (doas maint status)
dotfiles|this list'

HELPERS='screenshot|Print, Shift: screen, Ctrl: edit
record|Super+Print, Shift: region, Ctrl: no audio
nightlight|Super+=
awake|Super+-
photo video pdf office browser files audio|the default app
wifi bluetooth|their manager, or on/off
open-default|what photo, video, pdf... run
g0wm-status.sh|the text of the bar'

if [ -t 1 ]; then
    B=$(printf '\033[1m') D=$(printf '\033[2m') O=$(printf '\033[0m')
else
    B= D= O=
fi

where() {
    command -v -- "$1" 2>/dev/null && return 0
    for d in /usr/local/sbin /usr/local/bin; do
        [ -x "$d/$1" ] && {
            echo "$d/$1"
            return 0
        }
    done
    return 1
}

tool() { printf '%s\n' "$TOOLS" | grep -q "^$1|"; }

list() {
    printf '%s\n' "$TOOLS" | while IFS='|' read -r name what; do
        if [ -z "$what" ]; then
            printf '\n%s%s%s\n' "$B" "$name" "$O"
        elif where "$name" >/dev/null; then
            printf '  %s%-17s%s %s\n' "$B" "$name" "$O" "$what"
        else
            printf '  %s%-17s %s (not installed)%s\n' "$D" "$name" "$what" "$O"
        fi
    done
    printf '\n%sg0wm helpers%s\n' "$D" "$O"
    printf '%s\n' "$HELPERS" | while IFS='|' read -r names what; do
        if [ "${#names}" -le 17 ]; then
            printf '  %s%-17s %s%s\n' "$D" "$names" "$what" "$O"
        else
            printf '  %s%s: %s%s\n' "$D" "$names" "$what" "$O"
        fi
    done
    printf "\nEach one has --help: 'dotfiles NAME' shows it.\n"
}

case ${1:-} in
'') list ;;
-h | --help | help) usage ;;
-*)
    echo "dotfiles: unknown option '$1'" >&2
    echo "Try 'dotfiles --help' for more information." >&2
    exit 2
    ;;
*)
    # helpers have no --help and would just run
    tool "$1" || {
        echo "dotfiles: '$1' is not one of the commands, see 'dotfiles'" >&2
        exit 2
    }
    p=$(where "$1") || {
        echo "dotfiles: $1 is not installed" >&2
        exit 1
    }
    [ "$1" != maint ] || {
        echo "maint: snapshots, updates and cleanup, run by the maint service every hour"
        exec cat <<EOF

  doas maint status    when each job last ran, the snapshots, the last scrub
  doas maint run       every job that is due
  doas maint JOB       one job now: home thumbs trash update kernels packages
                       firmware scrub blocklist
  logs service maint   what it did
EOF
    }
    exec "$p" --help
    ;;
esac
