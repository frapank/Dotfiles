#!/bin/sh
set -u

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: dotfiles [COMMAND]
List the commands these dotfiles add: first the ones to use by hand, then,
dimmed, the helpers behind the g0wm keys and the default apps.
With COMMAND, show its --help.

  -h, --help  show this help

Examples:
  dotfiles
  dotfiles timer

Exit status: 0, 1 if COMMAND is not installed, 2 on bad usage.
EOF
}

TOOLS='Files
open|open files with their default app, text right in the terminal
extract|unpack archives of any format, never overwrites
compress|pack or encrypt files, the format comes from the name
torrent|search multiple torrent sources, select with fzf and download with aria2
metadata|strip camera, GPS and author data, offline in a sandbox
Privacy
traces|show and delete histories, recent files, thumbnails, clipboard
conns|the open connections and the programs behind them
isolate|run a command in a sandbox: empty home, no network
failed-logins|the wrong passwords since the last login, told at every login
Shell
tmux-project|a tmux session per folder, from zoxide (prefix f)
ding|notify when a command ends: ding make, or make; ding
timer|a countdown with a notification: timer 25m tea; timer status lists them
qr|show text as a QR code, read one from the screen (qr scan)
colorpick|click a pixel, copy its color as #rrggbb
Snapshots of /home
snap|the older versions of a file, copy one back, what changed since a day
forget|delete a file from every snapshot, for good
System
why|why a package is installed, or which package ships a file
logs|system logs in local time: errors, crashes, AppArmor, firewall
hardening|kernel protections, persistent exceptions and reset to defaults (doas hardening)
services|the programs g0wm keeps running: status, start, stop, logs...
maint|snapshots, updates and cleanup, run by itself (doas maint status)
dotfiles|this list'

HELPERS='screenshot|Print, Shift: screen, Ctrl: edit
record|Super+Print, Shift: region, Ctrl: no audio
nightlight|Super+=
awake|Super+-
desktop|the media keys, bar clicks, devices and service notifications
osd indicator|compatibility names for desktop
logins metadata-remover|compatibility names for failed-logins and metadata
power|the power key: sleep, reboot, shut down
photo video pdf office browser files audio|the default app
wifi bluetooth|their manager, or on/off/toggle/status/info/settings
open-default|what photo, video, pdf... run
g0wm-status.sh|the text of the bar
start-g0wm|g0wm after the login on tty1'

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$(printf '\033[1m') D=$(printf '\033[2m') O=$(printf '\033[0m')
else
    B= D= O=
fi

where() {
    command -v -- "$1" 2>/dev/null && return 0
    for d in /usr/local/sbin /usr/local/bin; do
        [ -x "$d/$1" ] && {
            echo "$d/$1"
            return 0
        }
    done
    return 1
}

# the helpers with a --help, the default apps and the session scripts have none
HELPED='screenshot record nightlight awake desktop osd indicator power wifi bluetooth open-default logins metadata-remover'

tool() {
    printf '%s\n' "$TOOLS" | grep -q "^$1|" && return 0
    case " $HELPED " in *" $1 "*) return 0 ;; esac
    return 1
}

list() {
    printf '%s\n' "$TOOLS" | while IFS='|' read -r name what; do
        if [ -z "$what" ]; then
            printf '\n%s%s%s\n' "$B" "$name" "$O"
        elif where "$name" >/dev/null; then
            printf '  %s%-17s%s %s\n' "$B" "$name" "$O" "$what"
        else
            printf '  %s%-17s %s (not installed)%s\n' "$D" "$name" "$what" "$O"
        fi
    done
    printf '\n%sg0wm helpers%s\n' "$D" "$O"
    printf '%s\n' "$HELPERS" | while IFS='|' read -r names what; do
        if [ "${#names}" -le 17 ]; then
            printf '  %s%-17s %s%s\n' "$D" "$names" "$what" "$O"
        else
            printf '  %s%s: %s%s\n' "$D" "$names" "$what" "$O"
        fi
    done
    printf "\n'dotfiles NAME' shows its --help.\n"
}

[ $# -le 1 ] || bad "extra operand '$2'"

case ${1:-} in
'') list ;;
-h | --help | help) help ;;
-*) bad "unrecognized option '$1'" ;;
*)
    # the default apps have no --help and would just run
    tool "$1" || bad "unknown command '$1'"
    p=$(where "$1") || {
        err "$1 is not installed"
        exit 1
    }
    [ "$1" != maint ] || {
        echo "maint: snapshots, updates and cleanup, run by the maint service every hour"
        exec cat <<EOF

  doas maint status [JOB]  state, last success, next due time and job details
  doas maint plan [JOB]    show what is due and what would be postponed
  doas maint logs [JOB]    latest job output, or the maintenance journal
  doas maint retry [JOB]   retry failures, waiting for the current run
  doas maint run          every job that is due
  doas maint JOB          one job now: home thumbs trash update disks kernels packages
                          firmware integrity cves vesktop scrub blocklist
EOF
    }
    exec "$p" --help
    ;;
esac
