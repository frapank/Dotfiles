#!/bin/sh
set -u

usage() {
    cat <<EOF
Usage: awake [on|off|toggle|longer|shorter|info]
Keep the screen from locking by itself; it still locks before sleep. The eye
in the bar shows it is on.

  on, off, toggle  turn it on or off (default: toggle)
  longer, shorter  turn it off 30 minutes later or earlier, up to 8 hours
  info             how long it has been on and how long is left, in the bar
  -h, --help       show this help

Exit status: 0, 1 if the idle service is off, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' awake "$*" >&2
    else
        printf '%s: %s\n' awake "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'awake --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'awake --help' for more information.\n" >&2
    fi
    exit 2
}

# the screen does not lock by itself, it still locks before sleep
run=${XDG_RUNTIME_DIR:-/tmp}
flag=$run/awake
# when it turns itself off, in seconds since 1970; none means never
until=$run/awake.until
step=1800 most=28800

on() {
    rm -f -- "$until"
    : >"$flag"
    services status idle >/dev/null
    case $? in
    0) exec services restart idle ;;
    3)
        rm -f -- "$flag"
        msg="the idle service is off, the screen does not lock by itself anyway: 'services enable idle'"
        echo "awake: $msg" >&2
        [ -t 2 ] || notify-send -a " awake" "$msg" 2>/dev/null
        exit 1
        ;;
    *)
        rm -f -- "$flag"
        exit 1
        ;;
    esac
}

off() {
    rm -f -- "$flag" "$until"
    services status idle >/dev/null 2>&1 || exit 0
    exec services restart idle
}

show() {
    notify-send -a " awake" -u low -e -t "${2:-1500}" -h string:x-dunst-stack-tag:osd-awake \
        "$1" ${3:+"$3"} 2>/dev/null
}

span() { # seconds -> t, as 1h 05m or 25m
    t=$((($1 + 59) / 60))
    if [ "$t" -ge 60 ]; then
        t=$((t / 60))h\ $(printf '%02d' $((t % 60)))m
    else
        t=${t}m
    fi
}

left() { # -> end, the time it turns off, empty for never; rem, seconds to it
    end=$(cat "$until" 2>/dev/null) || end=
    case $end in *[!0-9]*) end= ;; esac
    rem=$((${end:-0} - $(date +%s)))
}

# the wheel: half an hour more or less; down from never starts at 2h, up past
# 8h is never again, and down to nothing turns it off
change() {
    [ -e "$flag" ] || exit 0
    exec 9>"$run/awake.lock"
    flock 9
    left
    now=$(date +%s)
    if [ -z "$end" ]; then
        [ "$1" -lt 0 ] || {
            show "Until turned off"
            exit 0
        }
        rem=$((4 * step))
    else
        # on the half hour, so the steps read 1h 30m and not 1h 27m
        rem=$(((rem + step - 1) / step * step + $1))
    fi
    if [ "$rem" -le 0 ]; then
        show "Off"
        off
    elif [ "$rem" -gt "$most" ]; then
        rm -f -- "$until"
        show "Until turned off"
    else
        echo $((now + rem)) >"$until"
        span "$rem"
        show "For $t"
        # the timer, one at a time; it lives on after this script
        "$0" wait </dev/null >/dev/null 2>&1 9>&- &
    fi
}

# turns it off when the time is up; checks often, the wheel moves the time
wait_end() {
    exec 8>"$run/awake.wait"
    flock -n 8 || exit 0
    while [ -e "$flag" ]; do
        left
        [ -n "$end" ] || exit 0
        if [ "$rem" -le 0 ]; then
            exec 8>&-
            show "Off" 3000 "the screen locks by itself again"
            off
        fi
        [ "$rem" -le 30 ] || rem=30
        sleep "$rem"
    done
}

info() {
    [ -e "$flag" ] || {
        show "Off"
        exit 0
    }
    span $(($(date +%s) - $(stat -c %Y "$flag")))
    since="On for $t"
    left
    if [ -n "$end" ]; then
        span "$rem"
        show "$since" 3000 "$t left"
    else
        show "$since" 3000 "until turned off"
    fi
}

case ${1:-toggle} in
-h | --help) help ;;
on) on ;;
off) off ;;
toggle) if [ -e "$flag" ]; then off; else on; fi ;;
longer) change "$step" ;;
shorter) change "-$step" ;;
info) info ;;
wait) wait_end ;;
*) bad "unknown action '$1'" ;;
esac
