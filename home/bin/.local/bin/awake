#!/bin/sh
set -u

# the screen does not lock by itself, it still locks before sleep
flag=${XDG_RUNTIME_DIR:-/tmp}/awake

on() {
    : >"$flag"
    services status idle >/dev/null
    case $? in
    0) exec services restart idle ;;
    3)
        rm -f -- "$flag"
        msg="the idle service is off, the screen does not lock by itself anyway: 'services enable idle'"
        echo "awake: $msg" >&2
        [ -t 2 ] || notify-send -a awake "$msg" 2>/dev/null
        exit 1
        ;;
    *) rm -f -- "$flag"; exit 1 ;;
    esac
}

off() {
    rm -f -- "$flag"
    services status idle >/dev/null 2>&1 || exit 0
    exec services restart idle
}

case ${1:-toggle} in
on) on ;;
off) off ;;
toggle) if [ -e "$flag" ]; then off; else on; fi ;;
*) echo "usage: awake [on|off|toggle]" >&2; exit 2 ;;
esac
