#!/bin/sh
set -u

usage() {
    cat <<EOF
Usage: osd volume up|down|mute
  or:  osd mic up|down|mute
  or:  osd brightness up|down
  or:  osd media play|next|prev
  or:  osd battery | clock
Change the volume, the brightness or the music, and show the result in the
bar: what the media keys and the clicks on the bar run.

  -h, --help  show this help

Exit status: 0, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' osd "$*" >&2
    else
        printf '%s: %s\n' osd "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'osd --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'osd --help' for more information.\n" >&2
    fi
    exit 2
}

show() {
    notify-send -a "$2" -u low -e -t "${5:-1500}" -h "string:x-dunst-stack-tag:osd-$1" \
        ${4:+-h "int:value:$4"} "$3" 2>/dev/null
}

volume() {
    # the bar redraws its volume icon now instead of at its next read
    pkill -USR1 -u "$(id -u)" -x g0wm-status.sh 2>/dev/null
    v=$(wpctl get-volume "$1") || exit 1
    case $v in
    *MUTED*) show "$2" "$3" "Muted" 0 ;;
    *)
        p=$(echo "$v" | awk '{ printf "%d", $2 * 100 + 0.5 }')
        show "$2" "$3" "$p%" "$p"
        ;;
    esac
}

brightness() {
    p=$(brightnessctl -m 2>/dev/null | cut -d, -f4) || exit 1
    p=${p%\%}
    show brightness " Brightness" "$p%" "$p"
}

battery() {
    # sum over the batteries, in energy (uWh/uW) or charge (uAh/uA)
    t=$(cat /sys/class/power_supply/BAT*/uevent 2>/dev/null | awk -F= '
		$1 ~ /_STATUS$/ { st = st == "" || $2 != "Full" ? $2 : st }
		$1 ~ /_(ENERGY|CHARGE)_NOW$/ { now += $2 }
		$1 ~ /_(ENERGY|CHARGE)_FULL$/ { full += $2 }
		$1 ~ /_(POWER|CURRENT)_NOW$/ { rate += $2 < 0 ? -$2 : $2 }
		END {
			if (st == "") exit 1
			# the percentage, a tab, then the text
			p = full > 0 ? int(now * 100 / full + 0.5) : 0
			if (p > 100) p = 100
			if (st == "Full") { print p "\tFully charged"; exit }
			if (rate <= 0) { print p "\t" p "% · " (st == "Charging" ? "Charging" : "Not charging"); exit }
			h = st == "Charging" ? (full - now) / rate : now / rate
			m = int(h * 60 + 0.5)
			left = m < 60 ? m "m" : int(m / 60) "h " sprintf("%02d", m % 60) "m"
			print p "\t" p "% · " left " " (st == "Charging" ? "until full" : "remaining")
		}') || {
        show battery " Battery" "No battery"
        exit 0
    }
    tab=$(printf '\t')
    show battery " Battery" "${t#*"$tab"}" "${t%%"$tab"*}" 3000
}

player() {
    sleep "$1"
    st=$(playerctl status 2>/dev/null) || {
        show player " Media" "No player"
        exit 0
    }
    a=$(playerctl metadata artist 2>/dev/null)
    t=$(playerctl metadata title 2>/dev/null)
    [ -n "$a" ] && [ -n "$t" ] && t="$a - $t"
    show player " Media" "$st${t:+ · $t}"
}

# one wheel notch after another, so none reads a volume the next one changes
case ${1:-} in volume | mic)
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/osd.lock"
    flock 9
    ;;
esac

case ${1:-}/${2:-} in
-h/ | --help/) help ;;
volume/up) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && volume @DEFAULT_AUDIO_SINK@ volume " Volume" ;;
volume/down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && volume @DEFAULT_AUDIO_SINK@ volume " Volume" ;;
volume/mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && volume @DEFAULT_AUDIO_SINK@ volume " Volume" ;;
mic/mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && volume @DEFAULT_AUDIO_SOURCE@ mic " Microphone" ;;
mic/up) wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+ && volume @DEFAULT_AUDIO_SOURCE@ mic " Microphone" ;;
mic/down) wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%- && volume @DEFAULT_AUDIO_SOURCE@ mic " Microphone" ;;
brightness/up) brightnessctl -q s 10%+ 2>/dev/null && brightness ;;
brightness/down) brightnessctl -q s 10%- 2>/dev/null && brightness ;;
media/play)
    playerctl play-pause 2>/dev/null
    player 0.2
    ;;
media/next)
    playerctl next 2>/dev/null
    player 0.4
    ;;
media/prev)
    playerctl previous 2>/dev/null
    player 0.4
    ;;
battery/) battery ;;
clock/) show clock " Date" "$(date '+%-d/%-m/%Y %H:%M:%S')" '' 3000 ;;
'/') bad "missing action" ;;
*) bad "unknown action '$*'" ;;
esac
