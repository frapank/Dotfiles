#!/bin/sh
set -u

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: bluetooth [on|off|toggle|status|info|settings]
Turn the Bluetooth adapter on or off. With no argument, open the device
manager. It is off at every boot.

  on, off, toggle  turn the adapter on or off
  status           print the current state
  info             whether it is on and what is connected, in the bar
  settings         open the device settings (default)
  -h, --help       show this help

Exit status: 0, 1 if the adapter refuses, 2 on bad usage.
EOF
}

show() {
    notify-send -a "󰂯 Bluetooth" -u low -e -t 1500 -h string:x-dunst-stack-tag:osd-bluetooth \
        "$1" ${2:+"$2"} 2>/dev/null
}

read_state() {
    state=$(bluetoothctl show) || return 1
    case $state in
    *'Powered: yes'*) state=on ;;
    *'Powered: no'*) state=off ;;
    *)
        err "no adapter state available"
        return 1
        ;;
    esac
}

[ $# -le 1 ] || bad "extra operand '$2'"

case ${1:-} in
-h | --help)
    help
    exit 0
    ;;
on | off) exec bluetoothctl power "$1" ;;
toggle)
    read_state || exit 1
    if [ "$state" = on ]; then exec bluetoothctl power off; else exec bluetoothctl power on; fi
    ;;
status)
    read_state || exit 1
    printf '%s\n' "$state"
    ;;
info)
    read_state || exit 1
    if [ "$state" = on ]; then
        show "On" "$(bluetoothctl devices Connected 2>/dev/null | cut -d' ' -f3- | paste -sd, - | sed 's/,/, /g')
Right click: settings"
    else
        show "Off"
    fi
    ;;
'' | settings) exec blueman-manager ;;
*) bad "unknown action '$1'" ;;
esac
