#!/bin/sh
set -u

# what the mic, cam, dns, maint, timer, reboot and usb icons of the bar do when clicked
usage() {
    cat <<EOF
Usage: indicator mic | cam [close] | timer | reboot
  or:  indicator dns [restart|logs] | maint [retry|logs]
  or:  indicator usb [dismiss]
What the icons of the bar do when clicked: a notification that tells who
uses the microphone or the webcam, what failed, what waits.

  mic          who is recording from the microphone
  cam          who has the webcam open
  cam close    close them, after a notification asks
  dns          the last thing the DNS resolver logged
  dns restart  restart it, in a terminal for doas
  dns logs     what it logged since boot, in a terminal
  maint        which jobs of maint failed
  maint retry  run them again, in a terminal for doas
  maint logs   what maint logged, in a terminal
  timer        the timers and when they ring
  reboot       which kernel waits for a reboot, and a button to do it
  usb          the USB devices left blocked, and a button to allow the first
  usb dismiss  hide them from the bar until they are plugged in again
  -h, --help   show this help

Exit status: 0, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' indicator "$*" >&2
    else
        printf '%s: %s\n' indicator "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'indicator --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'indicator --help' for more information.\n" >&2
    fi
    exit 2
}

show() { # app summary [body] [ms]
    notify-send -a "$1" -u low -e -t "${4:-4000}" "$2" ${3:+"$3"} 2>/dev/null
}

# the programs on PipeWire's recording streams: the sound card itself is
# open by PipeWire only
mic() {
    who=$(pactl list source-outputs 2>/dev/null | awk -F' = ' '
		/^Source Output #/ { if (app != "") print app; app = ""; bin = 0; next }
		/application\.process\.binary = / { gsub(/"/, "", $2); app = $2; bin = 1; next }
		/application\.name = / && !bin { gsub(/"/, "", $2); app = $2 }
		END { if (app != "") print app }' | sort -u | paste -sd , - | sed 's/,/, /g')
    if [ -n "$who" ]; then
        show " Microphone" "In use by $who"
    else
        show " Microphone" "Not in use"
    fi
}

# hidepid shows only this user's programs, the only ones it could close too
campids() { fuser /dev/video* 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' | sort -u; }

camnames() { # pids -> names
    [ -n "$1" ] || return 0
    ps -o comm= -p "$(echo "$1" | paste -sd, -)" | sort -u | paste -sd , - | sed 's/,/, /g'
}

cam() {
    pids=$(campids)
    if [ -n "$pids" ]; then
        show " Webcam" "In use by $(camnames "$pids")"
    else
        show " Webcam" "Not in use"
    fi
}

cam_close() {
    pids=$(campids)
    [ -n "$pids" ] || {
        show " Webcam" "Not in use"
        exit 0
    }
    a=$(notify-send -a " Webcam" -u normal -t 10000 -A close=Close -A keep=Cancel \
        "Close $(camnames "$pids")?" "They lose what they have not saved" 2>/dev/null)
    [ "$a" = close ] || exit 0
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null
}

dns() {
    l=$(logs -n service dnscrypt-proxy boot 2>/dev/null | tail -n 1)
    if [ -z "$l" ]; then
        show " DNS" "Not answering" "dnscrypt-proxy logged nothing since boot"
        return
    fi
    # 2026-10-06 15:31:20 daemon.notice: dnscrypt-proxy: [...] [NOTICE] message
    t=${l#* } t=${t%%:[0-9][0-9] *}
    m=${l##*] }
    show " DNS" "Not answering" "last message at $t: $m"
}

# the jobs that failed at their last run, from what maint leaves readable
maint_failed() { sed -n 's/^failed=//p' /var/lib/maint-status 2>/dev/null; }

maint() {
    f=$(maint_failed)
    if [ -n "$f" ]; then
        show "󰖷 Maintenance" "Failed: $f" "Middle click runs them again, right click shows the log" 8000
    else
        show "󰖷 Maintenance" "Every job went fine"
    fi
}

maint_retry() {
    f=$(maint_failed)
    # names written by maint, checked anyway since they go to doas
    case $f in '' | *[!a-z\ ]*) exit 0 ;; esac
    # shellcheck disable=SC2016,SC2086
    exec foot -H doas sh -c 'for j; do /usr/local/sbin/maint "$j"; done' sh $f
}

# a newer kernel than the running one: which, and the reboot it waits for
reboot_ask() {
    run=$(uname -r)
    new=$(for d in /usr/lib/modules/*/; do
        [ -e "${d}modules.dep" ] || continue
        d=${d%/}
        printf '%s\n' "${d##*/}"
    done | sort -V | tail -n 1)
    if [ -z "$new" ] || [ "$new" = "$run" ]; then
        show "󰜉 Reboot" "Running the newest kernel" "$run"
        return
    fi
    a=$(notify-send -i g0wm-reboot -a "󰜉 Reboot" -t 15000 -A reboot="󰜉 Reboot" \
        "Restart to use the new kernel" "running $run · installed $new" 2>/dev/null)
    [ "$a" = reboot ] && exec loginctl reboot
}

# the USB devices usb left blocked with no answer: "ID PORT NAME" lines
usb_pending() {
    d=${XDG_RUNTIME_DIR:-/tmp}/usb-dismissed
    [ -r /run/usb-pending ] || return 0
    while read -r id port name; do
        [ -n "$id" ] || continue
        [ -r "$d" ] && grep -qx "$id" "$d" && continue
        printf '%s %s %s\n' "$id" "$port" "$name"
    done </run/usb-pending
}

usb_ask() {
    l=$(usb_pending)
    [ -n "$l" ] || {
        show "󰕓 USB" "Nothing is waiting"
        return
    }
    first=$(printf '%s\n' "$l" | head -n 1)
    port=$(printf '%s' "$first" | cut -d' ' -f2)
    names=$(printf '%s\n' "$l" | cut -d' ' -f3- | paste -sd , - | sed 's/,/, /g')
    # usb allow asks for doas: in a terminal
    a=$(notify-send -i g0wm-usb -a "󰕓 USB" -t 15000 -A allow="Allow $port" -A dismiss="Hide" \
        "Left blocked" "$names" 2>/dev/null)
    case $a in
    allow) case $port in *[!0-9.-]* | '') ;; *) exec foot -H doas usb allow "$port" ;; esac ;;
    dismiss) usb_dismiss ;;
    esac
}

# right click: hidden until plugged in again, which gives a new id
usb_dismiss() {
    usb_pending | cut -d' ' -f1 >>"${XDG_RUNTIME_DIR:-/tmp}/usb-dismissed"
    pkill -USR1 -u "$(id -u)" -x g0wm-status.sh 2>/dev/null || :
}

case ${1:-}/${2:-} in
mic/) mic ;;
cam/) cam ;;
cam/close) cam_close ;;
dns/) dns ;;
dns/restart) exec foot -H doas systemctl restart dnscrypt-proxy.service ;;
dns/logs) exec foot logs -p service dnscrypt-proxy boot ;;
maint/) maint ;;
maint/retry) maint_retry ;;
maint/logs) exec foot logs -p service maint ;;
reboot/) reboot_ask ;;
usb/) usb_ask ;;
usb/dismiss) usb_dismiss ;;
timer/) show "󱎫 Timer" "$(timer list)" "Scroll switches the one shown, middle click cancels them" 6000 ;;
-h/ | --help/) help ;;
/) bad "missing action" ;;
*) bad "unknown action '$*'" ;;
esac
