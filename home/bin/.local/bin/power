#!/bin/sh
set -u

usage() {
    cat <<EOF
Usage: power [reboot|poweroff]
The power menu of the power key: sleep, reboot or shut down, picked from a
notification. With an action, it asks to confirm only that one, so an Enter
too many does not end the session.

  reboot, poweroff  ask to confirm only that
  -h, --help        show this help

Exit status: 0, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' power "$*" >&2
    else
        printf '%s: %s\n' power "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'power --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'power --help' for more information.\n" >&2
    fi
    exit 2
}

case ${1:-} in -h | --help)
    help
    exit 0
    ;;
esac

# the power key opens this menu, logind no longer turns off the PC
run=${XDG_RUNTIME_DIR:-/tmp}
exec 9>"$run/power.lock"
flock -n 9 || exit 0

# with an action (the Restart and Shut Down of the runner): only that one, to
# confirm, so an Enter too many does not end the session
case ${1:-} in
'')
    act=$(notify-send -a " power" -t 15000 \
        -A suspend=" Sleep" -A reboot=" Reboot" -A poweroff=" Shut down" \
        "Power" "Sleep, reboot or shut down" 2>/dev/null) || exit 0
    ;;
reboot)
    act=$(notify-send -i g0wm-reboot -a " power" -t 15000 -A reboot=" Reboot" \
        "Reboot?" "What is not saved is lost" 2>/dev/null) || exit 0
    ;;
poweroff)
    act=$(notify-send -i g0wm -a " power" -t 15000 -A poweroff=" Shut down" \
        "Shut down?" "What is not saved is lost" 2>/dev/null) || exit 0
    ;;
*) bad "unknown action '$1'" ;;
esac
case $act in
suspend | reboot | poweroff) ;;
*) exit 0 ;;
esac
exec 9>&-
err=$(loginctl "$act" 2>&1) ||
    notify-send -a " power" -u critical "Cannot $act" "$err" 2>/dev/null
