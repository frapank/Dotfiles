#!/bin/sh
set -u

usage() {
    cat <<EOF
Usage: ding COMMAND [ARG]...
  or:  COMMAND; ding
Notify when COMMAND ends, with its exit status and how long it took; the
terminal also rings, so foot marks itself urgent.
In bash, a bare ding after ';' tells about the command line it ends.

  -h, --help  show this help

Examples:
  ding make
  make -j8; ding

Exit status: the one of COMMAND, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' ding "$*" >&2
    else
        printf '%s: %s\n' ding "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'ding --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'ding --help' for more information.\n" >&2
    fi
    exit 2
}

# seconds as 1h02m03s, 2m03s, 3s
fmt() {
    awk -v t="$1" 'BEGIN {
		h = int(t / 3600); m = int(t % 3600 / 60); s = t % 60
		if (h) printf "%dh%02dm%02ds\n", h, m, s
		else if (m) printf "%dm%02ds\n", m, s
		else printf "%ds\n", s
	}'
}

# -s STATUS -t SECONDS -c TEXT, what the bash function passes
st= secs= cmd=
while [ $# -gt 0 ]; do
    case $1 in
    -h | --help)
        help
        exit 0
        ;;
    -s | -t | -c)
        [ $# -ge 2 ] || exit 2
        case $1 in -s) st=$2 ;; -t) secs=$2 ;; -c) cmd=$2 ;; esac
        shift 2
        ;;
    --)
        shift
        break
        ;;
    *) break ;;
    esac
done

if [ $# -gt 0 ]; then
    cmd=$*
    t0=$(date +%s)
    "$@"
    st=$?
    secs=$(($(date +%s) - t0))
elif [ -z "$st" ]; then
    bad "missing COMMAND"
fi

body=${secs:+"took $(fmt "$secs")"}
if [ "$st" = 0 ]; then
    title="Done" urg=normal
    icon=g0wm-ok
else
    title="Failed ($st)" urg=critical
    icon=g0wm-failed
fi
[ -n "$cmd" ] && body="$cmd${body:+ · $body}"
# a tick on green or a cross on red, from the icons of script/g0wm-theme.py
notify-send -i "$icon" -a " ding" -u "$urg" "$title" "$body" 2>/dev/null
{ printf '\a' >/dev/tty; } 2>/dev/null
exit "$st"
