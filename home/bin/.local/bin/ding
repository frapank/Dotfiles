#!/bin/sh
set -u

usage() {
    cat <<EOF
Usage: ding COMMAND [ARG]...
  or:  COMMAND; ding
Notify when COMMAND ends, with its exit status and how long it took; the
terminal also rings, so foot marks itself urgent. ding exits as COMMAND did.
In bash, a bare ding after ';' tells about the command line it ends.
EOF
}

# the icon of the notification: a tick on green, a cross on red. The colors are
# written by script/g0wm-theme.py
ok_color='#93c2a0'
fail_color='#d8625e'
mark_color='#0a0a0a'

# seconds as 1h02m03s, 2m03s, 3s
fmt() {
    awk -v t="$1" 'BEGIN {
		h = int(t / 3600); m = int(t % 3600 / 60); s = t % 60
		if (h) printf "%dh%02dm%02ds\n", h, m, s
		else if (m) printf "%dm%02ds\n", m, s
		else printf "%ds\n", s
	}'
}

# -s STATUS -t SECONDS -c TEXT, what the bash function passes
st= secs= cmd=
while [ $# -gt 0 ]; do
    case $1 in
    -h | --help)
        usage
        exit 0
        ;;
    -s | -t | -c)
        [ $# -ge 2 ] || exit 2
        case $1 in -s) st=$2 ;; -t) secs=$2 ;; -c) cmd=$2 ;; esac
        shift 2
        ;;
    --)
        shift
        break
        ;;
    *) break ;;
    esac
done

if [ $# -gt 0 ]; then
    cmd=$*
    t0=$(date +%s)
    "$@"
    st=$?
    secs=$(($(date +%s) - t0))
elif [ -z "$st" ]; then
    usage >&2
    exit 2
fi

body=${secs:+"took $(fmt "$secs")"}
if [ "$st" = 0 ]; then
    title="Done" urg=normal
    icon=ok fill=$ok_color mark='M18 33l9 9 19-20'
else
    title="Failed ($st)" urg=critical
    icon=failed fill=$fail_color mark='M21 21l22 22M43 21L21 43'
fi
[ -n "$cmd" ] && body="$cmd${body:+ · $body}"
# g0wm loads svg icons with gdk-pixbuf
icon=${XDG_RUNTIME_DIR:-/tmp}/ding-$icon.svg
printf '<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64"><rect x="2" y="2" width="60" height="60" rx="12" fill="%s"/><path d="%s" fill="none" stroke="%s" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>\n' \
    "$fill" "$mark" "$mark_color" >"$icon" 2>/dev/null || icon=
notify-send ${icon:+-i "$icon"} -a " ding" -u "$urg" "$title" "$body" 2>/dev/null
{ printf '\a' >/dev/tty; } 2>/dev/null
exit "$st"
