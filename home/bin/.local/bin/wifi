#!/bin/sh
set -u

# shellcheck source=root/helpers/usr/local/lib/dotfiles/cli.sh
. /usr/local/lib/dotfiles/cli.sh

usage() {
    cat <<EOF
Usage: wifi [on|off|toggle|status|info|settings]
Turn the Wi-Fi radio on or off. With no argument, open the network settings.

  on, off, toggle  turn the radio on or off
  status           print the current state
  info             whether it is on and the network it is on, in the bar
  settings         open the device settings (default)
  -h, --help       show this help

Exit status: 0, 1 if NetworkManager refuses, 2 on bad usage.
EOF
}

show() {
    notify-send -a "󰖩 Wi-Fi" -u low -e -t 1500 -h string:x-dunst-stack-tag:osd-wifi \
        "$1" ${2:+"$2"} 2>/dev/null
}

read_state() {
    state=$(nmcli radio wifi) || return 1
    case $state in
    enabled) state=on ;;
    disabled) state=off ;;
    *)
        err "unknown radio state: $state"
        return 1
        ;;
    esac
}

[ $# -le 1 ] || bad "extra operand '$2'"

case ${1:-} in
-h | --help)
    help
    exit 0
    ;;
on | off) exec nmcli radio wifi "$1" ;;
toggle)
    read_state || exit 1
    if [ "$state" = on ]; then exec nmcli radio wifi off; else exec nmcli radio wifi on; fi
    ;;
status)
    read_state || exit 1
    printf '%s\n' "$state"
    ;;
info)
    read_state || exit 1
    if [ "$state" = on ]; then
        show "On" "$(nmcli -t -f active,ssid dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -n 1)"
    else
        show "Off"
    fi
    ;;
'' | settings) exec nm-connection-editor ;;
*) bad "unknown action '$1'" ;;
esac
