#!/bin/sh
set -eu

usage() {
    cat <<EOF
Usage: extract ARCHIVE
  or:  extract ARCHIVE... DIR
  or:  extract -d DIR ARCHIVE...
Extract each ARCHIVE into DIR (default: the current directory); the format
comes from the ARCHIVE extension. Passwords are asked when needed.
Existing files are never overwritten.

  -d DIR      extract into DIR, all operands are ARCHIVEs
  -h, --help  show this help

Formats:
  .tar .tar.gz .tgz .tar.bz2 .tbz2 .tar.xz .txz .tar.zst .tzst .tar.lz .tar.lz4
  .zip .7z .rar .gz .bz2 .xz .zst .lz .lz4 .gpg .age .tar.gpg .tar.age
  .iso .cpio .deb .rpm .cab

Examples:
  extract photos.zip
  extract -d ~/Random *.tar.gz

Exit status: 0, 1 on failure, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' extract "$*" >&2
    else
        printf '%s: %s\n' extract "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'extract --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'extract --help' for more information.\n" >&2
    fi
    exit 2
}

die() {
    err "$*"
    exit 1
}

# the output: on a terminal a status label in its color, dimmed headers and
# summaries; plain text in a pipe
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    o_ok=$(printf '\033[32m') o_warn=$(printf '\033[33m') o_fail=$(printf '\033[31m')
    o_dim=$(printf '\033[2m') o_off=$(printf '\033[0m')
else
    o_ok= o_warn= o_fail= o_dim= o_off=
fi

# a status row: ok, warn or fail in its color, or a dimmed info, then the text
row() {
    case $1 in
    ok) printf '  %s%-4s%s  %s\n' "$o_ok" ok "$o_off" "$2" ;;
    warn) printf '  %s%-4s%s  %s\n' "$o_warn" warn "$o_off" "$2" ;;
    fail) printf '  %s%-4s%s  %s\n' "$o_fail" fail "$o_off" "$2" ;;
    *) printf '  %s%-4s  %s%s\n' "$o_dim" info "$2" "$o_off" ;;
    esac
}

# a table header or a summary line, dimmed
dim() { printf '%s%s%s\n' "$o_dim" "$*" "$o_off"; }

# How far a long job got: on a terminal and after a second, a dimmed line on
# standard error with what, the percent and the time left, gone at the end.
# watch_read FILE CMD...: CMD reads FILE from start to end; the position comes
# from the descriptor of whichever process under CMD has it open.
# watch_bytes TOTAL LABEL CMD...: CMD reads TOTAL bytes, of whatever files.
watch_read() {
    w_file=$(realpath -- "$1") w_total=$(stat -c %s -- "$1") w_mode=read w_label=${1##*/}
    shift
    watch_run "$@"
}
watch_bytes() {
    w_file= w_total=$1 w_mode=bytes w_label=$2
    shift 2
    watch_run "$@"
}
watch_run() {
    if ! [ -t 2 ] || [ "${w_total:-0}" -le 0 ]; then
        "$@"
        return
    fi
    "$@" &
    w_pid=$!
    w_t0=$(date +%s%N) w_shown=
    while kill -0 "$w_pid" 2>/dev/null; do
        sleep 0.5
        # in milliseconds
        w_el=$((($(date +%s%N) - w_t0) / 1000000))
        [ "$w_el" -ge 1000 ] || continue
        w_pos=$(watch_pos)
        [ "${w_pos:-0}" -gt 0 ] || continue
        printf '\r\033[K\033[2m%s\033[0m' "$(awk -v p="$w_pos" -v t="$w_total" -v e="$w_el" -v w="$w_label" 'BEGIN {
            # all read but still at work (xz reads ahead): no time to promise
            if (p >= t) { printf "%s  finishing", w; exit }
            l = int(e / 1000 * (t - p) / p + 0.5)
            s = l >= 3600 ? sprintf("%dh %02dm", l / 3600, l % 3600 / 60) : l >= 60 ? sprintf("%dm %02ds", l / 60, l % 60) : l "s"
            printf "%s  %d%%  ~%s left", w, 100 * p / t, s
        }')" >&2
        w_shown=1
    done
    [ -z "$w_shown" ] || printf '\r\033[K' >&2
    wait "$w_pid"
}
# CMD and everything it started: bwrap moves them to a process group of their own
watch_tree() {
    echo "$1"
    # shellcheck disable=SC2013 # the pids are separated by spaces
    for w_c in $(cat /proc/"$1"/task/*/children 2>/dev/null); do watch_tree "$w_c"; done
}
watch_pos() {
    for w_p in $(watch_tree "$w_pid"); do
        if [ "$w_mode" = bytes ]; then
            sed -n 's/^rchar: //p' "/proc/$w_p/io" 2>/dev/null
        else
            for w_fd in /proc/"$w_p"/fd/*; do
                [ "$(readlink -- "$w_fd" 2>/dev/null)" = "$w_file" ] &&
                    sed -n 's/^pos:[[:space:]]*//p' "/proc/$w_p/fdinfo/${w_fd##*/}" 2>/dev/null
            done
        fi
    done | sort -n | tail -n 1
}

# a path as it reads best: relative under here, ~ under the home
short() {
    case $1 in
    "$PWD") echo . ;;
    "$PWD"/*) echo "${1#"$PWD"/}" ;;
    "$HOME") echo "~" ;;
    "$HOME"/*) echo "~/${1#"$HOME"/}" ;;
    *) echo "$1" ;;
    esac
}

askpw() {
    trap 'stty echo </dev/tty' EXIT
    trap 'exit 130' INT TERM
    stty -echo </dev/tty
    printf 'Enter password for %s: ' "$1" >/dev/tty
    IFS= read -r pw </dev/tty
    echo >/dev/tty
    stty echo </dev/tty
}

un7z() {
    if 7z l -slt -p- -- "$f" 2>/dev/null | grep -q '^Encrypted = +' ||
        ! 7z l -p- -- "$f" >/dev/null 2>&1; then
        askpw "$f"
        watch_read "$f" jail 7z x -aos -bso0 -bsp0 -p"$pw" -o"$dir" -- "$f"
    else
        watch_read "$f" jail 7z x -aos -bso0 -bsp0 -o"$dir" -- "$f"
    fi
}

single() {
    out=$dir/$1
    [ ! -e "$out" ] || die "$out: File exists"
    shift
    watch_read "$f" "$@" >"$out" || {
        rm -f -- "$out"
        exit 1
    }
}

gpg() { command gpg -q --no-symkey-cache --pinentry-mode loopback "$@"; }

# gpg and age stay outside the jail, they need the keys
jail() {
    if [ -z "$bwrap" ]; then
        "$@"
        return
    fi
    bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --tmpfs /run \
        --tmpfs "$HOME" --ro-bind "$f" "$f" --bind "$dir" "$dir" --chdir "$dir" \
        --unshare-all --unshare-user --disable-userns --die-with-parent -- "$@"
}

case ${1:-} in help | --help)
    help
    exit 0
    ;;
esac

dir=
for a; do
    case $a in
    --) break ;;
    --*) bad "unrecognized option '$a'" ;;
    -*) ;;
    *) break ;;
    esac
done
while getopts :d:h o; do
    case $o in
    d) dir=$OPTARG ;;
    h)
        help
        exit 0
        ;;
    :) bad "option requires an argument -- '$OPTARG'" ;;
    *) bad "invalid option -- '$OPTARG'" ;;
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || {
    bad "missing file operand"
}

if [ -z "$dir" ]; then
    if [ $# -eq 1 ]; then
        dir=.
    else
        eval "dir=\${$#}"
        n=$# i=0
        for a; do
            i=$((i + 1))
            [ $i -lt $n ] && set -- "$@" "$a"
        done
        shift $n
    fi
fi
[ ! -e "$dir" ] || [ -d "$dir" ] || die "target '$dir' is not a directory"

for f; do
    [ -f "$f" ] || die "$f: No such file or directory"
done
mkdir -p -- "$dir"
dir=$(realpath -- "$dir")
bwrap=$(command -v bwrap) || echo "extract: bwrap missing, the unpackers run without a sandbox" >&2

for f; do
    base=${f##*/}
    f=$(realpath -- "$f")
    case $(printf '%s' "$base" | tr '[:upper:]' '[:lower:]') in
    *.tar.gpg) gpg -d -- "$f" | jail tar -xf - -C "$dir" --skip-old-files ;;
    *.tar.age) age -d -- "$f" | jail tar -xf - -C "$dir" --skip-old-files ;;
    *.tar | *.tar.gz | *.tgz | *.tar.bz2 | *.tbz | *.tbz2 | *.tar.xz | *.txz | *.tar.zst | *.tzst | *.tar.lz | *.tar.lz4)
        watch_read "$f" jail tar -xf "$f" -C "$dir" --skip-old-files
        ;;
    *.zip | *.jar | *.7z) un7z ;;
    *.rar) watch_read "$f" jail unrar x -o- -idq -- "$f" "$dir/" ;;
    *.iso | *.cpio | *.deb | *.rpm | *.cab | *.xar) watch_read "$f" jail bsdtar -xkf "$f" -C "$dir" ;;
    *.gz) single "${base%.*}" jail gzip -dc -- "$f" ;;
    *.bz2) single "${base%.*}" jail bzip2 -dc -- "$f" ;;
    *.xz) single "${base%.*}" jail xz -dc -- "$f" ;;
    *.zst) single "${base%.*}" jail zstd -qdc -- "$f" ;;
    *.lz) single "${base%.*}" jail lzip -qdc -- "$f" ;;
    *.lz4) single "${base%.*}" jail lz4 -qdc -- "$f" ;;
    *.gpg | *.pgp | *.asc)
        out=$dir/${base%.*}
        [ ! -e "$out" ] || die "$out: File exists"
        gpg -o "$out" -d -- "$f"
        ;;
    *.age)
        out=$dir/${base%.*}
        [ ! -e "$out" ] || die "$out: File exists"
        age -d -o "$out" -- "$f"
        ;;
    *.*) die "$f: Unknown archive format" ;;
    *) die "$f: Missing archive extension" ;;
    esac
done
if [ $# -eq 1 ]; then
    dim "Extracted ${1##*/} into $(short "$dir")."
else
    dim "Extracted $# archives into $(short "$dir")."
fi
