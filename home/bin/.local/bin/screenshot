#!/bin/sh
set -eu

usage() {
    cat <<EOF
Usage: screenshot [region|screen|edit]
Take a screenshot: saved in Pictures, copied, and notified; the notification
opens it or edits it.

  region      pick a region with the mouse (default)
  screen      the whole screen, or the one picked with several
  edit        pick a region and edit it in swappy first
  -h, --help  show this help

Exit status: 0, 2 on bad usage.
EOF
}

# the help; on a terminal styled as man does: bold titles, underlined
# placeholders, dimmed examples
help() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        usage | awk -v b="$(printf '\033[1m')" -v u="$(printf '\033[4m')" \
            -v d="$(printf '\033[2m')" -v n="$(printf '\033[0m')" '
            function ul(s, r) {
                while (match(s, /[A-Z][A-Z0-9_]+/)) {
                    r = r substr(s, 1, RSTART - 1) u substr(s, RSTART, RLENGTH) n
                    s = substr(s, RSTART + RLENGTH)
                }
                return r s
            }
            /^$/ { ex = 0 }
            ex { print d $0 n; next }
            /^(Usage|  or):/ {
                i = index($0, ":")
                print b substr($0, 1, i) n ul(substr($0, i + 1))
                next
            }
            /^[A-Z][A-Za-z]*( [a-z]+)?:/ {
                i = index($0, ":")
                ex = $0 == "Examples:"
                print b substr($0, 1, i) n substr($0, i + 1)
                next
            }
            /^  [^ ]/ && match(substr($0, 3), /   *|$/) {
                i = RSTART
                print "  " ul(substr($0, 3, i - 1)) substr($0, i + 2)
                next
            }
            { print }'
    else
        usage
    fi
}

# an error, the name in red on a terminal
err() {
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;31m%s:\033[0m %s\n' screenshot "$*" >&2
    else
        printf '%s: %s\n' screenshot "$*" >&2
    fi
}

# a usage error: what is wrong, then where the help is
bad() {
    err "$*"
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        printf "\033[2mTry 'screenshot --help' for more information.\033[0m\n" >&2
    else
        printf "Try 'screenshot --help' for more information.\n" >&2
    fi
    exit 2
}

mode=region
case $# in
0) ;;
1)
    case $1 in
    -h | --help)
        help
        exit 0
        ;;
    region | screen | edit) mode=$1 ;;
    -*) bad "unrecognized option '$1'" ;;
    *) bad "unknown action '$1'" ;;
    esac
    ;;
*) bad "extra operand '$2'" ;;
esac

geo= out=
if [ "$mode" = screen ]; then
    # shellcheck disable=SC2046
    set -- $(grep -lx connected /sys/class/drm/card*-*/status 2>/dev/null || :)
    if [ $# -gt 1 ]; then
        out=$(slurp -o -f %o) || exit 0
    fi
else
    geo=$(slurp) || exit 0
fi

dir=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME")
mkdir -p "$dir"
file=$dir/shot-$(date +%Y%m%d-%H%M%S).png

grim ${geo:+-g "$geo"} ${out:+-o "$out"} "$file"
[ "$mode" = edit ] && swappy -f "$file" -o "$file"
wl-copy --type image/png <"$file" || :
(
    case $(notify-send -a " screenshot" -u low -A default=Open -A edit=Edit \
        "Screenshot saved" "$file" 2>/dev/null) in
    default) open -- "$file" ;;
    edit) swappy -f "$file" -o "$file" && wl-copy --type image/png <"$file" ;;
    esac
) </dev/null >/dev/null 2>&1 &
